@@ -0,0 +1,393 @@
+//! P09.46 (1.02 #2): built-in attribute macro for `#[swift_value = "Module.Type"]`.
+//!
+//! Retires the `swift_value!` proc macro from `crates/rustcc_macros`
+//! by promoting the same expansion into `rustc_builtin_macros`.
+//! Users now just write:
+//!
+//! ```ignore
+//! #[swift_value = "Foo.Bar"]
+//! pub struct Bar { _ptr: *mut core::ffi::c_void }
+//! ```
+//!
+//! and the compiler synthesizes:
+//! - `#[repr(swift)]` on the struct (if not already present)
+//! - `#[swift_type = "Foo.Bar"]` (for Swift-mangling downstream passes)
+//! - `extern "C"` metadata-accessor decl with Swift-mangled link_name
+//! - `impl Drop` forwarding to `rustcc_swift_rt::drop_swift_value` or
+//!   `release_swift_class`
+//! - `impl Clone` forwarding to `rustcc_swift_rt::clone_swift_value`
+//!   (value types) or a struct-literal with per-field `Clone::clone`
+//!   (class-backed types — keeps the P09.42 non-POD extras semantics)
+//!
+//! `"Foo.Bar"` is a value type; `"Foo.Bar:class"` is a reference type.
+//! ASCII module and type names only (matches the proc macro's scope).
+
+use rustc_ast::{self as ast, Item, ItemKind};
+use rustc_expand::base::{Annotatable, ExtCtxt};
+use rustc_parse::lexer::StripTokens;
+use rustc_parse::new_parser_from_source_str;
+use rustc_span::{FileName, Span, sym};
+
+use crate::util::check_builtin_macro_attribute;
+
+pub(crate) fn expand(
+    ecx: &mut ExtCtxt<'_>,
+    span: Span,
+    meta_item: &ast::MetaItem,
+    item: Annotatable,
+) -> Vec<Annotatable> {
+    check_builtin_macro_attribute(ecx, meta_item, sym::swift_value);
+
+    let Annotatable::Item(orig_struct) = &item else {
+        ecx.dcx().span_err(
+            item.span(),
+            "`#[swift_value]` may only be applied to a struct item",
+        );
+        return vec![item];
+    };
+
+    // Find the sibling `#[swift_type = "Module.Type"]` attribute
+    // — required for Swift mangling and as the source of truth
+    // for the binding's module/type/kind.
+    let swift_type_attr = orig_struct
+        .attrs
+        .iter()
+        .find(|a| a.has_name(sym::swift_type));
+    let Some(swift_type_attr) = swift_type_attr else {
+        ecx.dcx().span_err(
+            span,
+            "`#[swift_value]` requires a sibling \
+             `#[swift_type = \"Module.Type\"]` attribute (add \
+             `:class` suffix for reference types)",
+        );
+        return vec![item];
+    };
+    let Some(binding_symbol) = swift_type_attr.value_str() else {
+        ecx.dcx().span_err(
+            swift_type_attr.span,
+            "`#[swift_type]` must be a name-value string: \
+             `#[swift_type = \"Module.Type\"]`",
+        );
+        return vec![item];
+    };
+    let binding_str = binding_symbol.as_str();
+    let Some(binding) = SwiftBinding::parse(binding_str) else {
+        ecx.dcx().span_err(
+            swift_type_attr.span,
+            format!(
+                "`#[swift_type = {:?}]` is not in the expected \
+                 `\"Module.Type\"` or `\"Module.Type:class\"` format",
+                binding_str
+            ),
+        );
+        return vec![item];
+    };
+    let orig_struct = orig_struct.clone();
+    let ItemKind::Struct(ident, _generics, variant_data) = &orig_struct.kind else {
+        ecx.dcx().span_err(
+            orig_struct.span,
+            "`#[swift_value]` may only be applied to a struct item",
+        );
+        return vec![Annotatable::Item(orig_struct)];
+    };
+    let struct_name = *ident;
+
+    // Collect field info for the Clone-body generation. We only need
+    // this for the class-backed path; value types copy via the Swift
+    // VWT and don't care about Rust-side field shape.
+    let fields: Vec<(String, bool)> = match variant_data {
+        ast::VariantData::Struct { fields, .. } => fields
+            .iter()
+            .enumerate()
+            .map(|(idx, f)| match &f.ident {
+                Some(id) => (id.name.as_str().to_string(), true),
+                None => (format!("{idx}"), false),
+            })
+            .collect(),
+        ast::VariantData::Tuple(fields, _) => fields
+            .iter()
+            .enumerate()
+            .map(|(idx, _)| (format!("{idx}"), false))
+            .collect(),
+        ast::VariantData::Unit(_) => Vec::new(),
+    };
+
+    if binding.is_class && fields.is_empty() {
+        ecx.dcx().span_err(
+            orig_struct.span,
+            "class-backed `#[swift_value]` requires at least one field \
+             (the Swift class pointer at offset 0)",
+        );
+        return vec![Annotatable::Item(orig_struct)];
+    }
+
+    // Build an augmented struct: the original item with
+    // `#[repr(swift)]` added if not already present. The
+    // `#[swift_type]` attribute is already on the user's item.
+    let struct_attrs = augment_struct_attrs(ecx, &orig_struct.attrs, span);
+    let mut augmented_struct = (*orig_struct).clone();
+    augmented_struct.attrs = struct_attrs;
+    let augmented_item = Annotatable::Item(Box::new(augmented_struct));
+
+    // Render the metadata extern + Drop/Clone impls as a single source
+    // string, parse it into items, and return them alongside the
+    // augmented struct. Saves ~200 LOC of hand-built AST construction.
+    let source = render_expansion(&binding, &struct_name.name.as_str(), &fields);
+    let parsed_items = parse_items_from_string(ecx, span, source);
+
+    let mut out = Vec::with_capacity(1 + parsed_items.len());
+    out.push(augmented_item);
+    out.extend(parsed_items.into_iter().map(Annotatable::Item));
+    out
+}
+
+struct SwiftBinding<'a> {
+    module: &'a str,
+    name: &'a str,
+    is_class: bool,
+}
+
+impl<'a> SwiftBinding<'a> {
+    fn parse(s: &'a str) -> Option<Self> {
+        // Split off optional `:class` / `:struct` kind suffix.
+        let (body, is_class) = match s.rsplit_once(':') {
+            Some((b, "class")) => (b, true),
+            Some((b, "struct")) => (b, false),
+            _ => (s, false),
+        };
+        let (module, name) = body.rsplit_once('.')?;
+        if module.is_empty() || name.is_empty() {
+            return None;
+        }
+        if !is_ascii_ident(module) || !is_ascii_ident(name) {
+            return None;
+        }
+        Some(SwiftBinding { module, name, is_class })
+    }
+
+    /// Itanium-style Swift mangling for the metadata accessor:
+    ///   `$s<modlen><module><typelen><type>VMa` (value type)
+    ///   `$s<modlen><module><typelen><type>CMa` (class)
+    fn metadata_accessor_symbol(&self) -> String {
+        let tag = if self.is_class { 'C' } else { 'V' };
+        format!(
+            "$s{}{}{}{}{}Ma",
+            self.module.len(),
+            self.module,
+            self.name.len(),
+            self.name,
+            tag
+        )
+    }
+}
+
+fn is_ascii_ident(s: &str) -> bool {
+    let mut chars = s.chars();
+    match chars.next() {
+        Some(c) if c.is_ascii_alphabetic() || c == '_' => {}
+        _ => return false,
+    }
+    chars.all(|c| c.is_ascii_alphanumeric() || c == '_')
+}
+
+/// Ensure `#[repr(swift)]` and `#[swift_type = "..."]` are on the
+/// struct's attribute list; add them if missing. Preserves the user's
+/// original attribute order for anything we don't touch.
+fn augment_struct_attrs(
+    ecx: &ExtCtxt<'_>,
+    orig: &ast::AttrVec,
+    span: Span,
+) -> ast::AttrVec {
+    let has_repr_swift = orig.iter().any(|a| {
+        if !a.has_name(sym::repr) {
+            return false;
+        }
+        let Some(list) = a.meta_item_list() else { return false };
+        list.iter().any(|nested| nested.has_name(sym::swift))
+    });
+
+    let attr_gen = &ecx.sess.psess.attr_id_generator;
+    let mut out = orig.clone();
+    if !has_repr_swift {
+        out.push(rustc_ast::attr::mk_attr_nested_word(
+            attr_gen,
+            ast::AttrStyle::Outer,
+            ast::Safety::Default,
+            sym::repr,
+            sym::swift,
+            span,
+        ));
+    }
+    out
+}
+
+/// Render the expanded code (metadata extern + Drop impl + Clone
+/// impl) as a single Rust source string. The struct is emitted
+/// separately — see `expand()` — because we need to preserve the
+/// original item's tokens and attribute ordering as much as possible.
+fn render_expansion(binding: &SwiftBinding<'_>, struct_name: &str, fields: &[(String, bool)]) -> String {
+    let link_name = binding.metadata_accessor_symbol();
+    let metadata_ident = format!("__{struct_name}__metadata");
+
+    let metadata_extern = if binding.is_class {
+        // Classes use swift_retain / swift_release from the C
+        // runtime directly — no per-type metadata accessor needed.
+        String::new()
+    } else {
+        format!(
+            "unsafe extern \"C\" {{\n    \
+                 #[link_name = \"{link_name}\"]\n    \
+                 fn {metadata_ident}(flags: usize) \
+                     -> ::rustcc_swift_rt::MetadataResponse;\n\
+             }}\n"
+        )
+    };
+
+    let drop_body = if binding.is_class {
+        // Null-safe release of the class pointer at offset 0.
+        "        let ptr: *mut ::core::ffi::c_void =\n            \
+             unsafe { *(self as *const Self as *const *mut ::core::ffi::c_void) };\n        \
+             if !ptr.is_null() {\n            \
+                 unsafe { ::rustcc_swift_rt::release_swift_class(ptr); }\n        \
+             }"
+        .to_string()
+    } else {
+        format!(
+            "        unsafe {{\n            \
+                 ::rustcc_swift_rt::drop_swift_value(\n                \
+                     self as *mut Self,\n                \
+                     {metadata_ident},\n            \
+                 );\n        \
+             }}"
+        )
+    };
+
+    let clone_body = if binding.is_class {
+        // Class: retain ptr at offset 0, Clone each extra field
+        // (keeps the P09.42 non-POD extras semantics).
+        render_class_clone_body(fields)
+    } else {
+        format!(
+            "        let mut copy: ::core::mem::MaybeUninit<Self> =\n            \
+                 ::core::mem::MaybeUninit::uninit();\n        \
+             unsafe {{\n            \
+                 ::rustcc_swift_rt::clone_swift_value(\n                \
+                     copy.as_mut_ptr(),\n                \
+                     self as *const Self,\n                \
+                     {metadata_ident},\n            \
+                 );\n            \
+                 copy.assume_init()\n        \
+             }}"
+        )
+    };
+
+    format!(
+        "{metadata_extern}\
+         impl ::core::ops::Drop for {struct_name} {{\n    \
+             fn drop(&mut self) {{\n{drop_body}\n    }}\n\
+         }}\n\
+         impl ::core::clone::Clone for {struct_name} {{\n    \
+             fn clone(&self) -> Self {{\n{clone_body}\n    }}\n\
+         }}\n"
+    )
+}
+
+/// Class-backed Clone body. First field (convention: Swift class
+/// pointer at offset 0) is overwritten with the retained pointer;
+/// every other field uses its own Clone impl so non-POD extras
+/// (`Box`, `String`, `Vec`) don't alias heap owned by the original.
+/// Named structs and tuple structs both supported.
+fn render_class_clone_body(fields: &[(String, bool)]) -> String {
+    let (first_name, first_named) = &fields[0];
+    let preamble = "        let ptr: *mut ::core::ffi::c_void =\n            \
+         unsafe { *(self as *const Self as *const *mut ::core::ffi::c_void) };\n        \
+         let retained = if ptr.is_null() {\n            \
+             ptr\n        \
+         } else {\n            \
+             unsafe { ::rustcc_swift_rt::retain_swift_class(ptr) }\n        \
+         };\n        \
+         let retained_handle = unsafe {\n            \
+             ::core::mem::transmute_copy::<\n                \
+                 *mut ::core::ffi::c_void,\n                \
+                 _,\n            \
+             >(&retained)\n        \
+         };";
+
+    if *first_named {
+        let mut literal = format!("Self {{\n            {first_name}: retained_handle,\n");
+        for (name, _) in fields.iter().skip(1) {
+            literal.push_str(&format!(
+                "            {name}: ::core::clone::Clone::clone(&self.{name}),\n"
+            ));
+        }
+        literal.push_str("        }");
+        format!("{preamble}\n        {literal}")
+    } else {
+        let mut literal = String::from("Self(retained_handle");
+        for (idx, _) in fields.iter().enumerate().skip(1) {
+            literal.push_str(&format!(
+                ", ::core::clone::Clone::clone(&self.{idx})"
+            ));
+        }
+        literal.push(')');
+        format!("{preamble}\n        {literal}")
+    }
+}
+
+/// Parse a source string containing Rust items (no crate-level
+/// attrs, no leading doc-comments) and return the resulting item
+/// list. Errors are emitted to the ExtCtxt's dcx and the offending
+/// items dropped.
+fn parse_items_from_string(
+    ecx: &mut ExtCtxt<'_>,
+    span: Span,
+    source: String,
+) -> Vec<Box<Item>> {
+    let src_clone = source.clone();
+    let parser_res = new_parser_from_source_str(
+        &ecx.sess.psess,
+        FileName::anon_source_code(&src_clone),
+        source,
+        StripTokens::Nothing,
+    );
+    let mut parser = match parser_res {
+        Ok(p) => p,
+        Err(errs) => {
+            for e in errs {
+                e.emit();
+            }
+            return Vec::new();
+        }
+    };
+
+    let mut items = Vec::new();
+    while parser.token != rustc_ast::token::TokenKind::Eof {
+        match parser.parse_item(
+            rustc_parse::parser::ForceCollect::No,
+            rustc_parse::parser::AllowConstBlockItems::No,
+        ) {
+            Ok(Some(item)) => {
+                let mut item = *item;
+                rebrand_item_span(&mut item, span);
+                items.push(Box::new(item));
+            }
+            Ok(None) => break,
+            Err(err) => {
+                err.emit();
+                break;
+            }
+        }
+    }
+    items
+}
+
+/// Recursively rebrand spans on an item + its children. We do the
+/// minimum necessary: span, attrs span, and ident span. Deeper
+/// descendants (field spans, method bodies) are left as-is since
+/// they point at synthetic source that the source map understands.
+fn rebrand_item_span(item: &mut Item, span: Span) {
+    item.span = span;
+    for attr in item.attrs.iter_mut() {
+        attr.span = span;
+    }
+}
