diff --git a/compiler/rustc_attr_parsing/src/attributes/codegen_attrs.rs b/compiler/rustc_attr_parsing/src/attributes/codegen_attrs.rs
index 5cac20b885c..468e9a547f4 100644
--- a/compiler/rustc_attr_parsing/src/attributes/codegen_attrs.rs
+++ b/compiler/rustc_attr_parsing/src/attributes/codegen_attrs.rs
@@ -793,6 +793,26 @@ impl<S: Stage> NoArgsAttributeParser<S> for $parser {
     [Target::ForeignFn]
 );
 
+// `#[rustc_cxx_throws]` (P09.60 / 1.12 throws Phase 1) — marks a
+// foreign fn inside an `extern "C++"` block as a C++ throwing
+// function. Codegen lowers the call site from `call` to LLVM's
+// `invoke` instruction with an Itanium catch landingpad (or a
+// `catchpad`/`catchswitch` funclet on MSVC), wrapping the return
+// type in `Result<T, ::cxx::CxxException>`. See
+// `fork/CXX-THROW-PLAN.md` for the full Phase 1/2/3 design.
+//
+// This patch (P09.60) only registers the attribute; the codegen
+// lowering ships in P09.61 (Itanium invoke) + P09.62 (MSVC
+// funclet). The attribute is accepted but a no-op at codegen
+// today, so the boundary is safe to mark on user-side code
+// before the codegen patches land.
+rustcc_noargs_attr!(
+    RustcCxxThrowsParser,
+    rustc_cxx_throws,
+    RustcCxxThrows,
+    [Target::ForeignFn]
+);
+
 /// P09.20: `#[rustc_cxx_operator = "Plus"]` — marks a method on
 /// a `#[repr(cpp)]` impl as a C++ operator overload. The string
 /// value names the operator kind (matches the variants of
diff --git a/compiler/rustc_attr_parsing/src/context.rs b/compiler/rustc_attr_parsing/src/context.rs
index 0fc677e28c1..3fe50346d24 100644
--- a/compiler/rustc_attr_parsing/src/context.rs
+++ b/compiler/rustc_attr_parsing/src/context.rs
@@ -335,6 +335,7 @@ mod late {
         Single<RustcSwiftTypeParser>,
         Single<RustcSwiftLabelsParser>,
         Single<WithoutArgs<RustcSwiftThrowsParser>>,
+        Single<WithoutArgs<RustcCxxThrowsParser>>,
         Single<WithoutArgs<RustcPreserveUbChecksParser>>,
         Single<WithoutArgs<RustcProcMacroDeclsParser>>,
         Single<WithoutArgs<RustcPubTransparentParser>>,
diff --git a/compiler/rustc_codegen_ssa/src/codegen_attrs.rs b/compiler/rustc_codegen_ssa/src/codegen_attrs.rs
index 6d012e04fe8..75701f343f0 100644
--- a/compiler/rustc_codegen_ssa/src/codegen_attrs.rs
+++ b/compiler/rustc_codegen_ssa/src/codegen_attrs.rs
@@ -189,6 +189,9 @@ fn process_builtin_attrs(
             AttributeKind::RustcSwiftThrows(_) => {
                 codegen_fn_attrs.flags |= CodegenFnAttrFlags::SWIFT_ERROR_LAST_ARG
             }
+            AttributeKind::RustcCxxThrows(_) => {
+                codegen_fn_attrs.flags |= CodegenFnAttrFlags::CXX_THROWS
+            }
             AttributeKind::RustcStdInternalSymbol(_) => {
                 codegen_fn_attrs.flags |= CodegenFnAttrFlags::RUSTC_STD_INTERNAL_SYMBOL
             }
diff --git a/compiler/rustc_feature/src/builtin_attrs.rs b/compiler/rustc_feature/src/builtin_attrs.rs
index 3936303831d..5e6a1e9a31b 100644
--- a/compiler/rustc_feature/src/builtin_attrs.rs
+++ b/compiler/rustc_feature/src/builtin_attrs.rs
@@ -365,6 +365,14 @@ pub struct BuiltinAttribute {
     // Swift-ABI error register.
     rustc_attr!(rustc_swift_throws, "marks an `extern \"Swift\"` foreign fn as a Swift throwing function; the last param carries LLVM's `swifterror` attribute"),
 
+    // P09.60 / 1.12 throws Phase 1 — `#[rustc_cxx_throws]` marks a
+    // foreign fn inside an `extern \"C++\"` block as a throwing C++
+    // function. Codegen lowers the call site from `call` to `invoke`
+    // with a catch landingpad; the visible Rust signature wraps the
+    // return in `Result<T, ::cxx::CxxException>`. Codegen lowering
+    // ships in P09.61 (Itanium) + P09.62 (MSVC funclet).
+    rustc_attr!(rustc_cxx_throws, "marks an `extern \"C++\"` foreign fn as a C++ throwing function; call sites lower to LLVM `invoke` with a catch landingpad and the return type becomes `Result<T, ::cxx::CxxException>`"),
+
     // Limits:
     ungated!(recursion_limit),
     ungated!(type_length_limit),
diff --git a/compiler/rustc_hir/src/attrs/data_structures.rs b/compiler/rustc_hir/src/attrs/data_structures.rs
index 1b3cacb6f56..eed8b661056 100644
--- a/compiler/rustc_hir/src/attrs/data_structures.rs
+++ b/compiler/rustc_hir/src/attrs/data_structures.rs
@@ -1598,6 +1598,20 @@ pub enum AttributeKind {
     /// the call to detect thrown errors.
     RustcSwiftThrows(Span),
 
+    /// Represents `#[rustc_cxx_throws]` (P09.60 / 1.12 throws
+    /// Phase 1) — marks a foreign fn inside `extern "C++"` block
+    /// as a C++ throwing function. Codegen lowers each call site
+    /// from `call` to LLVM's `invoke` instruction with an Itanium
+    /// catch landingpad (or MSVC `catchpad`/`catchswitch` funclet
+    /// on Windows MSVC targets); the visible Rust signature wraps
+    /// the return type in `Result<T, ::cxx::CxxException>`.
+    ///
+    /// Codegen lowering is gated on P09.61 (Itanium) and P09.62
+    /// (MSVC funclet); P09.60 only registers the attribute so
+    /// user-side code can mark callees before the codegen
+    /// patches land.
+    RustcCxxThrows(Span),
+
     /// Represents `#[rustc_swift_symbol = "ModuleName"]` — names
     /// the Swift module hosting an `extern "Swift"` function so
     /// the Swift mangler can produce `$s<module><name>...F`.
diff --git a/compiler/rustc_hir/src/attrs/encode_cross_crate.rs b/compiler/rustc_hir/src/attrs/encode_cross_crate.rs
index 9404d027a9b..195fc9619dd 100644
--- a/compiler/rustc_hir/src/attrs/encode_cross_crate.rs
+++ b/compiler/rustc_hir/src/attrs/encode_cross_crate.rs
@@ -190,6 +190,7 @@ pub fn encode_cross_crate(&self) -> EncodeCrossCrate {
             RustcSwiftType { .. } => Yes,
             RustcSwiftLabels { .. } => Yes,
             RustcSwiftThrows(..) => Yes,
+            RustcCxxThrows(..) => Yes,
             RustcPreserveUbChecks => No,
             RustcProcMacroDecls => No,
             RustcPubTransparent(..) => Yes,
diff --git a/compiler/rustc_middle/src/middle/codegen_fn_attrs.rs b/compiler/rustc_middle/src/middle/codegen_fn_attrs.rs
index 0ba984ee8e7..a6cb7588d91 100644
--- a/compiler/rustc_middle/src/middle/codegen_fn_attrs.rs
+++ b/compiler/rustc_middle/src/middle/codegen_fn_attrs.rs
@@ -219,6 +219,16 @@ impl CodegenFnAttrFlags: u32 {
         /// be a `*mut *mut SomeError`; layout validation is the user's
         /// responsibility for now.
         const SWIFT_ERROR_LAST_ARG      = 1 << 19;
+        /// Lower the call site from `call` to LLVM `invoke` with a
+        /// catch landingpad (Itanium) / funclet (MSVC). Catches the
+        /// C++ exception and returns `Result::Err(CxxException)`
+        /// instead of unwinding through the Rust frame. Applied via
+        /// `#[rustc_cxx_throws]`. Codegen lowering ships in P09.61
+        /// (Itanium) and P09.62 (MSVC funclet); this flag exists in
+        /// P09.60 so the attribute round-trips through the HIR +
+        /// codegen_fn_attrs layer cleanly before the codegen
+        /// patches land.
+        const CXX_THROWS                = 1 << 20;
     }
 }
 rustc_data_structures::external_bitflags_debug! { CodegenFnAttrFlags }
diff --git a/compiler/rustc_passes/src/check_attr.rs b/compiler/rustc_passes/src/check_attr.rs
index 8e8ea368b69..a7f236d963f 100644
