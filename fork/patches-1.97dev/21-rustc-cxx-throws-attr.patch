@@ -370,6 +370,7 @@ fn check_attributes(
                     | AttributeKind::RustcSwiftType { .. }
                     | AttributeKind::RustcSwiftLabels { .. }
                     | AttributeKind::RustcSwiftThrows(..)
+                    | AttributeKind::RustcCxxThrows(..)
                     | AttributeKind::RustcPreserveUbChecks
                     | AttributeKind::RustcProcMacroDecls
                     | AttributeKind::RustcReallocator
