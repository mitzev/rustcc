 compiler/rustc_attr_parsing/src/context.rs    |  1 +
 .../rustc_codegen_ssa/src/codegen_attrs.rs    |  3 +++
 compiler/rustc_feature/src/builtin_attrs.rs   |  8 ++++++++
 .../rustc_hir/src/attrs/data_structures.rs    | 14 +++++++++++++
 .../rustc_hir/src/attrs/encode_cross_crate.rs |  1 +
