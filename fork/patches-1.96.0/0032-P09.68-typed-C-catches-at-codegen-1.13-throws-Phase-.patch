+        let num_clauses = typeinfos.len() + 1;
+        let landing_pad = self.landing_pad(ty, pers_fn, num_clauses);
+        for &ti in typeinfos {
+            self.add_clause(landing_pad, ti);
+        }
         let null_ty_info = self.const_null(self.type_ptr());
         self.add_clause(landing_pad, null_ty_info);
-        (self.extract_value(landing_pad, 0), self.extract_value(landing_pad, 1))
+
+        let exn_ptr = self.extract_value(landing_pad, 0);
+        let raw_selector = self.extract_value(landing_pad, 1);
+
+        // Phase 1: no typed clauses, no translation needed.
+        if typeinfos.is_empty() {
+            return (exn_ptr, raw_selector);
+        }
+
+        // Translate raw_selector → small 1-based index.
+        // Start with 0 (catch-all) and overlay typed matches
+        // via a chain of `select`s.
+        let i32_ty = self.type_i32();
+        let mut small_idx = self.const_uint(i32_ty, 0);
+        for (i, &ti) in typeinfos.iter().enumerate() {
