+    fn cxx_throws_catch_typed_fn(&self) -> (&'ll Value, &'ll Type) {
+        // P09.68 / 1.13 throws Phase 2B: declare (or look up) the
+        // `__rustcc_cxx_catch_typed` runtime helper. Same as
+        // `cxx_throws_catch_fn` but takes an extra `u32`
+        // selector argument so the runtime can pack the matched
+        // typeinfo index into the returned `CxxRawError.kind`.
+        //
+        // LLVM signature: `fn(ptr, u32) -> { i32, ptr }`.
+        let cxx_raw_error_ty = self.type_struct(
+            &[self.type_i32(), self.type_ptr()],
+            /* packed: */ false,
+        );
+        let fty = self.type_func(
+            &[self.type_ptr(), self.type_i32()],
+            cxx_raw_error_ty,
+        );
+        let name = "__rustcc_cxx_catch_typed";
+        let llfn = if let Some(llfn) = self.get_declared_value(name) {
+            llfn
+        } else {
+            let llfn = self.declare_cfn(name, llvm::UnnamedAddr::Global, fty);
+            let target_cpu = attributes::target_cpu_attr(self, self.sess());
+            attributes::apply_to_llfn(llfn, llvm::AttributePlace::Function, &[target_cpu]);
+            llfn
+        };
+        (llfn, fty)
+    }
+
+    fn cxx_typeinfo_personality(&self) -> &'ll Value {
+        // P09.68 / 1.13 throws Phase 2B: declare (or look up)
+        // `__gxx_personality_v0` — the standard Itanium C++
+        // personality function. Required for typed-catch
+        // landingpads because the Rust personality
+        // (`rust_eh_personality`) doesn't perform typeinfo
+        // matching against arbitrary C++ thrown types.
+        //
+        // The personality has signature
+        // `i32(i32, i32, u64, ptr, ptr)` but LLVM allows
+        // declaring it with a variadic stub since the
+        // personality call is opaque to user code.
+        let name = "__gxx_personality_v0";
+        if let Some(existing) = self.get_declared_value(name) {
+            return existing;
+        }
+        // Match the shape used for the rust personality:
+        // variadic-args returning i32.
+        let fty = self.type_variadic_func(&[], self.type_i32());
+        self.declare_cfn(name, llvm::UnnamedAddr::Global, fty)
+    }
+
+    fn cxx_typeinfo_global(&self, name: &str) -> &'ll Value {
+        // P09.68 / 1.13 throws Phase 2B: declare a Itanium
+        // typeinfo extern global. The C++ side defines these
+        // (linker resolves them to the typeinfo objects in
+        // libstdc++/libc++/etc.). We declare them as
+        // opaque-pointer globals (the typeinfo object is an
+        // opaque struct from Rust's perspective; only its
+        // address matters to the personality fn).
+        if let Some(existing) = self.get_declared_value(name) {
+            return existing;
+        }
+        // Use type_ptr() for the global's type — opaque pointers
+        // make the concrete element type irrelevant. The
+        // landingpad treats this as a `ptr` value, no
+        // dereferencing happens on the Rust side.
+        self.declare_global(name, self.type_ptr())
+    }
