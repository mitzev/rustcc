+/// P09.68 / 1.13 throws Phase 2B:
+/// `#[rustc_cxx_throws_typeinfos = "_ZTISt13runtime_error,_ZTI8MyError"]`
+/// — comma-separated list of Itanium typeinfo symbol names
+/// for typed catches. Codegen emits one `catch ptr @<symbol>`
+/// clause in the landingpad per entry, plus a final
+/// `catch ptr null` catch-all. The landingpad selector value
+/// becomes the matched clause's 1-based index (or 0 if the
+/// catch-all matched), packed into `CxxRawError.kind`.
+pub(crate) struct RustcCxxThrowsTypeinfosParser;
+
+impl<S: Stage> SingleAttributeParser<S> for RustcCxxThrowsTypeinfosParser {
+    const PATH: &[Symbol] = &[sym::rustc_cxx_throws_typeinfos];
+    const ON_DUPLICATE: OnDuplicate<S> = OnDuplicate::Error;
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::ForeignFn)]);
+    const TEMPLATE: AttributeTemplate =
+        template!(NameValueStr: "_ZTIxxx,_ZTIyyy");
+
+    fn convert(cx: &mut AcceptContext<'_, '_, S>, args: &ArgParser) -> Option<AttributeKind> {
+        let Some(nv) = args.name_value() else {
+            let attr_span = cx.attr_span;
+            cx.adcx().expected_name_value(attr_span, None);
+            return None;
+        };
+        let Some(typeinfos) = nv.value_as_str() else {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
+        };
+        Some(AttributeKind::RustcCxxThrowsTypeinfos {
+            typeinfos,
+            span: cx.attr_span,
+        })
+    }
+}
