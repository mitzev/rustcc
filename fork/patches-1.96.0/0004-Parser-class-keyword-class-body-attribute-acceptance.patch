 .../rustc_ast_passes/src/ast_validation.rs    |   2 +
 compiler/rustc_parse/src/parser/item.rs       | 294 ++++++++++++++++++
 compiler/rustc_parse/src/parser/mod.rs        |   9 +-
 4 files changed, 306 insertions(+), 1 deletion(-)

