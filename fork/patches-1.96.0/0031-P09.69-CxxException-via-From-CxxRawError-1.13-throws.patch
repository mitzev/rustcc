+/// Resolve the `<E as From<CxxRawError>>::from` associated
+/// function as a monomorphized `Instance`. Returns `None` if
+/// no such impl exists in scope, or if the resolution can't
+/// be completed (the caller handles either case by emitting
+/// a delayed compile error and falling back).
+fn resolve_from_cxx_raw_error_impl<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    typing_env: ty::TypingEnv<'tcx>,
+    err_ty: Ty<'tcx>,
+    raw_err_ty: Ty<'tcx>,
+) -> Option<ty::Instance<'tcx>> {
+    // Build the trait ref `E: From<CxxRawError>`.
+    let from_trait_did = tcx.lang_items().get(LangItem::From)?;
+    let trait_ref = ty::TraitRef::new(tcx, from_trait_did, [err_ty, raw_err_ty]);
+
+    // Select the impl.
+    let impl_source = tcx
+        .codegen_select_candidate(typing_env.as_query_input(trait_ref))
+        .ok()?;
+    let traits::ImplSource::UserDefined(traits::ImplSourceUserDefinedData {
+        impl_def_id,
+        args,
+        ..
+    }) = impl_source
+    else {
+        // Builtin / blanket impls — the only relevant blanket
+        // is `impl<T> From<T> for T` (the reflexive impl),
+        // which only triggers when err_ty == raw_err_ty. The
+        // caller already filtered that case before calling
+        // here, so anything other than UserDefined means
+        // resolution didn't find an applicable user impl.
+        debug!("resolve_from_cxx_raw_error_impl: non-user impl: {:?}", impl_source);
+        return None;
+    };
+
+    // Find the `from` associated function on the impl.
+    let from_method_did = tcx
+        .associated_items(*impl_def_id)
+        .find_by_ident_and_kind(
+            tcx,
+            rustc_span::Ident::with_dummy_span(sym::from),
+            ty::AssocTag::Fn,
+            *impl_def_id,
+        )?
+        .def_id;
+
+    // Build the monomorphized instance.
+    let instance = ty::Instance::try_resolve(
+        tcx,
+        typing_env,
+        from_method_did,
+        args,
+    )
+    .ok()??;
+    Some(instance)
+}
