+    /// Force the arg into `Indirect` mode regardless of current
+    /// state. Used by P09's Itanium overlay after the C-path
+    /// `compute_abi_info` has already transitioned some args to
+    /// `Cast` — the regular `make_indirect` asserts `Direct|Pair`
+    /// and would panic. This bypass is safe because we're
+    /// deliberately overriding the C classification for types
+    /// the Itanium ABI treats differently.
+    pub(crate) fn force_indirect(&mut self) {
+        self.mode = Self::indirect_pass_mode(&self.layout);
+    }
+
+    /// P09.17: override the C-path's aggregate-packing for
+    /// Swift-ABI arg/ret. Swift's calling convention spreads a
+    /// small POD struct across its constituent registers rather
+    /// than packing into a single int/float wide enough to hold
+    /// all fields. When the layout is `ScalarPair` (two-scalar
+    /// aggregate — the common case for Swift POD structs), force
+    /// `PassMode::Pair` so LLVM + swiftcc lower each scalar
+    /// separately, matching what `swiftc` emits for its own
+    /// value-type args.
+    pub(crate) fn force_swift_pair(&mut self) {
+        if let BackendRepr::ScalarPair(a, b) = self.layout.backend_repr {
+            // Rebuild the same attrs `ArgAbi::new` would have
+            // produced originally — the C-path then overwrote
+            // them with a Cast. Default attributes are fine for
+            // POD scalars (no NoAlias / NonNull / etc.).
+            self.mode = PassMode::Pair(ArgAttributes::new(), ArgAttributes::new());
+            let _ = (a, b);
+        }
+    }
