+/// P09 — Itanium C++ ABI overlay for i686 (32-bit x86).
+///
+/// Runs the stock x86 C-path classification first, then promotes
+/// any `is_cxx_non_trivial_for_calls` arg or return to indirect
+/// to match Clang's Itanium output. Same shape as the x86_64 and
+/// aarch64 overlays.
+pub(crate) fn compute_cxx_abi_info<'a, Ty, C>(cx: &C, fn_abi: &mut FnAbi<'a, Ty>, opts: X86Options)
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+    C: HasDataLayout + HasTargetSpec,
+{
+    compute_abi_info(cx, fn_abi, opts);
+
+    if !fn_abi.ret.is_ignore()
+        && fn_abi.ret.layout.is_cxx_non_trivial_for_calls(cx)
+    {
+        fn_abi.ret.force_indirect();
+    }
+    for arg in fn_abi.args.iter_mut() {
+        if arg.is_ignore() {
+            continue;
+        }
+        if arg.layout.is_cxx_non_trivial_for_calls(cx) {
+            arg.force_indirect();
+        }
+    }
+}
