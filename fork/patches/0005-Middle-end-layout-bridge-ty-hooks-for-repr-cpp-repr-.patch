+/// True when `def_id` is an associated fn on an `impl` whose
+/// self-type is a `#[repr(cpp)]` ADT. Such methods get the
+/// Itanium C++ calling convention inferred from the impl target,
+/// without the user having to write `extern "C++"` on every
+/// method. Mirrors [`rustc_symbol_mangling::itanium::cxx_impl_class`];
+/// split rather than shared because the two callers live in
+/// different crates with no current dependency edge.
+fn is_cxx_inferred_method<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> bool {
+    if tcx.def_kind(def_id) != DefKind::AssocFn {
+        return false;
+    }
+    let Some(impl_did) = tcx.opt_parent(def_id) else { return false };
+    if !matches!(tcx.def_kind(impl_did), DefKind::Impl { .. }) {
+        return false;
+    }
+    let ty::Adt(adt_def, _) = tcx.type_of(impl_did).skip_binder().kind() else {
+        return false;
+    };
+    adt_def.repr().cpp()
+}
