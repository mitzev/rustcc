+
+    /// True when this type is "non-trivial for C++ calls" per
+    /// the Itanium ABI. Itanium passes such types by invisible
+    /// reference regardless of size. P09 uses this to force
+    /// `PassMode::Indirect` in `ExternAbi::Cpp` fn signatures.
+    ///
+    /// Triggers (both for `#[repr(cpp)]` ADTs):
+    /// - a user-declared `Drop` impl, or
+    /// - `!Copy`. A C++ class with any hand-rolled copy/move ctor
+    ///   is non-trivial, and Rust's closest proxy is "doesn't
+    ///   implement `Copy`": a trivially-copyable Rust type is
+    ///   `Copy`-safe, and a `#[repr(cpp)]` backed by a non-trivial
+    ///   C++ class will not be `Copy` (copying it would be a
+    ///   memcpy, but the C++ side's copy ctor wants to run).
+    fn is_cxx_non_trivial_for_calls(this: TyAndLayout<'tcx>, cx: &C) -> bool {
+        match this.ty.kind() {
+            ty::Adt(def, _) => {
+                if !def.repr().cpp() {
+                    return false;
+                }
+                if def.destructor(cx.tcx()).is_some() {
+                    return true;
+                }
+                // `!Copy` → non-trivial. `type_is_copy_modulo_regions`
+                // checks the `Copy` bound in the current typing env.
+                !cx.tcx().type_is_copy_modulo_regions(cx.typing_env(), this.ty)
+            }
+            _ => false,
+        }
+    }
+
+    fn is_swift_repr(this: TyAndLayout<'tcx>) -> bool {
+        match this.ty.kind() {
+            ty::Adt(def, _) => def.repr().swift(),
+            _ => false,
+        }
+    }
 }
 
