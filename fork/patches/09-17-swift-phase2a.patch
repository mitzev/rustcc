+impl<S: Stage> SingleAttributeParser<S> for RustcSwiftTypeParser {
+    const PATH: &[Symbol] = &[sym::rustc_swift_type];
+    const ON_DUPLICATE: OnDuplicate<S> = OnDuplicate::Error;
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::Struct)]);
+    const TEMPLATE: AttributeTemplate = template!(NameValueStr: "Module.TypeName");
+
+    fn convert(cx: &mut AcceptContext<'_, '_, S>, args: &ArgParser) -> Option<AttributeKind> {
+        let Some(nv) = args.name_value() else {
+            let attr_span = cx.attr_span;
+            cx.adcx().expected_name_value(attr_span, None);
+            return None;
+        };
+        let Some(s) = nv.value_as_str() else {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
+        };
+        // Split on the last `.` so module names can themselves
+        // contain dots (Swift submodules aren't a thing today
+        // but leave room). Require exactly one dot.
+        let raw = s.as_str();
+        let Some((module_str, name_str)) = raw.rsplit_once('.') else {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
+        };
+        if module_str.is_empty() || name_str.is_empty() {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
