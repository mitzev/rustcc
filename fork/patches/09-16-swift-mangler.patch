+++ b/compiler/rustc_symbol_mangling/src/swift.rs@@ -0,0 +1,215 @@
+//! P09.16 — Swift ABI symbol mangling for `extern "Swift"` items.
+//!
+//! Routes `extern "Swift"` fn declarations through a Swift mangler
+//! so link names match what `swiftc` produces for functions in a
+//! named Swift module. The module name comes from a
+//! `#[rustc_swift_symbol = "ModuleName"]` attribute on the
+//! foreign-item; the function name defaults to the Rust identifier.
+//!
+//! # Phase 1 scope
+//!
+//! Free functions only (no methods, no classes). All parameter
+//! labels are assumed unnamed (encoded as `y`). Supported types:
+//!
+//! | Rust      | Swift      | Code |
+//! |-----------|------------|------|
+//! | `i64`     | `Int`      | `Si` |
+//! | `u64`     | `UInt`     | `Su` |
+//! | `f64`     | `Double`   | `Sd` |
+//! | `f32`     | `Float`    | `Sf` |
+//! | `bool`    | `Bool`     | `Sb` |
+//! | `()` ret  | `Void`     | `y`  |
+//!
+//! # Grammar (from empirical `swiftc` output cross-referenced with
+//! Swift 6.2 and `swift-demangle`)
+//!
+//! ```text
+//! MangledSymbol := $s <Module> <Name> <Labels> <Sig> F
+//! Module        := <Len><Chars>
+//! Name          := <Len><Chars>
+//! Labels        := y                         // all-unnamed (Phase 1 default)
+//! Sig           := <RetType> <Params>
+//! RetType       := <Type>                    // includes `y` for Void
+//! Params        := y                         // ()
+//!                | <Type>                    // single param, no tuple
+//!                | <T1>_<T2>[...]t           // 2+ params, tuple
+//! Type          := Si | Su | Sd | Sf | Sb | y | ...
+//! ```
+//!
+//! Compression: 2+ consecutive identical single-letter Swift-stdlib
+//! types collapse to `S<N><c>` where `<c>` is the type letter. The
+//! compression crosses the RetType/Params boundary for adjacency
+//! (e.g. `(Int, Int) -> Int` emits `S2i_Sit`: return `Si` + first
+//! param `Si` compress to `S2i`, then separator, then second param
+//! `Si`, then tuple terminator). This exactly matches `swiftc`'s
+//! output — validated via `swift-demangle` round-trip.
+
+use rustc_abi::ExternAbi;
+use rustc_hir::def::DefKind;
+use rustc_middle::ty::{self, Instance, Ty, TyCtxt};
+use rustc_span::Symbol;
+use rustc_span::def_id::DefId;
+
+/// True when `def_id` is a foreign fn inside an `extern "Swift"`
+/// block that carries a `#[rustc_swift_symbol = "..."]` attribute.
+pub(crate) fn is_swift_abi<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> bool {
+    if !matches!(tcx.def_kind(def_id), DefKind::Fn | DefKind::AssocFn) {
+        return false;
+    }
+    let sig = tcx.fn_sig(def_id).skip_binder().skip_binder();
+    matches!(sig.abi(), ExternAbi::Swift { .. })
+        && swift_module_name(tcx, def_id).is_some()
+}
+
+/// Extract the Swift module name from the
+/// `#[rustc_swift_symbol = "..."]` attribute on `def_id`, if any.
+fn swift_module_name<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> Option<Symbol> {
+    rustc_hir::find_attr!(
+        tcx, def_id, RustcSwiftSymbol { module, .. } => *module
+    )
+}
+
+/// Mangle `instance` as a Swift symbol. Returns `None` if the
+/// signature uses a type the Phase 1 mangler can't encode — caller
+/// falls back to default mangling (which produces a link-time
+/// error, surfacing the problem).
+pub(crate) fn mangle<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    instance: Instance<'tcx>,
+) -> Option<String> {
+    let def_id = instance.def_id();
+    let module = swift_module_name(tcx, def_id)?;
+    let name = tcx.item_name(def_id);
+
+    let sig = tcx.fn_sig(def_id).skip_binder().skip_binder();
+
+    let ret_code = ty_to_swift(sig.output())?;
+    let param_codes: Vec<&'static str> = sig
+        .inputs()
+        .iter()
+        .map(|ty| ty_to_swift(*ty))
+        .collect::<Option<Vec<_>>>()?;
+
+    let mut body = String::new();
+    // return type
+    body.push_str(ret_code);
+    // params
+    match param_codes.len() {
+        0 => body.push('y'),
+        1 => body.push_str(param_codes[0]),
+        _ => {
+            for (i, code) in param_codes.iter().enumerate() {
+                if i > 0 {
+                    body.push('_');
+                }
+                body.push_str(code);
+            }
+            body.push('t');
+        }
+    }
+
+    // Compress runs of consecutive identical single-letter
+    // Swift-stdlib types. `Si` becomes `S2i` when a peer `Si`
+    // follows. Applied left-to-right, greedy.
+    let compressed = compress_consecutive(&body);
+
+    // Module + name, with length prefixes per Swift mangling.
+    let module_str = module.as_str();
+    let name_str = name.as_str();
+    Some(format!(
+        "$s{mlen}{m}{nlen}{n}y{sig}F",
+        mlen = module_str.len(),
+        m = module_str,
+        nlen = name_str.len(),
+        n = name_str,
+        sig = compressed,
+    ))
+}
+
+/// Map a rustc `Ty` to its Swift mangling letter. Returns `None`
+/// for any type outside Phase 1's scalar-only scope.
+fn ty_to_swift<'tcx>(ty: Ty<'tcx>) -> Option<&'static str> {
+    match ty.kind() {
+        ty::Tuple(tys) if tys.is_empty() => Some("y"),
+        ty::Bool => Some("Sb"),
+        ty::Int(int_ty) => match int_ty {
+            ty::IntTy::I64 => Some("Si"),
+            _ => None,
+        },
+        ty::Uint(uint_ty) => match uint_ty {
+            ty::UintTy::U64 => Some("Su"),
+            _ => None,
+        },
+        ty::Float(float_ty) => match float_ty {
+            ty::FloatTy::F32 => Some("Sf"),
+            ty::FloatTy::F64 => Some("Sd"),
+            _ => None,
+        },
+        _ => None,
+    }
+}
+
+/// Fold `<code><code>...` runs of consecutive identical
+/// two-char Swift-stdlib type codes into `S<N><c>` form.
+///
+/// Walks the string left-to-right. Treats any `S<c>` where `<c>` is
+/// a lowercase stdlib letter as compressible. The `_` and `t`
+/// separators are preserved verbatim and don't participate in
+/// compression (they bound a run).
+fn compress_consecutive(input: &str) -> String {
+    let bytes = input.as_bytes();
+    let mut out = String::with_capacity(input.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        // Look for `S<c>` at position i where <c> is a-z.
+        if i + 1 < bytes.len() && bytes[i] == b'S' && (bytes[i + 1] as char).is_ascii_lowercase() {
+            let letter = bytes[i + 1];
+            // Count consecutive `S<letter>` starting here.
+            let mut count = 1;
+            let mut j = i + 2;
+            while j + 1 < bytes.len() && bytes[j] == b'S' && bytes[j + 1] == letter {
+                count += 1;
+                j += 2;
+            }
+            if count >= 2 {
+                out.push('S');
+                out.push_str(&count.to_string());
+                out.push(letter as char);
+                i = j;
+                continue;
+            }
+        }
+        out.push(bytes[i] as char);
+        i += 1;
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::compress_consecutive;
+
+    #[test]
+    fn compresses_pairs() {
+        assert_eq!(compress_consecutive("SiSi"), "S2i");
+        assert_eq!(compress_consecutive("SdSd"), "S2d");
+        assert_eq!(compress_consecutive("SfSfSf"), "S3f");
+    }
+
+    #[test]
+    fn preserves_underscores_and_t() {
+        assert_eq!(compress_consecutive("SiSi_Sit"), "S2i_Sit");
+        assert_eq!(compress_consecutive("SiSi_SdSd"), "S2i_S2d");
+    }
+
+    #[test]
+    fn leaves_singletons_alone() {
+        assert_eq!(compress_consecutive("Si"), "Si");
+        assert_eq!(compress_consecutive("y"), "y");
+    }
+
+    #[test]
+    fn mixed_runs() {
+        assert_eq!(compress_consecutive("SiSdSd_Si"), "SiS2d_Si");
+    }
+}
