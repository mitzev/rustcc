diff --git a/compiler/rustc_codegen_llvm/src/cxx_vtable.rs b/compiler/rustc_codegen_llvm/src/cxx_vtable.rs
new file mode 100644
index 00000000000..027536007da
--- /dev/null
+++ b/compiler/rustc_codegen_llvm/src/cxx_vtable.rs
@@ -0,0 +1,313 @@
+//! P09.24 — Emit Itanium vtable / typeinfo / typeinfo-name globals
+//! for `#[repr(cpp)]` classes that have at least one inherent method
+//! tagged `#[rustc_cxx_virtual]`.
+//!
+//! # Scope (v1)
+//!
+//! - Single-inheritance only. No virtual bases, no multi-inheritance.
+//! - No `dynamic_cast` edge cases; `typeid` works for direct types
+//!   but RTTI has not been exercised across inheritance.
+//! - Class must have a complete type visible in the crate being
+//!   codegen'd (so we can read its inherent impls to find the
+//!   virtual methods).
+//!
+//! # What gets emitted
+//!
+//! For class `Widget` with virtual methods `[foo, bar]`, we emit three
+//! `LinkOnceODR` globals (deduplicated across CGUs by comdat):
+//!
+//! ```text
+//! _ZTV6Widget (vtable): [ i64 offset_to_top,
+//!                         ptr  &_ZTI6Widget,
+//!                         ptr  &Widget::foo,
+//!                         ptr  &Widget::bar ]
+//! _ZTI6Widget (typeinfo): { ptr  &_ZTVN10__cxxabiv117__class_type_infoE + 2*ptr_bytes,
+//!                           ptr  &_ZTS6Widget }
+//! _ZTS6Widget (typeinfo name): "6Widget\0"
+//! ```
+//!
+//! The vtable's *address point* (what a `this->vptr` refers to) is at
+//! slot 2 — the first function pointer. That's the target any ctor
+//! must store into offset 0 of the object.
+//!
+//! # Why a function-granular trigger
+//!
+//! Vtables need to be emitted once per polymorphic class per CGU. We
+//! don't have a "walk all classes" hook — but every polymorphic class
+//! will have at least one method codegen'd when it's used. We trigger
+//! in `predefine_fn` for any associated fn on a polymorphic class,
+//! with a per-CGU `HashSet` to dedup.
+
+use rustc_codegen_ssa::traits::*;
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::DefId;
+use rustc_middle::bug;
+use rustc_middle::ty::{self, Instance, TyCtxt};
+use rustc_symbol_mangling::itanium as cxx_mangle;
+
+use crate::builder::Builder;
+use crate::context::CodegenCx;
+use crate::llvm::{self, Value};
+
+/// P09.25: store the Itanium vtable address point
+/// (`&_ZTV<class>[2]`) into offset 0 of `ret_place_ptr` if
+/// `instance` is a `#[rustc_cxx_ctor]` on a polymorphic
+/// `#[repr(cpp)]` class. Invoked from `codegen_mir` at the
+/// start of ctor bodies — before any MIR runs, so the vptr sits
+/// in the invisible leading `ptr_bytes` of the Self value.
+pub(crate) fn maybe_emit_vptr_init<'ll, 'tcx>(
+    bx: &mut Builder<'_, 'll, 'tcx>,
+    instance: Instance<'tcx>,
+    ret_place_ptr: &'ll Value,
+) {
+    let tcx = bx.tcx;
+    let def_id = instance.def_id();
+    if !cxx_mangle::has_cxx_ctor_attr(tcx, def_id) {
+        return;
+    }
+    let Some(adt_did) = cpp_class_of_method(tcx, def_id) else {
+        return;
+    };
+    if !cxx_mangle::is_polymorphic_cpp_class(tcx, adt_did) {
+        return;
+    }
+
+    // Reference the class's vtable by its Itanium mangled name. In
+    // the common case the vtable is defined in the same CGU
+    // (emitted by `emit_vtable` via `maybe_emit_class_metadata`),
+    // but declare-if-missing still produces the right result if
+    // ordering flips.
+    let vtable_sym = cxx_mangle::mangle_cxx_vtable_symbol(tcx, adt_did);
+    let ptr_ty = bx.type_ptr();
+    let vtable_base = bx.cx.declare_global(&vtable_sym, ptr_ty);
+
+    // The address point is at byte offset `2 * ptr_bytes` from
+    // the vtable's start (skipping offset-to-top and the RTTI
+    // pointer, per the Itanium single-inheritance convention).
+    let ptr_bytes = tcx.data_layout.pointer_size().bytes();
+    let byte_offset = bx.cx.const_usize(2 * ptr_bytes);
+    let addr_point = unsafe {
+        llvm::LLVMConstInBoundsGEP2(
+            bx.cx.type_i8(),
+            vtable_base,
+            &byte_offset,
+            1,
+        )
+    };
+
+    // `ret_place_ptr` points at byte 0 of the Self storage; that's
+    // the vptr slot reserved by the polymorphic layout path.
+    let ptr_align = tcx.data_layout.pointer_align().abi;
+    bx.store(addr_point, ret_place_ptr, ptr_align);
+}
+
+/// If `def_id` is an associated fn on a polymorphic `#[repr(cpp)]`
+/// class and this CGU hasn't already emitted that class's vtable
+/// globals, emit them now.
+pub(crate) fn maybe_emit_class_metadata<'ll, 'tcx>(
+    cx: &CodegenCx<'ll, 'tcx>,
+    def_id: DefId,
+) {
+    let Some(adt_did) = cpp_class_of_method(cx.tcx, def_id) else {
+        return;
+    };
+    if !cxx_mangle::is_polymorphic_cpp_class(cx.tcx, adt_did) {
+        return;
+    }
+    // Per-CGU dedup. LinkOnceODR comdat deals with across-CGU
+    // collisions, but emitting twice in the same CGU is a hard
+    // error from LLVM.
+    if !cx.cxx_emitted_vtables.borrow_mut().insert(adt_did) {
+        return;
+    }
+    emit_class_metadata(cx, adt_did);
+}
+
+/// The class for which `def_id` is an inherent associated fn (or a
+/// `Drop::drop` trait impl). Returns `None` if `def_id` isn't a
+/// method on a `#[repr(cpp)]` ADT.
+fn cpp_class_of_method<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> Option<DefId> {
+    if tcx.def_kind(def_id) != DefKind::AssocFn {
+        return None;
+    }
+    let impl_did = tcx.opt_parent(def_id)?;
+    if !matches!(tcx.def_kind(impl_did), DefKind::Impl { .. }) {
+        return None;
+    }
+    let self_ty = tcx.type_of(impl_did).skip_binder();
+    let ty::Adt(adt_def, _) = self_ty.kind() else {
+        return None;
+    };
+    if !adt_def.repr().cpp() {
+        return None;
+    }
+    Some(adt_def.did())
+}
+
+fn emit_class_metadata<'ll, 'tcx>(cx: &CodegenCx<'ll, 'tcx>, adt_did: DefId) {
+    let tcx = cx.tcx;
+    let class_name = tcx.item_name(adt_did).to_string();
+    let class_name_mangled = mangled_class_ident(&class_name);
+
+    let vtable_sym = cxx_mangle::mangle_cxx_vtable_symbol(tcx, adt_did);
+    let typeinfo_sym = cxx_mangle::mangle_cxx_typeinfo_symbol(tcx, adt_did);
+    let typeinfo_name_sym =
+        cxx_mangle::mangle_cxx_typeinfo_name_symbol(tcx, adt_did);
+
+    // `_ZTS<class>`: null-terminated byte string of the mangled class
+    // name. For `Widget` that's "6Widget\0".
+    let typeinfo_name_gv =
+        emit_typeinfo_name(cx, &typeinfo_name_sym, &class_name_mangled);
+
+    // `_ZTI<class>`: 2 slots for a root polymorphic class
+    // (__class_type_info) or 3 slots for a derived class
+    // (__si_class_type_info — adds a pointer to the base's
+    // `_ZTI`). emit_typeinfo dispatches based on whether the
+    // class has a polymorphic base.
+    let typeinfo_gv = emit_typeinfo(cx, tcx, adt_did, &typeinfo_sym, typeinfo_name_gv);
+
+    // `_ZTV<class>`: array of pointers. Slot 0 is offset-to-top (i64
+    // zero, but stored as a pointer for uniform layout); slot 1 is
+    // the typeinfo pointer; slots 2+ are virtual method pointers in
+    // declaration order.
+    emit_vtable(cx, adt_did, &vtable_sym, typeinfo_gv);
+}
+
+/// Build `"<len><name>\0"` — the Itanium typeinfo-name form for a
+/// single-segment class at the global namespace. For nested classes
+/// the format is different (`N...E` bracketed), but v1 scope.
+fn mangled_class_ident(name: &str) -> String {
+    format!("{}{}", name.len(), name)
+}
+
+fn emit_typeinfo_name<'ll, 'tcx>(
+    cx: &CodegenCx<'ll, 'tcx>,
+    symbol: &str,
+    mangled: &str,
+) -> &'ll Value {
+    let bytes_with_nul: Vec<u8> = mangled
+        .as_bytes()
+        .iter()
+        .copied()
+        .chain(std::iter::once(0u8))
+        .collect();
+    let initializer = cx.const_bytes(&bytes_with_nul);
+    let llty = cx.val_ty(initializer);
+    let gv = cx.define_global(symbol, llty).unwrap_or_else(|| {
+        bug!(
+            "cxx_vtable: symbol `{symbol}` already defined (typeinfo name)"
+        )
+    });
+    llvm::set_initializer(gv, initializer);
+    llvm::set_linkage(gv, llvm::Linkage::LinkOnceODRLinkage);
+    llvm::LLVMSetGlobalConstant(gv, llvm::TRUE);
+    if cx.tcx.sess.target.supports_comdat() {
+        llvm::SetUniqueComdat(cx.llmod, gv);
+    }
+    gv
+}
+
+fn emit_typeinfo<'ll, 'tcx>(
+    cx: &CodegenCx<'ll, 'tcx>,
+    tcx: TyCtxt<'tcx>,
+    adt_did: DefId,
+    symbol: &str,
+    typeinfo_name: &'ll Value,
+) -> &'ll Value {
+    let ptr_ty = cx.type_ptr();
+    let ptr_bytes = tcx.data_layout.pointer_size().bytes();
+
+    // P09.35: pick the RTTI kind based on whether this class has
+    // a polymorphic base. Root classes use `__class_type_info`
+    // (2 slots); single-inheritance derived classes use
+    // `__si_class_type_info` (3 slots, last is base typeinfo).
+    let base_did = cxx_mangle::polymorphic_base_of_class(tcx, adt_did);
+    let rtti_vtable_sym = if base_did.is_some() {
+        "_ZTVN10__cxxabiv120__si_class_type_infoE"
+    } else {
+        "_ZTVN10__cxxabiv117__class_type_infoE"
+    };
+    let rtti_vtable_base = cx.declare_global(rtti_vtable_sym, ptr_ty);
+    let byte_offset = cx.const_usize(2 * ptr_bytes);
+    let rtti_vtable_addr_point = unsafe {
+        llvm::LLVMConstInBoundsGEP2(cx.type_i8(), rtti_vtable_base, &byte_offset, 1)
+    };
+
+    let initializer = if let Some(base_did) = base_did {
+        let base_typeinfo_sym = cxx_mangle::mangle_cxx_typeinfo_symbol(tcx, base_did);
+        let base_typeinfo_ref = cx.declare_global(&base_typeinfo_sym, ptr_ty);
+        cx.const_struct(
+            &[rtti_vtable_addr_point, typeinfo_name, base_typeinfo_ref],
+            false,
+        )
+    } else {
+        cx.const_struct(&[rtti_vtable_addr_point, typeinfo_name], false)
+    };
+
+    let llty = cx.val_ty(initializer);
+    let gv = cx.define_global(symbol, llty).unwrap_or_else(|| {
+        bug!("cxx_vtable: symbol `{symbol}` already defined (typeinfo)")
+    });
+    llvm::set_initializer(gv, initializer);
+    llvm::set_linkage(gv, llvm::Linkage::LinkOnceODRLinkage);
+    llvm::LLVMSetGlobalConstant(gv, llvm::TRUE);
+    if cx.tcx.sess.target.supports_comdat() {
+        llvm::SetUniqueComdat(cx.llmod, gv);
+    }
+    gv
+}
+
+fn emit_vtable<'ll, 'tcx>(
+    cx: &CodegenCx<'ll, 'tcx>,
+    adt_did: DefId,
+    symbol: &str,
+    typeinfo: &'ll Value,
+) {
+    let tcx = cx.tcx;
+    let ptr_ty = cx.type_ptr();
+    let isize_ty = cx.type_isize();
+
+    // Slot 0: offset_to_top. For the primary sub-table of the most-
+    // derived class (and we don't support multi-inheritance in v1)
+    // this is zero.
+    let offset_to_top = cx.const_int(isize_ty, 0);
+    // LLVM's const_struct wants all slots to have a consistent
+    // element type if it's an array; but a vtable is naturally a
+    // struct of mixed ptr + int. We use const_struct (packed=false)
+    // so LLVM lays out offset-to-top as a pointer-sized integer and
+    // the rest as pointers. Clang does the same — vtables are
+    // `{ i64, ptr, ptr, ... }` in its LLVM IR.
+    let mut slots: Vec<&'ll Value> = Vec::new();
+    slots.push(offset_to_top);
+    slots.push(typeinfo);
+
+    // Slots 2+: virtual method fn-pointers along the inheritance
+    // chain — base virtuals first, then derived-class virtuals.
+    // For v1 there's no override support, so base slots always
+    // point at base's own implementations; users must keep the
+    // C++ header's virtual order in sync.
+    let virtuals = cxx_mangle::virtuals_on_chain(tcx, adt_did);
+    for method_did in virtuals {
+        // Non-generic methods only in v1. If we hit a generic, the
+        // user should monomorphize it manually before the polymorphic
+        // use site. Here we synthesize an Instance with empty args
+        // and rely on the usual Rust monomorphization machinery to
+        // have already run.
+        let instance = Instance::mono(tcx, method_did);
+        let fn_val = cx.get_fn_addr(instance);
+        slots.push(fn_val);
+    }
+    let _ = ptr_ty; // (retained for readability; const_struct infers)
+
+    let initializer = cx.const_struct(&slots, false);
+    let llty = cx.val_ty(initializer);
+    let gv = cx.define_global(symbol, llty).unwrap_or_else(|| {
+        bug!("cxx_vtable: symbol `{symbol}` already defined (vtable)")
+    });
+    llvm::set_initializer(gv, initializer);
+    llvm::set_linkage(gv, llvm::Linkage::LinkOnceODRLinkage);
+    llvm::LLVMSetGlobalConstant(gv, llvm::TRUE);
+    if cx.tcx.sess.target.supports_comdat() {
+        llvm::SetUniqueComdat(cx.llmod, gv);
+    }
+}
