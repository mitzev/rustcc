diff --git a/compiler/rustc_codegen_llvm/src/mono_item.rs b/compiler/rustc_codegen_llvm/src/mono_item.rs
index 0783282bc6e..a38ed354837 100644
--- a/compiler/rustc_codegen_llvm/src/mono_item.rs
+++ b/compiler/rustc_codegen_llvm/src/mono_item.rs
@@ -71,6 +71,19 @@ fn predefine_fn(
             self.predefine_without_aliases(instance, &attrs, linkage, visibility, symbol_name);
         self.add_function_aliases(instance, lldecl, &attrs, &attrs.foreign_item_symbol_aliases);
 
+        // P09.15: emit D0 (deleting) and D2 (base-object) Itanium
+        // destructor variants as siblings of the D1 we just
+        // predefined. Required so virtual dispatch of `delete p`
+        // through a C++ base pointer lands in Rust's Drop impl.
+        self.maybe_add_cxx_dtor_variants(instance, lldecl, linkage, visibility);
+
+        // P09.24: if this fn is a method on a polymorphic
+        // `#[repr(cpp)]` class, emit the class's vtable / typeinfo /
+        // typeinfo-name globals. Per-CGU dedup via a hashset on
+        // `CodegenCx`; LinkOnceODR linkage handles across-CGU
+        // dedup at link time.
+        crate::cxx_vtable::maybe_emit_class_metadata(self, instance.def_id());
+
         self.instances.borrow_mut().insert(instance, lldecl);
     }
 }
@@ -151,6 +164,103 @@ fn add_static_aliases(&self, aliasee: &llvm::Value, aliases: &[(DefId, Linkage,
         }
     }
 
+    /// P09.15: For Rust `Drop` impls on `#[repr(cpp)]` types,
+    /// emit the Itanium D0 (deleting) and D2 (base-object)
+    /// destructor variants as trampolines alongside D1. Required
+    /// for virtual dispatch of `delete p` through a C++ base
+    /// pointer to land in Rust's Drop.
+    ///
+    /// - D2 is a plain forward to D1 (in single-inheritance
+    ///   without virtual bases, D1 and D2 run the same user code).
+    /// - D0 forwards to D1 then calls `operator delete(this)`
+    ///   (`_ZdlPv`), matching Clang's emission for
+    ///   `delete derived_obj`.
+    fn maybe_add_cxx_dtor_variants(
+        &self,
+        instance: Instance<'tcx>,
+        d1_decl: &'ll llvm::Value,
+        linkage: Linkage,
+        visibility: Visibility,
+    ) {
+        let def_id = instance.def_id();
+        if !rustc_symbol_mangling::itanium::is_cxx_drop_impl(self.tcx, def_id) {
+            return;
+        }
+        // P09.23: `#[rustc_cxx_drop_wrapper]` opts out of D0/D2
+        // trampoline emission. Used when the C++ side already
+        // defines the destructor and Rust's Drop body is just a
+        // forwarder — emitting trampolines would produce
+        // duplicate-symbol link errors against the C++ side.
+        if rustc_hir::find_attr!(self.tcx, def_id, RustcCxxDropWrapper(..)) {
+            return;
+        }
+
+        let fn_abi: &FnAbi<'tcx, Ty<'tcx>> =
+            self.fn_abi_of_instance(instance, ty::List::empty());
+        let fn_ty = fn_abi.llvm_type(self);
