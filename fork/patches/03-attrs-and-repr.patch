diff --git a/compiler/rustc_codegen_ssa/src/codegen_attrs.rs b/compiler/rustc_codegen_ssa/src/codegen_attrs.rs
index 820436bb..f7a5ca18 100644
--- a/compiler/rustc_codegen_ssa/src/codegen_attrs.rs
+++ b/compiler/rustc_codegen_ssa/src/codegen_attrs.rs
@@ -357,6 +357,44 @@ fn apply_overrides(tcx: TyCtxt<'_>, did: LocalDefId, codegen_fn_attrs: &mut Code
         codegen_fn_attrs.flags |= CodegenFnAttrFlags::TRACK_CALLER;
     }
 
+    // Tier 1 inferred-C++ methods: an assoc fn on an `impl` whose
+    // self-type is a `#[repr(cpp)]` ADT needs external linkage so
+    // the Itanium-mangled symbol is visible to C++ linkers. Setting
+    // NO_MANGLE gives the right visibility side-effect; the actual
+    // symbol name is still overridden by
+    // `rustc_symbol_mangling::itanium::mangle` which runs earlier
+    // in `compute_symbol_name` and wins.
+    //
+    // P09.22: `#[rustc_cxx_wrapper]` opts out. Used by wrapper
+    // methods that forward to an `extern "C++"` decl under the
+    // same Itanium name — auto-exporting them would produce a
+    // self-recursive symbol.
+    //
+    // P09.23: `#[rustc_cxx_drop_wrapper]` is the trait-impl
+    // analogue — opts a `Drop::drop` out of auto-export so the
+    // Rust body can forward to a C++-side destructor without the
+    // D1 symbol colliding at link time.
+    if tcx.def_kind(did) == DefKind::AssocFn
+        && let Some(impl_did) = tcx.opt_parent(did.to_def_id())
+        && matches!(tcx.def_kind(impl_did), DefKind::Impl { .. })
+        && let ty::Adt(adt_def, _) = tcx.type_of(impl_did).skip_binder().kind()
+        && adt_def.repr().cpp()
+        && !rustc_hir::find_attr!(tcx, did.to_def_id(), RustcCxxWrapper(..))
+        && !rustc_hir::find_attr!(tcx, did.to_def_id(), RustcCxxDropWrapper(..))
+        // P09.34: generic methods (or methods on a generic impl)
+        // can't share a single C++-linkable symbol — each
+        // monomorphization would collide. Skip auto-export for
+        // them; they use regular Rust mangling per
+        // monomorphization and aren't callable from C++ without
+        // explicit `extern "C"` wrappers.
+        && tcx.generics_of(impl_did).own_params.iter()
+            .all(|p| p.kind.is_synthetic())
+        && tcx.generics_of(did).own_params.iter()
+            .all(|p| p.kind.is_synthetic())
+    {
+        codegen_fn_attrs.flags |= CodegenFnAttrFlags::NO_MANGLE;
+    }
+
     // Foreign items by default use no mangling for their symbol name.
     if tcx.is_foreign_item(did) {
         codegen_fn_attrs.flags |= CodegenFnAttrFlags::FOREIGN_ITEM;
