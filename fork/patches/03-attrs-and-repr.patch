+    // and the vtable/typeinfo emitters to chain to the base.
+    rustc_attr!(rustc_cxx_base, "marks a field as the polymorphic base subobject of a `#[repr(cpp)]` derived class (set automatically by the `class D : B` parser sugar)"),
+    // P09.16: marks a fn in an `extern "Swift"` block as living
+    // in a named Swift module; the Swift mangler uses the module
+    // to produce `$s<module><name>...` link names.
+    rustc_attr!(swift_symbol, "names the Swift module hosting an `extern \"Swift\"` function, driving Swift ABI name mangling"),
+    // P09.17: marks a Rust struct as representing a Swift value
+    // type — used by the Swift mangler when the Rust struct
+    // appears in an `extern "Swift"` signature.
+    rustc_attr!(swift_type, "binds a Rust type to a Swift value-type qualified name (e.g. `\"MyLib.Point\"`) for Swift ABI mangling"),
+    // P09.17: Swift parameter labels for an `extern "Swift"` fn.
+    // Comma-separated; `_` for unnamed, `<label>` for named.
+    rustc_attr!(rustc_swift_labels, "Swift parameter labels for an `extern \"Swift\"` function (comma-separated, `_` for unnamed)"),
 
     // Limits:
     ungated!(recursion_limit),
