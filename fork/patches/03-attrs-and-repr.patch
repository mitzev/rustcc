+/// P09 Tier 3: `#[rustc_cxx_ctor]` — marks a method on a
+/// `#[repr(cpp)]` impl as a C++ constructor. Mangling routes
+/// through `Symbol::Ctor` producing `_ZN<class>C1E<args>`.
+pub(crate) struct RustcCxxCtorParser;
+
+impl<S: Stage> NoArgsAttributeParser<S> for RustcCxxCtorParser {
+    const PATH: &[Symbol] = &[sym::constructor];
+    // P09.22: also allow on `ForeignFn`. Lets `cxx_class!` and
+    // hand-written `extern "C++" { #[rustc_cxx_ctor] fn new(...) -> Self; }`
+    // share a single ctor-mangling path, retiring the macro's
+    // sret trampoline + manual `#[link_name]`.
+    const ALLOWED_TARGETS: AllowedTargets = AllowedTargets::AllowList(&[
+        Allow(Target::Method(MethodKind::Inherent)),
+        Allow(Target::ForeignFn),
+    ]);
+    const CREATE: fn(Span) -> AttributeKind = AttributeKind::RustcCxxCtor;
+}
+
+/// P09.22: `#[rustc_cxx_wrapper]` — opts an inherent method on a
+/// `#[repr(cpp)]` type out of P09.3's auto-export path. Used for
+/// thin wrappers that forward to an `extern "C++"` decl of the
+/// same method.
+pub(crate) struct RustcCxxWrapperParser;
+
+impl<S: Stage> NoArgsAttributeParser<S> for RustcCxxWrapperParser {
+    const PATH: &[Symbol] = &[sym::rustc_cxx_wrapper];
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::Method(MethodKind::Inherent))]);
+    const CREATE: fn(Span) -> AttributeKind = AttributeKind::RustcCxxWrapper;
+}
+
+/// P09.23: `#[rustc_cxx_drop_wrapper]` — trait-impl analogue of
+/// `#[rustc_cxx_wrapper]`. Applied to `Drop::drop` in an
+/// `impl Drop for T` where `T` is `#[repr(cpp)]`, opts that method
+/// out of P09.15's D0/D1/D2 auto-emission. Used by
+/// `cxx_class_native!` when the C++ side already defines the
+/// destructor and the Rust Drop body is a thin forwarder to an
+/// `extern "C++"` decl.
+pub(crate) struct RustcCxxDropWrapperParser;
+
+impl<S: Stage> NoArgsAttributeParser<S> for RustcCxxDropWrapperParser {
+    const PATH: &[Symbol] = &[sym::rustc_cxx_drop_wrapper];
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::Method(MethodKind::TraitImpl))]);
+    const CREATE: fn(Span) -> AttributeKind = AttributeKind::RustcCxxDropWrapper;
+}
+
+/// P09.24: `#[rustc_cxx_virtual]` — marks an inherent method on a
+/// `#[repr(cpp)]` type as a virtual member function. Drives
+/// vtable/typeinfo emission and ctor vptr init.
+pub(crate) struct RustcCxxVirtualParser;
+
+impl<S: Stage> NoArgsAttributeParser<S> for RustcCxxVirtualParser {
+    const PATH: &[Symbol] = &[sym::cpp_virtual];
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::Method(MethodKind::Inherent))]);
+    const CREATE: fn(Span) -> AttributeKind = AttributeKind::RustcCxxVirtual;
+}
+
+/// P09.35: `#[rustc_cxx_base]` — marks a struct field as the
+/// polymorphic base subobject of a derived class.
+pub(crate) struct RustcCxxBaseParser;
+
+impl<S: Stage> NoArgsAttributeParser<S> for RustcCxxBaseParser {
+    const PATH: &[Symbol] = &[sym::rustc_cxx_base];
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::Field)]);
+    const CREATE: fn(Span) -> AttributeKind = AttributeKind::RustcCxxBase;
+}
+
+/// P09.20: `#[rustc_cxx_operator = "Plus"]` — marks a method on
+/// a `#[repr(cpp)]` impl as a C++ operator overload. The string
+/// value names the operator kind (matches the variants of
+/// `rustc_abi_cxx::OperatorKind`).
+pub(crate) struct RustcCxxOperatorParser;
+
+impl<S: Stage> SingleAttributeParser<S> for RustcCxxOperatorParser {
+    const PATH: &[Symbol] = &[sym::operator];
+    const ON_DUPLICATE: OnDuplicate<S> = OnDuplicate::Error;
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::Method(MethodKind::Inherent))]);
+    const TEMPLATE: AttributeTemplate = template!(NameValueStr: "Plus");
+
+    fn convert(cx: &mut AcceptContext<'_, '_, S>, args: &ArgParser) -> Option<AttributeKind> {
+        let Some(nv) = args.name_value() else {
+            let attr_span = cx.attr_span;
+            cx.adcx().expected_name_value(attr_span, None);
+            return None;
+        };
+        let Some(kind) = nv.value_as_str() else {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
+        };
+        Some(AttributeKind::RustcCxxOperator { kind, span: cx.attr_span })
+    }
+}
+
+/// P09.16: `#[rustc_swift_symbol = "ModuleName"]` — binds an
+/// `extern "Swift"` fn to a Swift module so its link name can
+/// be mangled as `$s<module><name>...F`.
+pub(crate) struct RustcSwiftSymbolParser;
+
+impl<S: Stage> SingleAttributeParser<S> for RustcSwiftSymbolParser {
+    const PATH: &[Symbol] = &[sym::swift_symbol];
+    const ON_DUPLICATE: OnDuplicate<S> = OnDuplicate::Error;
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::ForeignFn)]);
+    const TEMPLATE: AttributeTemplate = template!(NameValueStr: "ModuleName");
+
+    fn convert(cx: &mut AcceptContext<'_, '_, S>, args: &ArgParser) -> Option<AttributeKind> {
+        let Some(nv) = args.name_value() else {
+            let attr_span = cx.attr_span;
+            cx.adcx().expected_name_value(attr_span, None);
+            return None;
+        };
+        let Some(module) = nv.value_as_str() else {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
+        };
+        Some(AttributeKind::RustcSwiftSymbol { module, span: cx.attr_span })
+    }
+}
+
+/// P09.17: `#[rustc_swift_type = "Module.TypeName"]` — binds a
+/// Rust struct to a Swift value-type qualified name for Swift
+/// ABI mangling. Format is `<module>.<name>`; kind defaults to
+/// value type (struct).
+pub(crate) struct RustcSwiftTypeParser;
+
+impl<S: Stage> SingleAttributeParser<S> for RustcSwiftTypeParser {
+    const PATH: &[Symbol] = &[sym::swift_type];
+    const ON_DUPLICATE: OnDuplicate<S> = OnDuplicate::Error;
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::Struct)]);
+    const TEMPLATE: AttributeTemplate = template!(NameValueStr: "Module.TypeName");
+
+    fn convert(cx: &mut AcceptContext<'_, '_, S>, args: &ArgParser) -> Option<AttributeKind> {
+        let Some(nv) = args.name_value() else {
+            let attr_span = cx.attr_span;
+            cx.adcx().expected_name_value(attr_span, None);
+            return None;
+        };
+        let Some(s) = nv.value_as_str() else {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
+        };
+        // Format: "Module.Name" (defaults to struct/V kind) or
+        // "Module.Name:class" (reference-type/C kind). Split off
+        // an optional trailing `:class` suffix first.
+        let raw = s.as_str();
+        let (body, is_class) = match raw.rsplit_once(':') {
+            Some((b, "class")) => (b, true),
+            Some((b, "struct")) => (b, false),
+            // No colon, or unrecognized tail — treat whole
+            // string as "Module.Name" with default kind.
+            _ => (raw, false),
+        };
+        let Some((module_str, name_str)) = body.rsplit_once('.') else {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
+        };
+        if module_str.is_empty() || name_str.is_empty() {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
+        }
+        let module = Symbol::intern(module_str);
+        let name = Symbol::intern(name_str);
+        Some(AttributeKind::RustcSwiftType { module, name, is_class, span: cx.attr_span })
+    }
+}
+
+/// P09.17: `#[rustc_swift_labels = "_, by"]` — Swift parameter
+/// labels for a fn in an `extern "Swift"` block. Tokens are
+/// comma-separated; `_` means unnamed, any other token is the
+/// label name as it appears on the Swift side.
+pub(crate) struct RustcSwiftLabelsParser;
+
+impl<S: Stage> SingleAttributeParser<S> for RustcSwiftLabelsParser {
+    const PATH: &[Symbol] = &[sym::rustc_swift_labels];
+    const ON_DUPLICATE: OnDuplicate<S> = OnDuplicate::Error;
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::ForeignFn)]);
+    const TEMPLATE: AttributeTemplate = template!(NameValueStr: "_, by, from");
+
+    fn convert(cx: &mut AcceptContext<'_, '_, S>, args: &ArgParser) -> Option<AttributeKind> {
+        let Some(nv) = args.name_value() else {
+            let attr_span = cx.attr_span;
+            cx.adcx().expected_name_value(attr_span, None);
+            return None;
+        };
+        let Some(labels) = nv.value_as_str() else {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
+        };
+        Some(AttributeKind::RustcSwiftLabels { labels, span: cx.attr_span })
+    }
+}
+
