+    // prologues that store the vtable address point into offset 0.
+    rustc_attr!(cpp_virtual, "marks an inherent method on a `#[repr(cpp)]` type as a C++ virtual member function (drives `_ZTV`/`_ZTI`/`_ZTS` emission and ctor vptr init)"),
+    // P09.35: marks a field in a `#[repr(cpp)]` struct as the
