+/// P09.24: true if any inherent method on `adt_did` (a
+/// `#[repr(cpp)]` ADT) carries `#[rustc_cxx_virtual]`. Drives
+/// vtable / typeinfo emission and ctor vptr init.
+pub fn is_polymorphic_cpp_class<'tcx>(tcx: TyCtxt<'tcx>, adt_did: DefId) -> bool {
+    !virtual_methods_on_class(tcx, adt_did).is_empty()
+}
+
+/// P09.24: Itanium-mangled name for the class's vtable
+/// (`_ZTV<class>`), typeinfo (`_ZTI<class>`), or typeinfo-name
