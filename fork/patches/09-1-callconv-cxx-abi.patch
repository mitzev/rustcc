+/// P09 — Itanium C++ ABI overlay for SysV AMD64.
+///
+/// Runs the standard C-path `compute_abi_info` first (scalars,
+/// pointers, and plain POD aggregates already agree between C
+/// and C++). Then applies the Itanium-specific rule: any type
+/// that is **non-trivial for C++ calls** (a `#[repr(cpp)]` ADT
+/// with a user `Drop` impl) is passed / returned by invisible
+/// reference regardless of its size.
+///
+/// This diverges from the stock C path for the narrow case of
+/// small non-POD records — an 8-byte `#[repr(cpp)]` struct with
+/// `impl Drop` would fit in rax under `extern "C"`, but Clang
+/// returns it via sret under `extern "C++"`. The fork has to
+/// match Clang so linkers agree.
+pub(crate) fn compute_cxx_abi_info<'a, Ty, C>(cx: &C, fn_abi: &mut FnAbi<'a, Ty>)
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+    C: HasDataLayout + HasTargetSpec,
+{
+    // First: regular C-path lowering. Handles everything the two
+    // ABIs agree on.
+    compute_abi_info(cx, fn_abi);
+
+    // Itanium override: promote non-trivial-for-calls types to
+    // indirect. Uses `force_indirect` rather than `make_indirect`
+    // because the C path may have already transitioned the arg
+    // to `Cast` (small aggregates fitting in registers), and
+    // `make_indirect` asserts a `Direct|Pair` starting state.
+    // `force_indirect` bypasses that assertion — correct because
+    // we're deliberately overriding the C classification to
+    // match Clang's Itanium output.
+    if !fn_abi.ret.is_ignore()
+        && fn_abi.ret.layout.is_cxx_non_trivial_for_calls(cx)
+    {
+        fn_abi.ret.force_indirect();
+    }
+    for arg in fn_abi.args.iter_mut() {
+        if arg.is_ignore() {
+            continue;
+        }
+        if arg.layout.is_cxx_non_trivial_for_calls(cx) {
+            arg.force_indirect();
+        }
+    }
+}
