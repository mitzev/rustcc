+    /// Verify-override check for the `override` method modifier in a
+    /// `class` body (P09.x / 1.13.5). `override fn m` desugars to
+    /// `#[cpp_virtual] #[rustc_cxx_override] fn m`; this confirms that
+    /// some class in the polymorphic base chain declares a virtual
+    /// method named `m`. If none does, the `override` is a no-op that
+    /// silently *adds* a new vtable slot (because override-matching is
+    /// by name) — exactly the footgun C++'s `override` exists to catch
+    /// — so we make it a hard error.
+    fn check_cxx_override(&self, hir_id: HirId, attr_span: Span, target: Target) {
+        // The attribute parser already restricts placement to inherent
+        // methods; bail defensively on anything else.
+        if !matches!(target, Target::Method(MethodKind::Inherent)) {
+            return;
+        }
+        let tcx = self.tcx;
+        let method_did = hir_id.owner.def_id.to_def_id();
+        // Parent of an inherent assoc fn is its `impl`; the impl's Self
+        // type is the class ADT we walk the base chain of.
+        let impl_did = tcx.local_parent(hir_id.owner.def_id).to_def_id();
+        let ty::Adt(adt, _) = tcx.type_of(impl_did).skip_binder().kind() else {
+            return;
+        };
+        let method_name = tcx.item_name(method_did);
+
+        // Walk the polymorphic base chain looking for a virtual with
+        // the same name. Mirrors `polymorphic_base_of_class` /
+        // `virtual_methods_on_class` in rustc_symbol_mangling (kept
+        // local to avoid a crate dependency from rustc_passes).
+        let mut cursor = cxx_polymorphic_base_of(tcx, adt.did());
+        let mut overrides_base = false;
+        while let Some(base_did) = cursor {
+            if cxx_virtual_methods_on(tcx, base_did)
+                .into_iter()
+                .any(|m| tcx.item_name(m) == method_name)
+            {
+                overrides_base = true;
+                break;
+            }
+            cursor = cxx_polymorphic_base_of(tcx, base_did);
+        }
+
+        if !overrides_base {
+            self.tcx
+                .dcx()
+                .struct_span_err(
+                    attr_span,
+                    format!(
+                        "method `{method_name}` is marked `override` but does not \
+                         override a virtual method from a base class"
+                    ),
+                )
+                .with_help(
+                    "use `virtual` instead to declare a new virtual method, or check \
+                     that a base class declares a `virtual` method with this name",
+                )
+                .emit();
+        }
+    }
+
     /// Checks if `#[naked]` is applied to a function definition.
     fn check_naked(&self, hir_id: HirId, target: Target) {
