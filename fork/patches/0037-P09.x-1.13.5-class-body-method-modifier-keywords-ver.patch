 }
 
+/// The polymorphic base ADT of a `#[repr(cpp)]` class, if its first
+/// field carries `#[rustc_cxx_base]`. Local copy of
+/// `rustc_symbol_mangling::itanium::polymorphic_base_of_class` (which
+/// rustc_passes does not depend on). Used by the `override`
+/// verify-override check.
+fn cxx_polymorphic_base_of(tcx: TyCtxt<'_>, adt_did: DefId) -> Option<DefId> {
+    let adt = tcx.adt_def(adt_did);
+    let variant = adt.variants().iter().next()?;
+    let first = variant.fields.raw.first()?;
+    if !find_attr!(tcx, first.did, RustcCxxBase(..)) {
+        return None;
+    }
+    match tcx.type_of(first.did).skip_binder().kind() {
+        ty::Adt(base_adt, _) => Some(base_adt.did()),
+        _ => None,
+    }
+}
+
+/// The inherent methods of `adt_did` that carry `#[cpp_virtual]`.
+/// Local copy of `rustc_symbol_mangling::itanium::
+/// virtual_methods_on_class` (membership-only; order irrelevant here).
+fn cxx_virtual_methods_on(tcx: TyCtxt<'_>, adt_did: DefId) -> Vec<DefId> {
+    let mut out = Vec::new();
+    for impl_did in tcx.inherent_impls(adt_did).iter().copied() {
+        for m in tcx.associated_item_def_ids(impl_did).iter().copied() {
+            if tcx.def_kind(m) == DefKind::AssocFn && find_attr!(tcx, m, RustcCxxVirtual(..)) {
+                out.push(m);
+            }
+        }
+    }
+    out
+}
