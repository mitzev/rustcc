+            // P09.x (v1.13.5): C++-style method-modifier keywords inside a
+            // `class` body — `(pub)? (virtual|override|constructor)* fn`.
+            // `virtual` and `override` are reserved keywords; `constructor`
+            // is a contextual keyword (only a modifier when a method
+            // follows, so a field named `constructor` still parses). They
+            // desugar to the existing `#[cpp_virtual]` / `#[constructor]`
+            // attributes (`override` adds `#[rustc_cxx_override]` too, which
+            // drives the verify-override check), so all downstream
+            // layout/codegen is unchanged.
+            let is_class_modifier = |t: &token::Token| {
+                t.is_keyword(kw::Virtual)
+                    || t.is_keyword(kw::Override)
+                    || t.is_ident_named(sym::constructor)
+            };
+            let modifier_off = if is_class_modifier(&first) {
+                Some(0)
+            } else if first.is_keyword(kw::Pub) && is_class_modifier(&peek(1)) {
+                Some(1)
+            } else {
+                None
+            };
+            // Only a modified method if a real method keyword follows the
+            // modifier run (guards a field literally named `constructor`).
+            let is_modified_method = modifier_off.is_some_and(|off| {
+                let mut k = off;
+                while is_class_modifier(&peek(k)) {
+                    k += 1;
+                }
+                is_method_after_vis(&peek(k))
+            });
+
+            if is_modified_method {
+                let off = modifier_off.unwrap();
+                if post_attrs != 0 {
+                    return Err(self.dcx().struct_span_err(
+                        self.token.span,
+                        "`virtual` / `override` / `constructor` keyword modifiers can't be \
+                         combined with attributes; use the `#[cpp_virtual]` / `#[constructor]` \
+                         attribute form instead",
+                    ));
+                }
+                // Consume an optional leading `pub` ourselves (the delegated
+                // `parse_assoc_item` would otherwise choke on the following
+                // modifier keyword); graft it back onto the parsed method.
+                let saved_vis = if off == 1 {
+                    Some(self.parse_visibility(FollowedByType::No)?)
+                } else {
+                    None
+                };
+                // Consume the modifier run, synthesizing the matching attrs.
+                let mut synth: ThinVec<Attribute> = ThinVec::new();
+                while is_class_modifier(&self.token) {
+                    let is_virtual = self.token.is_keyword(kw::Virtual);
+                    let is_override = self.token.is_keyword(kw::Override);
+                    let sp = self.token.span;
+                    self.bump();
+                    // `virtual` and `override` are both virtual member fns;
+                    // `override` additionally carries the verify-override
+                    // marker. `constructor` maps to `#[constructor]`.
+                    let mut emit = |name| {
+                        synth.push(rustc_ast::attr::mk_attr_word(
+                            &self.psess.attr_id_generator,
+                            ast::AttrStyle::Outer,
+                            ast::Safety::Default,
+                            name,
+                            sp,
+                        ));
+                    };
+                    if is_virtual || is_override {
+                        emit(sym::cpp_virtual);
+                    }
+                    if is_override {
+                        emit(sym::rustc_cxx_override);
+                    }
+                    if !is_virtual && !is_override {
+                        emit(sym::constructor);
+                    }
+                }
+                let fn_parse_mode = FnParseMode {
+                    req_name: |_, _| true,
+                    context: FnContext::Impl,
+                    req_body: true,
+                };
+                let assoc = self.parse_assoc_item(fn_parse_mode, ForceCollect::No)?;
+                match assoc {
+                    Some(Some(mut item)) => {
+                        if let Some(vis) = saved_vis {
+                            item.vis = vis;
+                        }
+                        item.attrs.extend(synth);
+                        methods.push(item);
+                        saw_method = true;
+                    }
+                    Some(None) | None => {
+                        return Err(self.dcx().struct_span_err(
+                            self.token.span,
+                            "expected a method inside `class` body",
+                        ));
+                    }
+                }
+                continue;
+            }
+
