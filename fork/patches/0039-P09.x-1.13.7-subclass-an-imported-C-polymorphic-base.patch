+/// `#[rustc_cxx_imported_vtable = "<spec>"]` — placed by `cxx_importer`
+/// on an imported C++ polymorphic class's `#[repr(C)]` struct so a Rust
+/// `class D : CppBase` can subclass it with cross-boundary virtual
+/// dispatch. The `<spec>` lists the base's primary-vtable
+/// function-pointer slots in C++ order:
+/// `zti=<_ZTI sym>;slot=<name>,<sym>;slot=<name>,<sym>…`.
+/// See `AttributeKind::RustcCxxImportedVtable` for the full grammar.
+pub(crate) struct RustcCxxImportedVtableParser;
+
+impl<S: Stage> SingleAttributeParser<S> for RustcCxxImportedVtableParser {
+    const PATH: &[Symbol] = &[sym::rustc_cxx_imported_vtable];
+    const ON_DUPLICATE: OnDuplicate<S> = OnDuplicate::Error;
+    const ALLOWED_TARGETS: AllowedTargets =
+        AllowedTargets::AllowList(&[Allow(Target::Struct)]);
+    const TEMPLATE: AttributeTemplate =
+        template!(NameValueStr: "zti=_ZTI8CppBase;slot=foo,_ZN8CppBase3fooEv");
+
+    fn convert(cx: &mut AcceptContext<'_, '_, S>, args: &ArgParser) -> Option<AttributeKind> {
+        let Some(nv) = args.name_value() else {
+            let attr_span = cx.attr_span;
+            cx.adcx().expected_name_value(attr_span, None);
+            return None;
+        };
+        let Some(spec) = nv.value_as_str() else {
+            cx.adcx().expected_string_literal(nv.value_span, Some(nv.value_as_lit()));
+            return None;
+        };
+        Some(AttributeKind::RustcCxxImportedVtable { spec, span: cx.attr_span })
+    }
+}
