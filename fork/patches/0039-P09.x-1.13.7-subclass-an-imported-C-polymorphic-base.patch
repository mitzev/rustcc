+/// P09.x (1.13.7): the function-pointer constant for one vtable slot.
+/// A Rust method uses its monomorphized address (`get_fn_addr`); a slot
+/// inherited from an *imported* C++ base that isn't overridden uses the
+/// real C++ implementation symbol, declared as an external function.
+/// Taking the declaration's address is all the vtable needs — the
+/// declared signature (`void()`) is irrelevant under opaque pointers,
+/// and if the importer also declared the same symbol with its true
+/// signature LLVM unifies the two by name.
+fn cxx_vt_slot_fn_addr<'ll, 'tcx>(
+    cx: &CodegenCx<'ll, 'tcx>,
+    slot: &cxx_mangle::CxxVtSlot,
+) -> &'ll Value {
+    match slot {
+        cxx_mangle::CxxVtSlot::Rust { def_id, .. } => {
+            cx.get_fn_addr(Instance::mono(cx.tcx, *def_id))
+        }
+        cxx_mangle::CxxVtSlot::Imported { link_name, .. } => {
+            let fn_ty = cx.type_func(&[], cx.type_void());
+            cx.declare_cfn(link_name.as_str(), llvm::UnnamedAddr::No, fn_ty)
+        }
+    }
+}
