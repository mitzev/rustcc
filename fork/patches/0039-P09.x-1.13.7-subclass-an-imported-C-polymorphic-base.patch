+/// The virtual-method NAMES carried by an imported C++ base's
+/// `#[rustc_cxx_imported_vtable = "…;slot=<name>,<sym>;…"]` attribute.
+/// Used by the `override` verify-override check so `override fn m` is
+/// accepted when an imported base declares a virtual `m`. Local to
+/// rustc_passes (no dep on rustc_symbol_mangling's parser).
+fn cxx_imported_slot_names(tcx: TyCtxt<'_>, adt_did: DefId) -> Vec<String> {
+    let Some(spec) = find_attr!(tcx, adt_did, RustcCxxImportedVtable { spec, .. } => *spec) else {
+        return Vec::new();
+    };
+    let mut out = Vec::new();
+    for record in spec.as_str().split(';') {
+        if let Some(rest) = record.trim().strip_prefix("slot=")
+            && let Some(name) = rest.split(',').next()
+        {
+            let name = name.trim();
+            if !name.is_empty() {
+                out.push(name.to_string());
+            }
+        }
+    }
+    out
+}
