+/// P09.x (1.13.7): one slot in a class's primary vtable, in C++
+/// declaration order. Either a Rust method (referenced by `DefId`;
+/// codegen takes its address with `get_fn_addr`) or an *imported* C++
+/// base's slot (referenced by its mangled symbol; codegen declares it
+/// external and takes its address — a direct, zero-indirection call to
+/// the real C++ implementation). The `name` drives override-matching:
+/// a derived Rust `#[cpp_virtual]` method whose name equals a slot's
+/// name REPLACES that slot (C++ override semantics).
+#[derive(Clone, Debug)]
+pub enum CxxVtSlot {
+    Rust { name: rustc_span::Symbol, def_id: DefId },
+    Imported { name: rustc_span::Symbol, link_name: rustc_span::Symbol },
+}
+
+impl CxxVtSlot {
+    pub fn name(&self) -> rustc_span::Symbol {
+        match self {
+            CxxVtSlot::Rust { name, .. } | CxxVtSlot::Imported { name, .. } => *name,
+        }
+    }
+}
+
+/// The raw `#[rustc_cxx_imported_vtable = "<spec>"]` string on `adt_did`,
+/// if it is an imported C++ polymorphic base.
+fn imported_vtable_spec<'tcx>(tcx: TyCtxt<'tcx>, adt_did: DefId) -> Option<rustc_span::Symbol> {
+    rustc_hir::find_attr!(tcx, adt_did, RustcCxxImportedVtable { spec, .. } => *spec)
+}
+
+/// Parse the `slot=<name>,<symbol>` records of an imported-vtable spec
+/// into ordered `CxxVtSlot::Imported` entries. Pure-virtual slots carry
+/// `__cxa_pure_virtual` as their symbol. The `zti=`/`ztv=` records are
+/// consumed elsewhere ([`imported_base_zti`]).
+fn parse_imported_slots(spec: rustc_span::Symbol) -> Vec<CxxVtSlot> {
+    let mut out = Vec::new();
+    for record in spec.as_str().split(';') {
+        if let Some(rest) = record.trim().strip_prefix("slot=") {
+            let mut parts = rest.splitn(2, ',');
+            let name = parts.next().unwrap_or("").trim();
+            let symbol = parts.next().unwrap_or("").trim();
+            if name.is_empty() || symbol.is_empty() {
+                continue;
+            }
+            out.push(CxxVtSlot::Imported {
+                name: rustc_span::Symbol::intern(name),
+                link_name: rustc_span::Symbol::intern(symbol),
+            });
+        }
+    }
+    out
+}
+
+/// The imported base's `_ZTI` (typeinfo) symbol from its
+/// `#[rustc_cxx_imported_vtable]` `zti=` record, if present. Used by the
+/// derived class's `__si_class_type_info` chain so the RTTI link matches
+/// the symbol clang actually emits for the C++ base (robust to
+/// namespaces, where name-based mangling could diverge).
+/// True if `adt_did` is an imported C++ polymorphic base (carries
+/// `#[rustc_cxx_imported_vtable]`). Such a class's `_ZTV`/`_ZTI`/`_ZTS`
+/// are owned by the C++ translation unit — codegen must not emit them.
+pub fn is_imported_cpp_base<'tcx>(tcx: TyCtxt<'tcx>, adt_did: DefId) -> bool {
+    imported_vtable_spec(tcx, adt_did).is_some()
+}
+
+pub fn imported_base_zti<'tcx>(tcx: TyCtxt<'tcx>, adt_did: DefId) -> Option<rustc_span::Symbol> {
+    let spec = imported_vtable_spec(tcx, adt_did)?;
+    for record in spec.as_str().split(';') {
+        if let Some(rest) = record.trim().strip_prefix("zti=") {
+            let zti = rest.trim();
+            if !zti.is_empty() {
+                return Some(rustc_span::Symbol::intern(zti));
+            }
+        }
+    }
+    None
+}
