diff --git a/compiler/rustc_symbol_mangling/src/itanium.rs b/compiler/rustc_symbol_mangling/src/itanium.rs
--- a/compiler/rustc_symbol_mangling/src/itanium.rs
+++ b/compiler/rustc_symbol_mangling/src/itanium.rs
@@ -247,6 +247,14 @@
     if cxx_impl_class(tcx, def_id).is_some() {
         if rustc_hir::find_attr!(tcx, def_id, RustcCxxWrapper(..)) {
             return false;
         }
+        // P09.23: `#[rustc_cxx_drop_wrapper]` opts a `Drop::drop`
+        // on `#[repr(cpp)]` out of the Itanium mangler. Used by
+        // `cxx_class_native!` when the C++ side already defines
+        // the destructor (D0/D1/D2) and the Rust drop body is a
+        // thin forwarder to an `extern "C++"` decl.
+        if rustc_hir::find_attr!(tcx, def_id, RustcCxxDropWrapper(..)) {
+            return false;
+        }
         return true;
     }

diff --git a/compiler/rustc_codegen_ssa/src/codegen_attrs.rs b/compiler/rustc_codegen_ssa/src/codegen_attrs.rs
--- a/compiler/rustc_codegen_ssa/src/codegen_attrs.rs
+++ b/compiler/rustc_codegen_ssa/src/codegen_attrs.rs
@@ -371,11 +371,17 @@
     // P09.22: `#[rustc_cxx_wrapper]` opts out. Used by wrapper
     // methods that forward to an `extern "C++"` decl under the
     // same Itanium name — auto-exporting them would produce a
     // self-recursive symbol.
+    //
+    // P09.23: `#[rustc_cxx_drop_wrapper]` is the trait-impl
+    // analogue — opts a `Drop::drop` out of auto-export so the
+    // Rust body can forward to a C++-side destructor without the
+    // D1 symbol colliding at link time.
     if tcx.def_kind(did) == DefKind::AssocFn
         && let Some(impl_did) = tcx.opt_parent(did.to_def_id())
         && matches!(tcx.def_kind(impl_did), DefKind::Impl { .. })
         && let ty::Adt(adt_def, _) = tcx.type_of(impl_did).skip_binder().kind()
         && adt_def.repr().cpp()
         && !rustc_hir::find_attr!(tcx, did.to_def_id(), RustcCxxWrapper(..))
+        && !rustc_hir::find_attr!(tcx, did.to_def_id(), RustcCxxDropWrapper(..))
     {
         codegen_fn_attrs.flags |= CodegenFnAttrFlags::NO_MANGLE;
     }

diff --git a/compiler/rustc_codegen_llvm/src/mono_item.rs b/compiler/rustc_codegen_llvm/src/mono_item.rs
--- a/compiler/rustc_codegen_llvm/src/mono_item.rs
+++ b/compiler/rustc_codegen_llvm/src/mono_item.rs
@@ -186,6 +186,14 @@
         let def_id = instance.def_id();
         if !rustc_symbol_mangling::itanium::is_cxx_drop_impl(self.tcx, def_id) {
             return;
         }
+        // P09.23: `#[rustc_cxx_drop_wrapper]` opts out of D0/D2
+        // trampoline emission. Used when the C++ side already
+        // defines the destructor and Rust's Drop body is just a
+        // forwarder — emitting trampolines would produce
+        // duplicate-symbol link errors against the C++ side.
+        if rustc_hir::find_attr!(self.tcx, def_id, RustcCxxDropWrapper(..)) {
+            return;
+        }

diff --git a/rustcc/crates/rustcc_macros/src/lib.rs b/rustcc/crates/rustcc_macros/src/lib.rs
--- a/rustcc/crates/rustcc_macros/src/lib.rs
+++ b/rustcc/crates/rustcc_macros/src/lib.rs
@@ -802,20 +802,34 @@
-    // Drop: the native macro does NOT auto-generate `impl Drop`.
-    // (old deferred-Drop block; see comment in P09.22)
-    let drop_impl = quote! {};
+    // P09.23: auto-generate `impl Drop` that forwards to the C++
+    // destructor via an `extern "C++"` decl. `#[rustc_cxx_drop_wrapper]`
+    // on `drop` opts the method out of P09.15's D0/D1/D2 auto-export,
+    // so the C++ side's destructor (compiled by Clang) is the sole
+    // definer of those symbols and there's no link-time collision.
+    let drop_impl = if let Some(dtor_fn) = dtor_extern_name.clone() {
+        quote! {
+            impl Drop for #name {
+                #[rustc_cxx_drop_wrapper]
+                fn drop(&mut self) {
+                    unsafe { #dtor_fn(self as *mut #name); }
+                }
+            }
+        }
+    } else if !has_explicit_dtor {
+        let auto_dtor_ident = format_ident!("__{}__drop", class_name_str);
+        let auto_dtor_link = format!("_ZN{}{}D1Ev", class_name_str.len(), class_name_str);
+        extern_items.push(quote! {
+            #[link_name = #auto_dtor_link]
+            fn #auto_dtor_ident(this: *mut #name);
+        });
+        quote! {
+            impl Drop for #name {
+                #[rustc_cxx_drop_wrapper]
+                fn drop(&mut self) {
+                    unsafe { #auto_dtor_ident(self as *mut #name); }
+                }
+            }
+        }
+    } else {
+        quote! {}
+    };
