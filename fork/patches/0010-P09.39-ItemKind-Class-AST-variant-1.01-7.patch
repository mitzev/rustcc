+    /// P09.39: lower the synthetic inherent `impl` half of a `class`
+    /// item. The struct half is produced via the normal `lower_item`
+    /// → `lower_item_kind` path under `item.id`; this function runs
+    /// under `class.impl_id` and emits `hir::ItemKind::Impl` with
+    /// `self_ty` lowered from the parser-built `class.self_ty`.
+    pub(super) fn lower_class_impl_half(
+        &mut self,
+        i: &Item,
+        class: &ast::Class,
+    ) -> &'hir hir::Item<'hir> {
+        let vis_span = self.lower_span(i.vis.span);
+        let hir_id = hir::HirId::make_owner(self.current_hir_id_owner.def_id);
+        // The impl half carries no user-written attributes;
+        // `#[repr(cpp)]` and other class-level attrs belong on the
+        // struct half.
+        let _ = self.lower_attrs_with_extra(
+            hir_id,
+            &[],
+            i.span,
+            Target::Impl { of_trait: false },
+            &[],
+        );
+
+        let impl_span = self.lower_span(i.span);
+        let (generics, (self_ty, items)) = self.lower_generics(
+            &class.generics,
+            class.impl_id,
+            ImplTraitContext::Universal,
+            |this| {
+                let self_ty = this.lower_ty_alloc(
+                    &class.self_ty,
+                    ImplTraitContext::Disallowed(ImplTraitPosition::ImplSelf),
+                );
+                let items = this.arena.alloc_from_iter(
+                    class.methods.iter().map(|m| this.lower_impl_item_ref(m)),
+                );
+                (self_ty, items)
+            },
+        );
+
+        let kind = hir::ItemKind::Impl(hir::Impl {
+            generics,
+            of_trait: None,
+            self_ty,
+            items,
+            constness: hir::Constness::NotConst,
+        });
+        let item = hir::Item {
+            owner_id: hir_id.expect_owner(),
+            kind,
+            vis_span,
+            span: impl_span,
+            has_delayed_lints: !self.delayed_lints.is_empty(),
+            eii: false,
+        };
+        self.arena.alloc(item)
+    }
+
     fn lower_item(&mut self, i: &Item) -> &'hir hir::Item<'hir> {
         let vis_span = self.lower_span(i.vis.span);
         let hir_id = hir::HirId::make_owner(self.current_hir_id_owner.def_id);
