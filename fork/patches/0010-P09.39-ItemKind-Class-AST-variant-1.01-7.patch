+/// P09.39 (1.01 #7): body of a fork-only `class` item. Survives
+/// through AST-level passes (expansion, name resolution,
+/// ast_validation) and is lowered to a `#[repr(cpp)]` struct plus
+/// an inherent `impl` block during AST → HIR lowering. See the
+/// `ItemKind::Class` docs and `rustc_ast_lowering`.
+#[derive(Clone, Encodable, Decodable, Debug)]
+pub struct Class {
+    pub ident: Ident,
+    pub generics: Generics,
+    /// Fields in declaration order. For `class Derived : Base { ... }`,
+    /// the parser synthesizes a leading `#[rustc_cxx_base] __base: Base`
+    /// field so downstream layout/vtable paths can detect the
+    /// polymorphic base by attribute — no separate base pointer on
+    /// `Class` is needed.
+    pub fields: ThinVec<FieldDef>,
+    pub methods: ThinVec<Box<AssocItem>>,
+    /// NodeId reserved for the synthetic inherent `impl` block that
+    /// AST lowering produces from this class's methods. Allocated by
+    /// the parser so def_collector / HIR lowering agree on the DefId
+    /// for the impl. The struct's NodeId is the enclosing
+    /// `Item<ItemKind>::id`.
+    pub impl_id: NodeId,
+    /// Self-type for the synthetic inherent impl: a path `ClassIdent`
+    /// or `ClassIdent<Args>` matching `generics`. Built at parse time
+    /// and lowered via `lower_ty` in ast_lowering. Storing it as a
+    /// full AST `Ty` lets name resolution wire it to the struct half
+    /// like any other type reference.
+    pub self_ty: Box<Ty>,
+}
+
