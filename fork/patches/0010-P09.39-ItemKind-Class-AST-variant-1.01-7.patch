+        // P09.39: `Class` walks like a struct body plus an inherent
+        // impl body — fields are visited as struct fields (via
+        // `visit_field_def`), methods are visited as assoc items
+        // with `AssocCtxt::Impl { of_trait: false }` context so
+        // resolve/expand treat them identically to methods inside
+        // a normal `impl Name { ... }` block.
+        impl_walkable!(|&$($mut)? $($lt)? self: Class, vis: &mut V| {
+            // Walk `impl_id` through `visit_visitable!` so the
+            // MutVisitor in `rustc_expand::expand` replaces the
+            // parser's `DUMMY_NODE_ID` with a fresh `NodeId`. If
