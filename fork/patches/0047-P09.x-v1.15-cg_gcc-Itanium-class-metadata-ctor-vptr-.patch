@@ -0,0 +1,397 @@
+//! P09.x (v1.15) — Itanium vtable / typeinfo / typeinfo-name emission
+//! for `#[repr(cpp)]` classes on the GCC backend. Port of the LLVM
+//! backend's `cxx_vtable.rs` (Itanium half only — GCC never targets
+//! the MSVC C++ ABI).
+//!
+//! Differences from the LLVM port, driven by libgccjit's API:
+//!
+//! - **Vague linkage**: gccjit globals are only
+//!   exported/internal/imported — there is no `linkonce_odr` + comdat.
+//!   On ELF targets we emit the global `Exported` and append a
+//!   top-level `.weak <sym>` asm directive, which gas applies to the
+//!   definition regardless of relative position. (Mach-O/COFF would
+//!   need `.weak_definition`/selectany — out of scope; the GCC
+//!   backend phase targets Linux.)
+//! - **Constant address points** (`&_ZTV[2]`, RTTI vtable + 2 slots)
+//!   are formed with `new_array_access(..).get_address(..)` — a
+//!   constant expression gccjit accepts in initializers (the same
+//!   trick `const_ptr_byte_offset` uses).
+//! - The deleting-destructor thunk is an ordinary gccjit function
+//!   (two calls + ret), not LLVM IR.
+
+use gccjit::{FunctionType, GlobalKind, RValue, ToRValue, Type};
+use rustc_codegen_ssa::traits::*;
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::DefId;
+use rustc_middle::bug;
+use rustc_middle::ty::{self, Instance, Ty, TyCtxt};
+use rustc_symbol_mangling::itanium as cxx_mangle;
+
+use crate::builder::Builder;
+use crate::context::CodegenCx;
+
+/// Store the Itanium vtable address point (`&_ZTV<class>[2]`) into
+/// offset 0 of `ret_place_ptr` if `instance` is a `#[rustc_cxx_ctor]`
+/// on a polymorphic `#[repr(cpp)]` class. Mirrors the LLVM backend's
+/// `maybe_emit_vptr_init`; invoked from the shared SSA trait hook.
+pub fn maybe_emit_vptr_init<'a, 'gcc, 'tcx>(
+    bx: &mut Builder<'a, 'gcc, 'tcx>,
+    instance: Instance<'tcx>,
+    ret_place_ptr: RValue<'gcc>,
+) {
+    let tcx = bx.tcx;
+    let def_id = instance.def_id();
+    if !cxx_mangle::has_cxx_ctor_attr(tcx, def_id) {
+        return;
+    }
+    let Some(adt_did) = cpp_class_of_method(tcx, def_id) else {
+        return;
+    };
+    if !cxx_mangle::is_polymorphic_cpp_class(tcx, adt_did) {
+        return;
+    }
+
+    let vtable_sym = cxx_mangle::mangle_cxx_vtable_symbol(tcx, adt_did);
+    let i8p_ty = bx.cx.type_i8().make_pointer();
+    // If this CGU defined the vtable (metadata flush ran before the
+    // define loop) reuse it via the globals map; otherwise reference
+    // the other-CGU/-crate definition as a pure import. Never let
+    // this create an Exported placeholder — that would be a
+    // tentative definition clashing with the real weak one.
+    let vtable_base = if bx.cx.globals.borrow().contains_key(vtable_sym.as_str()) {
+        bx.cx
+            .get_or_insert_global(&vtable_sym, bx.cx.type_i8(), false, None)
+            .get_address(None)
+    } else {
+        bx.cx
+            .context
+            .new_global(None, gccjit::GlobalKind::Imported, bx.cx.type_i8(), &vtable_sym)
+            .get_address(None)
+    };
+
+    // Address point = base + 2 pointer-sized header slots
+    // (offset-to-top, RTTI). Byte-granular: the base must be
+    // `u8*`-typed — `const_ptr_byte_offset`'s array-access trick
+    // would step struct-sized strides on the defined (struct-typed)
+    // global, and ICEs on `void*` (incomplete element type).
+    let vtable_base_i8 = bx.cx.context.new_cast(None, vtable_base, i8p_ty);
+    let ptr_bytes = tcx.data_layout.pointer_size().bytes();
+    let addr_point = bx.cx.const_ptr_byte_offset(
+        vtable_base_i8,
+        rustc_abi::Size::from_bytes(2 * ptr_bytes),
+    );
+
+    // *(<ptr>*)ret_place_ptr = addr_point — offset 0 is the vptr slot
+    // reserved by the polymorphic layout path.
+    let ptr_align = tcx.data_layout.pointer_align().abi;
+    let dst = bx.cx.context.new_cast(None, ret_place_ptr, i8p_ty.make_pointer());
+    bx.store(addr_point, dst.to_rvalue(), ptr_align);
+}
+
+/// If `def_id` is an associated fn on a polymorphic `#[repr(cpp)]`
+/// class, queue the class for metadata emission. Trigger:
+/// `predefine_fn` — but unlike the LLVM backend the emission itself is
+/// DEFERRED to `emit_pending_class_metadata` (after the predefine
+/// loop): emitting eagerly would `get_fn_addr` methods that haven't
+/// been predefined yet, creating *imported* gccjit functions that can
+/// never be upgraded to definitions ("cannot add block to an imported
+/// function").
+pub fn queue_class_metadata<'gcc, 'tcx>(cx: &CodegenCx<'gcc, 'tcx>, def_id: DefId) {
+    let Some(adt_did) = cpp_class_of_method(cx.tcx, def_id) else {
+        return;
+    };
+    if !cxx_mangle::is_polymorphic_cpp_class(cx.tcx, adt_did) {
+        return;
+    }
+    // Imported C++ bases own their own metadata symbols.
+    if cxx_mangle::is_imported_cpp_base(cx.tcx, adt_did) {
+        return;
+    }
+    cx.cxx_emitted_vtables.borrow_mut().insert(adt_did);
+}
+
+/// Emit `_ZTV`/`_ZTI`/`_ZTS` for every queued class. Called once per
+/// CGU after the predefine loop — every local method then has a
+/// definable gccjit Function, and the vtable globals exist before any
+/// ctor body (define loop) references them for the vptr store.
+pub fn emit_pending_class_metadata<'gcc, 'tcx>(cx: &CodegenCx<'gcc, 'tcx>) {
+    let mut pending: Vec<DefId> = cx.cxx_emitted_vtables.borrow().iter().copied().collect();
+    // Deterministic emission order.
+    pending.sort_by_key(|d| (d.krate, d.index));
+    for adt_did in pending {
+        emit_class_metadata(cx, adt_did);
+    }
+}
+
+fn cpp_class_of_method<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> Option<DefId> {
+    if tcx.def_kind(def_id) != DefKind::AssocFn {
+        return None;
+    }
+    let impl_did = tcx.opt_parent(def_id)?;
+    if !matches!(tcx.def_kind(impl_did), DefKind::Impl { .. }) {
+        return None;
+    }
+    let self_ty = tcx.type_of(impl_did).skip_binder();
+    let ty::Adt(adt_def, _) = self_ty.kind() else {
+        return None;
+    };
+    if !adt_def.repr().cpp() {
+        return None;
+    }
+    Some(adt_def.did())
+}
+
+fn emit_class_metadata<'gcc, 'tcx>(cx: &CodegenCx<'gcc, 'tcx>, adt_did: DefId) {
+    let tcx = cx.tcx;
+    let class_name = tcx.item_name(adt_did).to_string();
+    let class_name_mangled = format!("{}{}", class_name.len(), class_name);
+
+    let vtable_sym = cxx_mangle::mangle_cxx_vtable_symbol(tcx, adt_did);
+    let typeinfo_sym = cxx_mangle::mangle_cxx_typeinfo_symbol(tcx, adt_did);
+    let typeinfo_name_sym = cxx_mangle::mangle_cxx_typeinfo_name_symbol(tcx, adt_did);
+
+    let typeinfo_name_gv = emit_typeinfo_name(cx, &typeinfo_name_sym, &class_name_mangled);
+    let typeinfo_gv = emit_typeinfo(cx, tcx, adt_did, &typeinfo_sym, typeinfo_name_gv);
+    emit_vtable(cx, adt_did, &vtable_sym, typeinfo_gv);
+}
+
+/// Define a constant global named `symbol` with `initializer`, weak on
+/// ELF (see module docs). Returns its address as an opaque-ptr rvalue.
+fn define_weak_const_global<'gcc, 'tcx>(
+    cx: &CodegenCx<'gcc, 'tcx>,
+    symbol: &str,
+    initializer: RValue<'gcc>,
+) -> RValue<'gcc> {
+    if cx.globals.borrow().contains_key(symbol) {
+        bug!("cxx_vtable(gcc): symbol `{symbol}` already defined");
+    }
+    let ty: Type<'gcc> = initializer.get_type();
+    let global = cx.declare_global(symbol, ty, GlobalKind::Exported, false, None);
+    global.global_set_initializer_rvalue(initializer);
+    mark_weak(cx, symbol);
+    global.get_address(None)
+}
+
+fn mark_weak<'gcc, 'tcx>(cx: &CodegenCx<'gcc, 'tcx>, symbol: &str) {
+    let target = &cx.tcx.sess.target;
+    if !target.is_like_darwin && !target.is_like_windows {
+        cx.context.add_top_level_asm(None, &format!(".weak {symbol}"));
+    }
+}
+
+fn emit_typeinfo_name<'gcc, 'tcx>(
+    cx: &CodegenCx<'gcc, 'tcx>,
+    symbol: &str,
+    mangled: &str,
+) -> RValue<'gcc> {
+    let bytes_with_nul: Vec<u8> =
+        mangled.as_bytes().iter().copied().chain(std::iter::once(0u8)).collect();
+    let initializer = cx.const_bytes(&bytes_with_nul);
+    define_weak_const_global(cx, symbol, initializer)
+}
+
+fn emit_typeinfo<'gcc, 'tcx>(
+    cx: &CodegenCx<'gcc, 'tcx>,
+    tcx: TyCtxt<'tcx>,
+    adt_did: DefId,
+    symbol: &str,
+    typeinfo_name: RValue<'gcc>,
+) -> RValue<'gcc> {
+    let ptr_ty = cx.type_ptr();
+    let ptr_bytes = tcx.data_layout.pointer_size().bytes();
+
+    let base_did = cxx_mangle::polymorphic_base_of_class(tcx, adt_did);
+    let rtti_vtable_sym = if base_did.is_some() {
+        "_ZTVN10__cxxabiv120__si_class_type_infoE"
+    } else {
+        "_ZTVN10__cxxabiv117__class_type_infoE"
+    };
+    // Declared `u8`-typed so the byte-offset array-access below is
+    // byte-granular and constant-foldable (`void*` would ICE on the
+    // incomplete element type; libc++abi owns the real definition).
+    let rtti_vtable_base = if cx.globals.borrow().contains_key(rtti_vtable_sym) {
+        cx.get_or_insert_global(rtti_vtable_sym, cx.type_i8(), false, None).get_address(None)
+    } else {
+        cx.context
+            .new_global(None, GlobalKind::Imported, cx.type_i8(), rtti_vtable_sym)
+            .get_address(None)
+    };
+    let rtti_vtable_addr_point = cx.const_ptr_byte_offset(
+        rtti_vtable_base,
+        rustc_abi::Size::from_bytes(2 * ptr_bytes),
+    );
+
+    let initializer = if let Some(base_did) = base_did {
+        let base_typeinfo_ref = if let Some(zti) = cxx_mangle::imported_base_zti(tcx, base_did) {
+            cx.get_or_insert_global(zti.as_str(), ptr_ty, false, None).get_address(None)
+        } else if cxx_mangle::is_polymorphic_cpp_class(tcx, base_did) {
+            let base_typeinfo_sym = cxx_mangle::mangle_cxx_typeinfo_symbol(tcx, base_did);
+            cx.get_or_insert_global(&base_typeinfo_sym, ptr_ty, false, None).get_address(None)
+        } else {
+            ensure_nonpoly_base_typeinfo(cx, tcx, base_did)
+        };
+        cx.const_struct(&[rtti_vtable_addr_point, typeinfo_name, base_typeinfo_ref], false)
+    } else {
+        cx.const_struct(&[rtti_vtable_addr_point, typeinfo_name], false)
+    };
+
+    define_weak_const_global(cx, symbol, initializer)
+}
+
+fn ensure_nonpoly_base_typeinfo<'gcc, 'tcx>(
+    cx: &CodegenCx<'gcc, 'tcx>,
+    tcx: TyCtxt<'tcx>,
+    adt_did: DefId,
+) -> RValue<'gcc> {
+    let typeinfo_sym = cxx_mangle::mangle_cxx_typeinfo_symbol(tcx, adt_did);
+    if cx.globals.borrow().contains_key(typeinfo_sym.as_str()) {
+        return cx
+            .get_or_insert_global(&typeinfo_sym, cx.type_ptr(), false, None)
+            .get_address(None);
+    }
+    let class_name = tcx.item_name(adt_did).to_string();
+    let class_name_mangled = format!("{}{}", class_name.len(), class_name);
+    let typeinfo_name_sym = cxx_mangle::mangle_cxx_typeinfo_name_symbol(tcx, adt_did);
+    let typeinfo_name_gv = if cx.globals.borrow().contains_key(typeinfo_name_sym.as_str()) {
+        cx.get_or_insert_global(&typeinfo_name_sym, cx.type_ptr(), false, None).get_address(None)
+    } else {
+        emit_typeinfo_name(cx, &typeinfo_name_sym, &class_name_mangled)
+    };
+    emit_typeinfo(cx, tcx, adt_did, &typeinfo_sym, typeinfo_name_gv)
+}
+
+fn emit_vtable<'gcc, 'tcx>(
+    cx: &CodegenCx<'gcc, 'tcx>,
+    adt_did: DefId,
+    symbol: &str,
+    typeinfo: RValue<'gcc>,
+) {
+    let tcx = cx.tcx;
+    let isize_ty = cx.type_isize();
+
+    // Slot 0: offset-to-top (zero for the primary table, stored
+    // pointer-sized). Slot 1: RTTI pointer. Slots 2+: fn pointers.
+    let offset_to_top = cx.const_int(isize_ty, 0);
+
+    let mut slots: Vec<RValue<'gcc>> = Vec::new();
+    slots.push(offset_to_top);
+    slots.push(typeinfo);
+
+    let virtuals = cxx_mangle::virtuals_on_chain(tcx, adt_did);
+    let has_positional_dtor =
+        virtuals.iter().any(|s| matches!(s, cxx_mangle::CxxVtSlot::ImportedDtorPair));
+    if !has_positional_dtor {
+        for dtor_slot in cxx_dtor_slots(cx, adt_did) {
+            slots.push(dtor_slot);
+        }
+    }
+    let mut dtor_pair_emitted = false;
+    for slot in &virtuals {
+        match slot {
+            cxx_mangle::CxxVtSlot::ImportedDtorPair => {
+                if !dtor_pair_emitted {
+                    for dtor_slot in cxx_dtor_slots(cx, adt_did) {
+                        slots.push(dtor_slot);
+                    }
+                    dtor_pair_emitted = true;
+                }
+            }
+            _ => slots.push(cxx_vt_slot_fn_addr(cx, slot)),
+        }
+    }
+
+    let initializer = cx.const_struct(&slots, false);
+    define_weak_const_global(cx, symbol, initializer);
+}
+
+fn cxx_vt_slot_fn_addr<'gcc, 'tcx>(
+    cx: &CodegenCx<'gcc, 'tcx>,
+    slot: &cxx_mangle::CxxVtSlot,
+) -> RValue<'gcc> {
+    match slot {
+        cxx_mangle::CxxVtSlot::Rust { def_id, .. } => {
+            cx.get_fn_addr(Instance::mono(cx.tcx, *def_id))
+        }
+        cxx_mangle::CxxVtSlot::Imported { link_name, .. } => {
+            declare_extern_fn_addr(cx, link_name.as_str())
+        }
+        cxx_mangle::CxxVtSlot::ImportedDtorPair => {
+            bug!("ImportedDtorPair must be expanded by the caller")
+        }
+    }
+}
+
+/// The address of an external function symbol, declared `void()` if
+/// not already known. Only the address matters for a vtable slot.
+fn declare_extern_fn_addr<'gcc, 'tcx>(cx: &CodegenCx<'gcc, 'tcx>, symbol: &str) -> RValue<'gcc> {
+    let func = *cx.functions.borrow_mut().entry(symbol.to_string()).or_insert_with(|| {
+        cx.context.new_function(None, FunctionType::Extern, cx.type_void(), &[], symbol, false)
+    });
+    func.get_address(None)
+}
+
+/// Itanium leading/positional dtor pair: `[D1, D0]` — the complete
+/// (`drop_in_place::<D>`) then deleting (drop + `operator delete`)
+/// destructors of the most-derived class. Empty when the chain has no
+/// virtual destructor.
+fn cxx_dtor_slots<'gcc, 'tcx>(cx: &CodegenCx<'gcc, 'tcx>, adt_did: DefId) -> Vec<RValue<'gcc>> {
+    if !cxx_mangle::chain_has_virtual_dtor(cx.tcx, adt_did) {
+        return Vec::new();
+    }
+    let ty = Ty::new_adt(cx.tcx, cx.tcx.adt_def(adt_did), cx.tcx.mk_args(&[]));
+    let drop_instance = Instance::resolve_drop_in_place(cx.tcx, ty);
+
+    let d1 = cx.get_fn_addr(drop_instance);
+    let d0 = emit_cxx_deleting_dtor_thunk(cx, adt_did, drop_instance);
+    vec![d1, d0]
+}
+
+/// `void(this)`: `drop_in_place::<D>(this); operator delete(this)`.
+fn emit_cxx_deleting_dtor_thunk<'gcc, 'tcx>(
+    cx: &CodegenCx<'gcc, 'tcx>,
+    adt_did: DefId,
+    drop_instance: Instance<'tcx>,
+) -> RValue<'gcc> {
+    let name = format!(
+        "__rustcc_cxx_delete${}",
+        cxx_mangle::mangle_cxx_vtable_symbol(cx.tcx, adt_did)
+    );
+    if let Some(func) = cx.functions.borrow().get(&name) {
+        return func.get_address(None);
+    }
+
+    let void_ty = cx.type_void();
+    let ptr_ty = cx.type_ptr();
+    let this_param = cx.context.new_parameter(None, ptr_ty, "this");
+    let thunk = cx.context.new_function(
+        None,
+        FunctionType::Exported,
+        void_ty,
+        &[this_param],
+        &name,
+        false,
+    );
+    cx.functions.borrow_mut().insert(name.clone(), thunk);
+    mark_weak(cx, &name);
+
+    let block = thunk.new_block("start");
+    let this = thunk.get_param(0).to_rvalue();
+
+    // drop_in_place::<D>(this) — direct call to the monomorphized
+    // drop glue (its ABI is `void(*mut D)`; the opaque `this` pointer
+    // is cast to the parameter type gccjit expects).
+    let drop_fn = cx.get_fn(drop_instance);
+    let drop_param_ty = drop_fn.get_param(0).to_rvalue().get_type();
+    let this_cast = cx.context.new_cast(None, this, drop_param_ty);
+    block.add_eval(None, cx.context.new_call(None, drop_fn, &[this_cast]));
+
+    // operator delete(this) — Itanium `_ZdlPv`.
+    let op_delete = *cx.functions.borrow_mut().entry("_ZdlPv".to_string()).or_insert_with(|| {
+        let p = cx.context.new_parameter(None, ptr_ty, "p");
+        cx.context.new_function(None, FunctionType::Extern, void_ty, &[p], "_ZdlPv", false)
+    });
+    block.add_eval(None, cx.context.new_call(None, op_delete, &[this]));
+
+    block.end_with_void_return(None);
+    thunk.get_address(None)
+}
