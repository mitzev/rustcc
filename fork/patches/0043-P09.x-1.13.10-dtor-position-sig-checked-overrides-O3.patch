diff --git a/compiler/rustc_symbol_mangling/src/itanium.rs b/compiler/rustc_symbol_mangling/src/itanium.rs
index fa56e8ab730..720753058be 100644
--- a/compiler/rustc_symbol_mangling/src/itanium.rs
+++ b/compiler/rustc_symbol_mangling/src/itanium.rs
@@ -274,13 +274,32 @@ pub fn is_polymorphic_cpp_class<'tcx>(tcx: TyCtxt<'tcx>, adt_did: DefId) -> bool
 #[derive(Clone, Debug)]
 pub enum CxxVtSlot {
     Rust { name: rustc_span::Symbol, def_id: DefId },
-    Imported { name: rustc_span::Symbol, link_name: rustc_span::Symbol },
+    Imported {
+        name: rustc_span::Symbol,
+        link_name: rustc_span::Symbol,
+        /// v1.13.10: the slot's Itanium bare parameter encoding at its
+        /// declaring class (third `slot=` field). Lets override
+        /// matching disambiguate overloaded names and reject
+        /// signature mismatches. `None` on legacy attrs.
+        psig: Option<rustc_span::Symbol>,
+    },
+    /// v1.13.10: positional `slot=~dtor,~` marker — the D1/D0 destructor
+    /// pair sits at the destructor's DECLARATION position (Itanium
+    /// §2.5.2), not necessarily first. Codegen expands this to the
+    /// derived class's own complete/deleting dtor slots. Legacy attrs
+    /// (`vdtor=1` with no marker) keep the old prepend semantics, which
+    /// were correct exactly when the dtor was declared first.
+    ImportedDtorPair,
 }
 
 impl CxxVtSlot {
     pub fn name(&self) -> rustc_span::Symbol {
         match self {
             CxxVtSlot::Rust { name, .. } | CxxVtSlot::Imported { name, .. } => *name,
+            // `~` can't appear in a Rust identifier, so this can never
+            // collide with (or be replaced by) a real override.
+            #[allow(rustc::symbol_intern_string_literal)]
+            CxxVtSlot::ImportedDtorPair => rustc_span::Symbol::intern("~dtor"),
         }
     }
