+/// v1.13.10: the Itanium bare parameter encoding of a Rust
+/// `#[cpp_virtual]` method's signature (self skipped) — comparable
+/// against the third `slot=` field of `#[rustc_cxx_imported_vtable]`.
+/// `None` when a parameter type has no C++ lowering (diagnosed by the
+/// regular method-mangling path).
+fn cxx_override_param_sig<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> Option<String> {
+    let fn_sig = tcx.fn_sig(def_id).skip_binder().skip_binder();
+    let mut ctx = CxxTypeCtx::new(CxxTarget::from_rustc_triple(
+        tcx.sess.opts.target_triple.tuple(),
+        tcx.sess.target.pointer_width as u32,
+    ));
+    let has_self = tcx.def_kind(def_id) == DefKind::AssocFn
+        && tcx.associated_item(def_id).is_method();
+    let input_skip = if has_self { 1 } else { 0 };
+    let mut params = Vec::new();
+    for ty in fn_sig.inputs().iter().skip(input_skip) {
+        params.push(rustc_ty_to_cxx(tcx, &mut ctx, *ty).ok()?);
+    }
+    let void = ctx.intern_type(CxxType::Void);
+    let sig = CxxFnSig {
+        params,
+        ret: void,
+        cv: CvQual::default(),
+        ref_q: None,
+        variadic: false,
+        noexcept: false,
+    };
+    Some(ctx.mangle_itanium_params(&sig))
+}
