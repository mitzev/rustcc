+    /// P09.x (1.13.6): build the synthetic `impl Deref for D` +
+    /// `impl DerefMut for D` items for `class D : B { ... }`. These give
+    /// transparent base-member access: `self.member` reaches `B`'s
+    /// fields/methods through Rust's existing autoderef (the `__base`
+    /// subobject sits at offset 0). Bodies are `&self.__base` /
+    /// `&mut self.__base`. Returned as ordinary AST `impl` items
+    /// (with `DUMMY_NODE_ID`s filled in by expansion) so they lower
+    /// through the normal impl path — no custom HIR synthesis needed.
+    fn build_cxx_class_deref_impls(
+        generics: &Generics,
+        self_ty: &Ty,
+        base_ty: &Ty,
+        span: Span,
+    ) -> ThinVec<Box<Item>> {
+        let inherited_vis = || Visibility {
+            kind: VisibilityKind::Inherited,
+            span: span.shrink_to_lo(),
+            tokens: None,
+        };
+        let empty_where = || WhereClause {
+            has_where_token: false,
+            predicates: ThinVec::new(),
+            span,
+        };
+        let empty_generics =
+            || Generics { params: ThinVec::new(), where_clause: empty_where(), span };
+        // `&[mut] self.__base`
+        let body_addr_of = |mutbl: Mutability| -> Box<Expr> {
+            let self_expr = Box::new(Expr {
+                id: DUMMY_NODE_ID,
+                kind: ExprKind::Path(None, ast::Path::from_ident(Ident::new(kw::SelfLower, span))),
+                span,
+                attrs: ThinVec::new(),
+                tokens: None,
+            });
+            let field_expr = Box::new(Expr {
+                id: DUMMY_NODE_ID,
+                kind: ExprKind::Field(self_expr, Ident::new(sym::__base, span)),
+                span,
+                attrs: ThinVec::new(),
+                tokens: None,
+            });
+            Box::new(Expr {
+                id: DUMMY_NODE_ID,
+                kind: ExprKind::AddrOf(BorrowKind::Ref, mutbl, field_expr),
+                span,
+                attrs: ThinVec::new(),
+                tokens: None,
+            })
+        };
+        // `fn <name>(&[mut] self) -> &[mut] Base { &[mut] self.__base }`
+        let mk_deref_fn = |name: Symbol, mutbl: Mutability| -> Box<AssocItem> {
+            let eself = respan(span, SelfKind::Region(None, mutbl));
+            let self_param =
+                Param::from_self(ThinVec::new(), eself, Ident::new(kw::SelfLower, span));
+            let ret_ty = Box::new(Ty {
+                id: DUMMY_NODE_ID,
+                kind: TyKind::Ref(None, MutTy { ty: Box::new(base_ty.clone()), mutbl }),
+                span,
+                tokens: None,
+            });
+            let block = Box::new(Block {
+                stmts: thin_vec![Stmt {
+                    id: DUMMY_NODE_ID,
+                    kind: StmtKind::Expr(body_addr_of(mutbl)),
+                    span,
+                }],
+                id: DUMMY_NODE_ID,
+                rules: BlockCheckMode::Default,
+                span,
+                tokens: None,
+            });
+            let func = Fn {
+                defaultness: Defaultness::Implicit,
+                ident: Ident::new(name, span),
+                generics: empty_generics(),
+                sig: FnSig {
+                    header: FnHeader {
+                        constness: Const::No,
+                        coroutine_kind: None,
+                        safety: Safety::Default,
+                        ext: Extern::None,
+                    },
+                    decl: Box::new(FnDecl {
+                        inputs: thin_vec![self_param],
+                        output: FnRetTy::Ty(ret_ty),
+                    }),
+                    span,
+                },
+                contract: None,
+                define_opaque: None,
+                body: Some(block),
+                eii_impls: ThinVec::new(),
+            };
+            Box::new(Item {
+                attrs: ThinVec::new(),
+                id: DUMMY_NODE_ID,
+                span,
+                vis: inherited_vis(),
+                kind: AssocItemKind::Fn(Box::new(func)),
+                tokens: None,
+            })
+        };
+        // Trait path `::core::ops::<trait>`.
+        let trait_path = |trait_sym: Symbol| -> ast::Path {
+            let segments = [kw::PathRoot, sym::core, sym::ops, trait_sym]
+                .into_iter()
+                .map(|s| ast::PathSegment {
+                    ident: Ident::new(s, span),
+                    id: DUMMY_NODE_ID,
+                    args: None,
+                })
+                .collect();
+            ast::Path { span, segments, tokens: None }
+        };
+        let mk_impl = |trait_sym: Symbol, items: ThinVec<Box<AssocItem>>| -> Box<Item> {
+            Box::new(Item {
+                attrs: ThinVec::new(),
+                id: DUMMY_NODE_ID,
+                span,
+                vis: inherited_vis(),
+                kind: ItemKind::Impl(Impl {
+                    generics: generics.clone(),
+                    constness: Const::No,
+                    of_trait: Some(Box::new(TraitImplHeader {
+                        defaultness: Defaultness::Implicit,
+                        safety: Safety::Default,
+                        polarity: ImplPolarity::Positive,
+                        trait_ref: TraitRef { path: trait_path(trait_sym), ref_id: DUMMY_NODE_ID },
+                    })),
+                    self_ty: Box::new(self_ty.clone()),
+                    items,
+                }),
+                tokens: None,
+            })
+        };
+        // `type Target = Base;`
+        let target_assoc = Box::new(Item {
+            attrs: ThinVec::new(),
+            id: DUMMY_NODE_ID,
+            span,
+            vis: inherited_vis(),
+            kind: AssocItemKind::Type(Box::new(TyAlias {
+                defaultness: Defaultness::Implicit,
+                ident: Ident::new(sym::Target, span),
+                generics: empty_generics(),
+                after_where_clause: empty_where(),
+                bounds: Vec::new(),
+                ty: Some(Box::new(base_ty.clone())),
+            })),
+            tokens: None,
+        });
+        let deref_impl =
+            mk_impl(sym::Deref, thin_vec![target_assoc, mk_deref_fn(sym::deref, Mutability::Not)]);
+        let deref_mut_impl =
+            mk_impl(sym::DerefMut, thin_vec![mk_deref_fn(sym::deref_mut, Mutability::Mut)]);
+        thin_vec![deref_impl, deref_mut_impl]
+    }
+
