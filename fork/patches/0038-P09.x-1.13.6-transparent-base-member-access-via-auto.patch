@@ -275,6 +288,33 @@ fn emit_typeinfo<'ll, 'tcx>(
     gv
 }
 
+/// P09.x (1.13.6): emit the `_ZTS` + `_ZTI` (typeinfo name + typeinfo)
+/// for a **non-polymorphic** base class. Such a base has no vtable, so
+/// its metadata pass (`emit_class_metadata`) never runs — yet a
+/// polymorphic derived class's `__si_class_type_info` references its
+/// `_ZTI`. Emit it here, idempotently (two derived classes may share a
+/// base in one CGU; LinkOnceODR + comdat dedups across CGUs). Recurses
+/// through `emit_typeinfo`, so a chain of non-polymorphic bases all get
+/// their typeinfos.
+fn ensure_nonpoly_base_typeinfo<'ll, 'tcx>(
+    cx: &CodegenCx<'ll, 'tcx>,
+    tcx: TyCtxt<'tcx>,
+    adt_did: DefId,
+) -> &'ll Value {
+    let typeinfo_sym = cxx_mangle::mangle_cxx_typeinfo_symbol(tcx, adt_did);
+    if let Some(existing) = cx.get_defined_value(&typeinfo_sym) {
+        return existing;
+    }
+    let class_name = tcx.item_name(adt_did).to_string();
+    let class_name_mangled = mangled_class_ident(&class_name);
+    let typeinfo_name_sym = cxx_mangle::mangle_cxx_typeinfo_name_symbol(tcx, adt_did);
+    let typeinfo_name_gv = match cx.get_defined_value(&typeinfo_name_sym) {
+        Some(v) => v,
+        None => emit_typeinfo_name(cx, &typeinfo_name_sym, &class_name_mangled),
+    };
+    emit_typeinfo(cx, tcx, adt_did, &typeinfo_sym, typeinfo_name_gv)
+}
