+        // P09.x (1.13.6): a derived class's `__si_class_type_info`
+        // points at the base's `_ZTI`. If the base is polymorphic it
+        // emits its own typeinfo (its metadata pass) — reference it.
+        // But a base may be *non-polymorphic* (no vtable of its own,
+        // e.g. a POD base under a class that adds the first virtual):
+        // nothing else emits its typeinfo, so emit it here (a
+        // `__class_type_info`), recursively up the chain. Without
+        // this, the link fails with "undefined symbol: typeinfo for
+        // Base".
+        let base_typeinfo_ref = if cxx_mangle::is_polymorphic_cpp_class(tcx, base_did) {
+            let base_typeinfo_sym = cxx_mangle::mangle_cxx_typeinfo_symbol(tcx, base_did);
+            cx.declare_global(&base_typeinfo_sym, ptr_ty)
+        } else {
