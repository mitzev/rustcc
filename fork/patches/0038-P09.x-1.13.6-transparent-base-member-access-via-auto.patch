--- a/compiler/rustc_symbol_mangling/src/itanium.rs
+++ b/compiler/rustc_symbol_mangling/src/itanium.rs
@@ -237,11 +237,23 @@ pub(crate) fn mangle_dtor_variant<'tcx>(
 /// declares any virtual methods OR inherits from a polymorphic
 /// class (single-inheritance chain, marked by
 /// `#[rustc_cxx_base]` on the first field).
+///
+/// P09.x (1.13.6): inheriting from a base only makes the derived
+/// class polymorphic if the base *chain* is itself polymorphic —
+/// i.e. some ancestor declares a virtual. A `#[rustc_cxx_base]`
+/// pointing at a non-polymorphic base (no vtable) does NOT make the
+/// derived class polymorphic. Walking the chain here keeps the
+/// vtable/typeinfo emitters from emitting a derived `_ZTI` that
+/// references a base typeinfo the base never emits (a link error:
+/// "undefined symbol: typeinfo for Base").
 pub fn is_polymorphic_cpp_class<'tcx>(tcx: TyCtxt<'tcx>, adt_did: DefId) -> bool {
     if !virtual_methods_on_class(tcx, adt_did).is_empty() {
         return true;
     }
-    polymorphic_base_of_class(tcx, adt_did).is_some()
+    match polymorphic_base_of_class(tcx, adt_did) {
+        Some(base_did) => is_polymorphic_cpp_class(tcx, base_did),
+        None => false,
+    }
 }
 
