+/// The address of an external function symbol, declared as an opaque
+/// `void()` if not already present. Used for imported C++ method
+/// targets and for derived-class destructor (`D1`/`D0`) symbols placed
+/// in vtable dtor slots. The declared signature is irrelevant under
+/// opaque pointers — only the symbol's address is stored.
+fn declare_extern_fn_addr<'ll, 'tcx>(
+    cx: &CodegenCx<'ll, 'tcx>,
+    symbol: &str,
+) -> &'ll Value {
+    let fn_ty = cx.type_func(&[], cx.type_void());
+    cx.declare_cfn(symbol, llvm::UnnamedAddr::No, fn_ty)
+}
+
+/// P09.x (1.13.7): the two leading Itanium vtable dtor slots for a class
+/// whose chain has a virtual destructor — the complete-object (`D1`)
+/// then the deleting (`D0`) destructor of the *most-derived* class
+/// (`adt_did`). `delete (Base*)derived` dispatches to the `D0` slot.
+/// Returns `[]` when the chain has no virtual destructor.
+///
+/// Both slots run the full Rust drop glue (`drop_in_place::<D>`), which
+/// runs `Drop::drop` *and* drops every field — including the `__base`
+/// subobject, whose own `Drop` runs the C++ base destructor. (The plain
+/// `_ZN<D>D1Ev` symbol would be only the `Drop::drop` *body*, leaking
+/// the base subobject.) The `D0` slot additionally frees the storage.
+fn cxx_dtor_slots<'ll, 'tcx>(
+    cx: &CodegenCx<'ll, 'tcx>,
+    adt_did: DefId,
+) -> Vec<&'ll Value> {
+    if !cxx_mangle::chain_has_virtual_dtor(cx.tcx, adt_did) {
+        return Vec::new();
+    }
+    // The concrete (non-generic) ADT type; `#[repr(cpp)]` classes have
+    // no generic parameters, so empty args is the monomorphic type.
+    let ty = Ty::new_adt(cx.tcx, cx.tcx.adt_def(adt_did), cx.tcx.mk_args(&[]));
+    let drop_instance = Instance::resolve_drop_in_place(cx.tcx, ty);
+    // D1 (complete object dtor, no free) = drop_in_place::<D>.
+    let d1 = cx.get_fn_addr(drop_instance);
+    // D0 (deleting dtor) = drop_in_place::<D> + free.
+    let d0 = emit_cxx_deleting_dtor_thunk(cx, adt_did, ty, drop_instance);
+    vec![d1, d0]
+}
+
+/// Emit the deleting-destructor thunk for `adt_did`: a `void(this)`
+/// function that runs `drop_in_place::<D>(this)` then frees `this` with
+/// the C++ allocator (`operator delete`, Itanium `_ZdlPv` / MSVC
+/// `??3@YAXPEAX@Z`). The vtable's `D0` slot points here, so
+/// `delete (Base*)derived` from C++ destroys the Rust object and
+/// reclaims its storage exactly once.
+///
+/// This pairs with a Rust factory that allocates the instance through
+/// the C++ allocator (`operator new` + placement-construct), which is
+/// the natural ownership model when C++ owns and `delete`s the object
+/// (e.g. an FLTK widget added to a group). `_ZdlPv` is always provided
+/// by the C++ runtime the final binary links, so the Rust staticlib has
+/// no allocator-shim link dependency.
+fn emit_cxx_deleting_dtor_thunk<'ll, 'tcx>(
+    cx: &CodegenCx<'ll, 'tcx>,
+    adt_did: DefId,
+    _ty: Ty<'tcx>,
+    drop_instance: Instance<'tcx>,
+) -> &'ll Value {
+    let name = format!(
+        "__rustcc_cxx_delete${}",
+        cxx_mangle::mangle_cxx_vtable_symbol(cx.tcx, adt_did)
+    );
+    if let Some(existing) = cx.get_defined_value(&name) {
+        return existing;
+    }
+
+    let void_ty = cx.type_void();
+    let ptr_ty = cx.type_ptr();
+    let thunk_ty = cx.type_func(&[ptr_ty], void_ty);
+    let thunk = cx.declare_cfn(&name, llvm::UnnamedAddr::No, thunk_ty);
+    llvm::set_linkage(thunk, llvm::Linkage::LinkOnceODRLinkage);
+    if cx.tcx.sess.target.supports_comdat() {
+        llvm::SetUniqueComdat(cx.llmod, thunk);
+    }
+
+    let start = Builder::append_block(cx, thunk, "start");
+    let mut bx = Builder::build(cx, start);
+    let this = llvm::get_param(thunk, 0);
+
+    // drop_in_place::<D>(this) — runs Drop + all field drops (including
+    // the `__base` subobject, whose Drop runs the C++ base destructor).
+    let drop_abi = cx.fn_abi_of_instance(drop_instance, ty::List::empty());
+    let drop_fn_ty = drop_abi.llvm_type(cx);
+    let drop_callee = cx.get_fn_addr(drop_instance);
+    bx.call(drop_fn_ty, None, Some(drop_abi), drop_callee, &[this], None, Some(drop_instance));
+
+    // operator delete(this) — `_ZdlPv` (Itanium) / `??3@YAXPEAX@Z` (MSVC).
+    let op_delete_name = if cx.tcx.sess.target.is_like_msvc {
+        "??3@YAXPEAX@Z"
+    } else {
+        "_ZdlPv"
+    };
+    let op_delete_ty = cx.type_func(&[ptr_ty], void_ty);
+    let op_delete = cx.declare_cfn(op_delete_name, llvm::UnnamedAddr::Global, op_delete_ty);
+    bx.call(op_delete_ty, None, None, op_delete, &[this], None, None);
+
+    bx.ret_void();
+    thunk
+}
+
