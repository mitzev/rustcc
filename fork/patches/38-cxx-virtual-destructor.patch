 /// `mentioned_items` pass!
 fn visit_fn_use<'tcx>(
@@ -1508,6 +1535,23 @@ impl<'v> RootCollector<'_, 'v> {
     fn process_item(&mut self, id: hir::ItemId) {
         match self.tcx.def_kind(id.owner_id) {
             DefKind::Enum | DefKind::Struct | DefKind::Union => {
+                // P09.x (1.13.7): a `#[repr(cpp)]` class whose chain has a
+                // virtual destructor needs its `drop_in_place` collected
+                // even in lazy mode — codegen places it in the C++ vtable
+                // dtor slots, a reference the collector can't otherwise see.
+                if self.tcx.def_kind(id.owner_id) == DefKind::Struct {
+                    let adt_did = id.owner_id.to_def_id();
+                    if self.tcx.adt_def(adt_did).repr().cpp()
+                        && cxx_chain_has_virtual_dtor(self.tcx, adt_did)
+                    {
+                        let ty = Ty::new_adt(
+                            self.tcx,
+                            self.tcx.adt_def(adt_did),
+                            self.tcx.mk_args(&[]),
+                        );
+                        visit_drop_use(self.tcx, ty, true, DUMMY_SP, self.output);
+                    }
+                }
                 if self.strategy == MonoItemCollectionStrategy::Eager
                     && !self.tcx.generics_of(id.owner_id).requires_monomorphization(self.tcx)
                 {
