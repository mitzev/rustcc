+/// P09.x (1.13.7): true iff `adt_did`'s polymorphic chain has a virtual
+/// destructor — its own `#[rustc_cxx_imported_vtable]` carries `vdtor=1`,
+/// or a `#[rustc_cxx_base]` ancestor does. Such a `#[repr(cpp)]` derived
+/// class has its `drop_in_place` placed in the C++ vtable dtor slots by
+/// codegen; that reference is invisible to lazy mono collection, so the
+/// glue must be collected as a root (see `process_item`). Duplicated
+/// from `rustc_symbol_mangling::itanium::chain_has_virtual_dtor` —
+/// rustc_monomorphize can't depend on that crate.
+fn cxx_chain_has_virtual_dtor(tcx: TyCtxt<'_>, adt_did: DefId) -> bool {
+    if let Some(spec) =
+        rustc_hir::find_attr!(tcx, adt_did, RustcCxxImportedVtable { spec, .. } => *spec)
+        && spec.as_str().split(';').any(|r| r.trim() == "vdtor=1")
+    {
+        return true;
+    }
+    let adt = tcx.adt_def(adt_did);
+    let Some(variant) = adt.variants().iter().next() else { return false };
+    let Some(first) = variant.fields.raw.first() else { return false };
+    if !rustc_hir::find_attr!(tcx, first.did, RustcCxxBase(..)) {
+        return false;
+    }
+    match tcx.type_of(first.did).skip_binder().kind() {
+        ty::Adt(base_adt, _) => cxx_chain_has_virtual_dtor(tcx, base_adt.did()),
+        _ => false,
+    }
+}
+
