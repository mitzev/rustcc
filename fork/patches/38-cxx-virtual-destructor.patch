 }
 
+/// True iff this imported base declares a **virtual destructor** — its
+/// `#[rustc_cxx_imported_vtable]` spec carries a `vdtor=1` record. A
+/// virtual-dtor base puts the two leading dtor slots (complete `D1`,
+/// deleting `D0`) in the primary vtable, so a derived class must extend
+/// them with its own destructors for `delete (Base*)derived` to run the
+/// Rust drop.
+fn imported_vtable_has_vdtor<'tcx>(tcx: TyCtxt<'tcx>, adt_did: DefId) -> bool {
+    let Some(spec) = imported_vtable_spec(tcx, adt_did) else { return false };
+    spec.as_str().split(';').any(|r| r.trim() == "vdtor=1")
+}
+
+/// Whether `adt_did`'s polymorphic chain contains a class with a
+/// virtual destructor (an imported base carrying `vdtor=1`). When true,
+/// the leaf class's vtable gets two leading dtor slots resolving to the
+/// leaf's own `D1`/`D0` destructors (P09.x / 1.13.7).
+pub fn chain_has_virtual_dtor<'tcx>(tcx: TyCtxt<'tcx>, adt_did: DefId) -> bool {
+    if imported_vtable_has_vdtor(tcx, adt_did) {
+        return true;
+    }
+    match polymorphic_base_of_class(tcx, adt_did) {
+        Some(base_did) => chain_has_virtual_dtor(tcx, base_did),
+        None => false,
+    }
+}
+
+/// The complete-object destructor symbol (`_ZN<class>D1Ev`) for the
+/// derived class's vtable dtor slot 0.
+pub fn mangle_cxx_complete_dtor<'tcx>(tcx: TyCtxt<'tcx>, adt_did: DefId) -> String {
+    mangle_cxx_dtor_for_adt(tcx, adt_did, DtorVariant::D1)
+}
+
+/// The deleting destructor symbol (`_ZN<class>D0Ev`) for the derived
+/// class's vtable dtor slot 1 (`delete (Base*)derived` lands here).
+pub fn mangle_cxx_deleting_dtor<'tcx>(tcx: TyCtxt<'tcx>, adt_did: DefId) -> String {
+    mangle_cxx_dtor_for_adt(tcx, adt_did, DtorVariant::D0)
+}
+
+/// Itanium-mangle a destructor variant (`_ZN<class>D{0,1,2}Ev`) for a
+/// `#[repr(cpp)]` ADT directly from its `DefId` (no `Drop`-impl lookup,
+/// unlike [`mangle_dtor_variant`]). Used to fill the derived class's
+/// vtable dtor slots with its own `D1`/`D0` symbols.
+fn mangle_cxx_dtor_for_adt<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    adt_did: DefId,
+    variant: DtorVariant,
+) -> String {
+    let class_name = tcx.item_name(adt_did).to_string();
+    let mut path = cxx_namespace_path(tcx, adt_did);
+    path.push(NameSegment::Class(Ident(class_name)));
+    let mut ctx = CxxTypeCtx::new(CxxTarget::from_rustc_triple(
+        tcx.sess.opts.target_triple.tuple(),
+        tcx.sess.target.pointer_width as u32,
+    ));
+    let class_id = ctx.define_class(ClassDef {
+        name: NestedName(path),
+        bases: Vec::new(),
+        fields: Vec::new(),
+        methods: Vec::new(),
+        kind: RecordKind::Struct,
+        is_polymorphic: true,
+        is_final: false,
+        source_alignment: None,
+    });
+    ctx.mangle(&CxxSymbol::Dtor { class: class_id, variant })
+}
+
