+                        })
+                    }
                 };
                 ast::AngleBracketedArg::Arg(arg)
             })
@@ -2268,9 +2276,18 @@ fn parse_cxx_class_item(
             tokens: None,
         });
 
+        // P09.41: clone `generics` into a second set owned by the
