diff --git a/compiler/rustc_ast/src/ast.rs b/compiler/rustc_ast/src/ast.rs
index 28db4561..d444e612 100644
--- a/compiler/rustc_ast/src/ast.rs
+++ b/compiler/rustc_ast/src/ast.rs
@@ -4010,7 +4010,19 @@ pub fn span(&self) -> Span {
 #[derive(Clone, Encodable, Decodable, Debug)]
 pub struct Class {
     pub ident: Ident,
+    /// Generic parameters attached to the struct half. Each param's
+    /// `NodeId` gets its own `DefId` via `def_collector::
+    /// visit_generic_param` and becomes an owner-child of the
+    /// struct's HIR owner.
     pub generics: Generics,
+    /// Parallel generic parameters attached to the synthetic
+    /// inherent impl half. A deep-clone of `generics` emitted by
+    /// the parser with fresh `DUMMY_NODE_ID`s on every `id` field,
+    /// so expansion assigns a distinct set of `NodeId`s — and
+    /// hence `DefId`s — to the impl's params. This mirrors how a
+    /// hand-written `impl<A> Pair<A> { ... }` has its own
+    /// generic-param `DefId`s separate from the struct's.
+    pub impl_generics: Generics,
     /// Fields in declaration order. For `class Derived : Base { ... }`,
     /// the parser synthesizes a leading `#[rustc_cxx_base] __base: Base`
     /// field so downstream layout/vtable paths can detect the
@@ -4025,10 +4037,10 @@ pub struct Class {
     /// `Item<ItemKind>::id`.
     pub impl_id: NodeId,
     /// Self-type for the synthetic inherent impl: a path `ClassIdent`
-    /// or `ClassIdent<Args>` matching `generics`. Built at parse time
-    /// and lowered via `lower_ty` in ast_lowering. Storing it as a
-    /// full AST `Ty` lets name resolution wire it to the struct half
-    /// like any other type reference.
+    /// or `ClassIdent<Args>` matching `impl_generics`. Built at
+    /// parse time and lowered via `lower_ty` in ast_lowering.
+    /// Resolution picks up the impl's generic params because
+    /// `resolve_class` pushes the impl rib before walking the self-type.
     pub self_ty: Box<Ty>,
 }
 
diff --git a/compiler/rustc_ast/src/visit.rs b/compiler/rustc_ast/src/visit.rs
index b435870d..fca7ba7c 100644
--- a/compiler/rustc_ast/src/visit.rs
+++ b/compiler/rustc_ast/src/visit.rs
@@ -973,10 +973,25 @@ pub fn walk_fn<$($lt,)? V: $Visitor$(<$lt>)?>(vis: &mut V, kind: FnKind<$($lt)?
             // parser's `DUMMY_NODE_ID` with a fresh `NodeId`. If
             // it's left as dummy, `ast_lowering::index_crate`
             // panics when trying to look up the impl half's DefId.
-            let Class { ident, generics, fields, methods, impl_id, self_ty } = self;
+            //
+            // P09.41: walk `impl_generics` as well. Both generics
+            // sets are fresh clones at parse time; expansion
+            // visits each independently and assigns distinct
+            // NodeIds so the two halves have parallel but
+            // non-colliding `DefId`s for their generic params.
+            let Class {
+                ident,
+                generics,
+                impl_generics,
+                fields,
+                methods,
+                impl_id,
+                self_ty,
+            } = self;
             visit_visitable!($($mut)? vis, impl_id);
             visit_visitable!($($mut)? vis, ident, generics);
             visit_visitable!($($mut)? vis, fields);
+            visit_visitable!($($mut)? vis, impl_generics);
             try_visit!(vis.visit_ty(self_ty));
             visit_visitable_with!($($mut)? vis, methods, AssocCtxt::Impl { of_trait: false });
             V::Result::output()
