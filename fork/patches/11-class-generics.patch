diff --git a/compiler/rustc_resolve/src/late.rs b/compiler/rustc_resolve/src/late.rs
index 97290b0b..04219be8 100644
--- a/compiler/rustc_resolve/src/late.rs
+++ b/compiler/rustc_resolve/src/late.rs
@@ -2716,6 +2716,83 @@ fn is_label_valid_from_rib(&self, rib_index: usize) -> bool {
         ribs.iter().all(|rib| !rib.kind.is_label_barrier())
     }
 
+    /// P09.41: two-phase resolution for a `class` item. Mirrors a
+    /// hand-written `struct Foo<A> { ... }` + `impl<A> Foo<A> { ... }`
+    /// pair: the struct's generics scope the fields; the impl's
+    /// generics scope the self-type and methods. Two separate ribs
+    /// because each set of generic params has its own `DefId` (see
+    /// `ast::Class::impl_generics`).
+    fn resolve_class(&mut self, item: &'ast Item, class: &'ast ast::Class) {
+        let struct_kind = self.r.local_def_kind(item.id);
+        let impl_kind = self.r.local_def_kind(class.impl_id);
+        let struct_def_id = self.r.local_def_id(item.id).to_def_id();
+
+        // Struct half — generics + fields under the struct's rib.
+        self.with_current_self_item(item, |this| {
+            this.with_generic_param_rib(
+                &class.generics.params,
+                RibKind::Item(HasGenericParams::Yes(class.generics.span), struct_kind),
+                item.id,
+                LifetimeBinderKind::Item,
+                class.generics.span,
+                |this| {
+                    this.with_self_rib(
+                        Res::SelfTyAlias {
+                            alias_to: struct_def_id,
+                            is_trait_impl: false,
+                        },
+                        |this| {
+                            this.visit_generics(&class.generics);
+                            for field in &class.fields {
+                                this.visit_field_def(field);
+                            }
+                        },
+                    );
+                },
+            );
+        });
+
+        // Impl half — impl_generics + self_ty + methods under the
+        // impl's rib. Self resolves to the struct (same DefId as
+        // a hand-written inherent impl's `Self`).
+        self.with_generic_param_rib(
+            &class.impl_generics.params,
+            RibKind::Item(HasGenericParams::Yes(class.impl_generics.span), impl_kind),
+            class.impl_id,
+            LifetimeBinderKind::ImplBlock,
+            class.impl_generics.span,
+            |this| {
+                this.with_self_rib(
+                    Res::SelfTyAlias {
+                        alias_to: struct_def_id,
+                        is_trait_impl: false,
+                    },
+                    |this| {
+                        this.visit_generics(&class.impl_generics);
+                        this.visit_ty(&class.self_ty);
+                        this.with_current_self_type(&class.self_ty, |this| {
+                            this.with_self_rib_ns(
+                                ValueNS,
+                                Res::SelfCtor(struct_def_id),
+                                |this| {
+                                    let mut seen_trait_items = Default::default();
+                                    for method in &class.methods {
+                                        this.resolve_impl_item(
+                                            method,
+                                            &mut seen_trait_items,
+                                            None,
+                                            false,
+                                        );
+                                    }
+                                },
+                            );
+                        });
+                    },
+                );
+            },
+        );
+    }
+
     fn resolve_adt(&mut self, item: &'ast Item, generics: &'ast Generics) {
         debug!("resolve_adt");
         let kind = self.r.local_def_kind(item.id);
@@ -2819,19 +2896,14 @@ fn resolve_item(&mut self, item: &'ast Item) {
                 self.resolve_adt(item, generics);
             }
 
-            // P09.39: share resolve_adt's shape — the class's
-            // generics form a single param rib visible to both
-            // fields and methods, and `Self` resolves to the class
-            // via the self-rib. `visit::walk_item` descends into
-            // fields (via `visit_field_def`) and methods (via
-            // `visit_assoc_item` with `AssocCtxt::Impl`), each
-            // resolving against that rib stack. The synthetic impl
-            // DefId exists in the def graph (registered by
-            // `def_collector`) but needs no further rib setup here
-            // because inherent impls don't contribute extra generic
-            // parameters or trait bounds beyond the class's own.
-            ItemKind::Class(box ast::Class { generics, .. }) => {
-                self.resolve_adt(item, generics);
+            // P09.39 / P09.41: two-phase resolve for `class`. The
+            // struct half's generics scope the fields; the impl
+            // half's generics scope the self-type and methods.
+            // Mirrors what `resolve_adt` + `resolve_implementation`
+            // do for a hand-written `struct Foo<A> { ... }` +
+            // `impl<A> Foo<A> { ... }` pair.
+            ItemKind::Class(class) => {
+                self.resolve_class(item, class);
             }
 
             ItemKind::Impl(Impl { generics, of_trait, self_ty, items: impl_items, .. }) => {
