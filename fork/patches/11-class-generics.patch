--- a/compiler/rustc_parse/src/parser/item.rs
+++ b/compiler/rustc_parse/src/parser/item.rs
@@ -2042,18 +2042,26 @@ fn build_cxx_class_self_path(ident: Ident, generics: &Generics) -> ast::Path {
                         span: p.ident.span,
                         tokens: None,
                     })),
-                    // Const generics aren't part of v1's `class`
-                    // header surface. Reference them as a bare
-                    // type path — if the user actually declares
