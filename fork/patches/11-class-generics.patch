-                    GenericParamKind::Const { .. } => ast::GenericArg::Type(Box::new(Ty {
-                        id: DUMMY_NODE_ID,
-                        kind: TyKind::Path(None, ast::Path::from_ident(p.ident)),
-                        span: p.ident.span,
-                        tokens: None,
-                    })),
+                    // P09.41 (1.01 #1): const generic — reference
+                    // the parameter by its identifier as an anon
+                    // const expression. Lowers to `GenericArg::Const`
+                    // at HIR time, matching how a hand-written
+                    // `impl<const N: usize> Foo<N> { ... }`
+                    // self-type resolves.
+                    GenericParamKind::Const { .. } => {
+                        let ident_expr = Box::new(ast::Expr {
+                            id: DUMMY_NODE_ID,
+                            kind: ast::ExprKind::Path(None, ast::Path::from_ident(p.ident)),
