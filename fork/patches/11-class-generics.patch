                 if let ItemKind::Class(class) = &i.kind {
                     let impl_def_id = this.create_def(
                         class.impl_id,
@@ -228,6 +234,8 @@ fn visit_item(&mut self, i: &'a Item) {
                         this.visit_field_def(field);
                     }
                     this.with_parent(impl_def_id, |this| {
+                        this.visit_generics(&class.impl_generics);
