# P09.26 — Fix VWT slot order in `rustcc_swift_rt`.
#
# Workspace-only bug fix. No compiler changes.
#
# # Diagnosis
#
# The Swift Phase 2b runtime crate (`rustcc_swift_rt`) declared
# a `ValueWitnessTable` struct whose field order didn't match
# Swift's actual VWT layout:
#
# - Rust had `destroy` at offset 0.
# - Swift places `initializeBufferWithCopyOfBuffer` at offset 0;
#   `destroy` is at offset 8.
#
# Evidence: compile a tiny Swift file that uses a struct with
# class fields, emit IR with `swiftc -emit-ir`, inspect the VWT
# constant literal `@"$s<mod><type>VWV"`. The first entry is
# `$s<mod><type>wCP` (`wCP` = mangled
# `initializeBufferWithCopyOfBuffer`); the second is
# `$s<mod><type>wxx` (`wxx` = `destroy`).
#
# The entire slot ordering in Rust's struct was off:
#
# ```
# Rust had:                 Swift actual:
# 0: destroy                0: initializeBufferWithCopyOfBuffer
# 1: initializeWithCopy     1: destroy
# 2: initializeWithTake     2: initializeWithCopy
# 3: assignWithCopy         3: assignWithCopy
# 4: assignWithTake         4: initializeWithTake
#                           5: assignWithTake
# ```
#
# # Symptom
#
# `drop_swift_value` was actually calling
# `initializeBufferWithCopyOfBuffer(value, metadata)`. For
# trivial `#[repr(swift)]` types (no class fields) the init-buffer
# witness is a plain memcpy — it didn't dereference its source
# arg, so the mistake was silent. For types with a class field,
# the init-buffer witness does a `swift_retain` on what it thinks
# is the source class ref; that source was our metadata pointer,
# so the retain operated on a Metadata struct as if it were a
# HeapObject and crashed deep in
# `swift::RefCounts<...>::incrementSlow` with `EXC_BAD_ACCESS`.
#
# That crash signature is what was documented as "VWT-direct
# destroy segfaults on types with class fields — swiftcc
# fn-pointer ABI interaction still being debugged." The real
# cause had nothing to do with swiftcc; it was a plain
# off-by-slot in the Rust struct declaration.
#
# # Fix
#
# Reorder the `ValueWitnessTable` fields to match Swift's
# layout. Add the missing `initialize_buffer_with_copy_of_buffer`
# slot at offset 0. Swap `initialize_with_take` and
# `assign_with_copy` (Swift has assign before init-take among the
# second-pair witnesses).
#
# # Validation
#
# - `/tmp/p09-vwt-investigate/` — copies the `p09-swift-nt` probe
#   but replaces the outlined-destroy Drop impl with the
#   `drop_swift_value` VWT-direct path. Before: segfault
#   (SIGSEGV, exit 139) in `incrementSlow`. After: runs clean,
#   `deinit_count = 3`, exit 42.
# - `/tmp/p09-swift-nt/` regression — outlined-destroy path
#   unchanged, still passes `deinit_count = 3`.
# - `cargo test --workspace` → 235/0 preserved.
#
# # Files touched
#
# - `crates/rustcc_swift_rt/src/lib.rs` — reordered struct
#   fields; doc comment at top updated to remove the
#   "currently broken" caveat; struct-level doc block
#   explains the slot-order history as a comment (so future
#   readers know why the layout is what it is).

diff --git a/crates/rustcc_swift_rt/src/lib.rs b/crates/rustcc_swift_rt/src/lib.rs
--- a/crates/rustcc_swift_rt/src/lib.rs
+++ b/crates/rustcc_swift_rt/src/lib.rs
@@ (struct ValueWitnessTable — full reorder)
-pub struct ValueWitnessTable {
-    pub destroy:                              // offset 0 (WRONG — was initializeBufferWithCopyOfBuffer)
-        unsafe extern "Swift" fn(ptr: *mut u8, metadata: *mut Metadata),
-    pub initialize_with_copy:                 // offset 8 (was destroy)
-        unsafe extern "Swift" fn(dst: *mut u8, src: *const u8, metadata: *mut Metadata) -> *mut u8,
-    pub initialize_with_take:                 // offset 16 (was initializeWithCopy)
-        unsafe extern "Swift" fn(dst: *mut u8, src: *mut u8,   metadata: *mut Metadata) -> *mut u8,
-    pub assign_with_copy:                     // offset 24
-        unsafe extern "Swift" fn(dst: *mut u8, src: *const u8, metadata: *mut Metadata) -> *mut u8,
-    pub assign_with_take:                     // offset 32 (was initializeWithTake)
-        unsafe extern "Swift" fn(dst: *mut u8, src: *mut u8,   metadata: *mut Metadata) -> *mut u8,
-}
+pub struct ValueWitnessTable {
+    pub initialize_buffer_with_copy_of_buffer:  // offset 0
+        unsafe extern "Swift" fn(dst: *mut u8, src: *mut u8,   metadata: *mut Metadata) -> *mut u8,
+    pub destroy:                                // offset 8
+        unsafe extern "Swift" fn(ptr: *mut u8,                  metadata: *mut Metadata),
+    pub initialize_with_copy:                   // offset 16
+        unsafe extern "Swift" fn(dst: *mut u8, src: *const u8, metadata: *mut Metadata) -> *mut u8,
+    pub assign_with_copy:                       // offset 24
+        unsafe extern "Swift" fn(dst: *mut u8, src: *const u8, metadata: *mut Metadata) -> *mut u8,
+    pub initialize_with_take:                   // offset 32
+        unsafe extern "Swift" fn(dst: *mut u8, src: *mut u8,   metadata: *mut Metadata) -> *mut u8,
+    pub assign_with_take:                       // offset 40
+        unsafe extern "Swift" fn(dst: *mut u8, src: *mut u8,   metadata: *mut Metadata) -> *mut u8,
+}
