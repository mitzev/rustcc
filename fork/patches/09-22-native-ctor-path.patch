+
+/// If `def_id` is a foreign fn inside `extern "C++" { ... }`
+/// carrying `#[rustc_cxx_ctor]` and returning a `#[repr(cpp)]`
+/// ADT by value, returns that ADT's `DefId`. The return type
+/// directly names the class being constructed.
+///
+/// P09.22: this mirrors the Rust-impl ctor path
+/// (`impl Widget { #[rustc_cxx_ctor] fn new() -> Self }`)
+/// for foreign declarations, unifying the ctor emission so the
+/// `cxx_class!` macro can drop its sret-trampoline workaround.
+fn cxx_foreign_ctor_class<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> Option<DefId> {
+    if tcx.def_kind(def_id) != DefKind::Fn {
+        return None;
+    }
+    let parent = tcx.opt_parent(def_id)?;
+    if tcx.def_kind(parent) != DefKind::ForeignMod {
+        return None;
+    }
+    if !has_cxx_ctor_attr(tcx, def_id) {
+        return None;
+    }
+    let sig = tcx.fn_sig(def_id).skip_binder().skip_binder();
+    let ty::Adt(adt_def, _) = sig.output().kind() else {
+        return None;
+    };
+    if !adt_def.repr().cpp() {
+        return None;
+    }
+    Some(adt_def.did())
+}
