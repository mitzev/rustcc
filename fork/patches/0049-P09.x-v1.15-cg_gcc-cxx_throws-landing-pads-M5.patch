-    // P09.62: GCC backend stub for cxx_catch_landing_pad. The
-    // LLVM backend's catch-all landingpad (1 clause, null
-    // type-info) doesn't map cleanly to libgccjit's
-    // try/catch shape — that path is the libgccjit master
-    // branch's job and is out of scope for this patch. The
-    // implementation here mirrors `cleanup_landing_pad`'s
-    // GCC stub for consistency: same shape, no real catch
-    // semantics until libgccjit grows the matching API.
+    // P09.x (v1.15) / P09.62-gcc + P09.68-gcc: real GCC-backend
+    // catch landing pad for `#[rustc_cxx_throws]`.
     //
-    // Real users of `#[rustc_cxx_throws]` will be on the LLVM
-    // backend; the GCC backend stub exists only so the trait
-    // compiles.
+    // The catch BB is reached through `invoke`'s
+    // `add_try_catch` region (gccjit master API); here we set
+    // the personality (the C++ `__gxx_personality_v0` for typed
+    // catches — passed in by the SSA layer), read the in-flight
+    // exception with `__builtin_eh_pointer(0)`, and compute the
+    // SELECTOR. gccjit has no `llvm.eh.typeid.for`, so typed
+    // selection is delegated to the `cxx` runtime:
+    // `__rustcc_cxx_match_typeinfo(exn, tis, n)` compares the
+    // thrown exception's `std::type_info` against a static array
+    // of the clause typeinfos and returns the same small 1-based
+    // index the LLVM landingpad path produces (0 = no typed
+    // match → catch-all).
+    #[cfg(feature = "master")]
+    fn cxx_catch_landing_pad(
+        &mut self,
+        pers_fn: Function<'gcc>,
+        typeinfos: &[RValue<'gcc>],
+    ) -> (RValue<'gcc>, RValue<'gcc>) {
+        self.set_personality_fn(pers_fn);
+
+        let eh_pointer_builtin =
+            self.cx.context.get_target_builtin_function("__builtin_eh_pointer");
+        let zero = self.cx.context.new_rvalue_zero(self.int_type);
+        let ptr = self.cx.context.new_call(self.location, eh_pointer_builtin, &[zero]);
+        let ptr_ty = self.u8_type.make_pointer();
+        let exn = self.cx.context.new_cast(self.location, ptr, ptr_ty);
+
+        let selector = if typeinfos.is_empty() {
+            self.cx.context.new_rvalue_zero(self.i32_type)
+        } else {
+            // Static array of the clause typeinfo addresses, in
+            // clause order. Unique name per landing pad.
+            let n = typeinfos.len();
+            let idx = self.cx.cxx_throws_pad_counter.get();
+            self.cx.cxx_throws_pad_counter.set(idx + 1);
+            let arr_name = format!("__rustcc_cxx_tis_{idx}");
+            let arr_ty = self.cx.context.new_array_type(None, ptr_ty, n as u64);
+            let arr = self.cx.context.new_global(
+                None,
+                gccjit::GlobalKind::Internal,
+                arr_ty,
+                &arr_name,
+            );
+            let elems: Vec<RValue<'gcc>> = typeinfos
+                .iter()
+                .map(|ti| self.cx.context.new_cast(None, *ti, ptr_ty))
+                .collect();
+            let init = self.cx.context.new_array_constructor(None, arr_ty, &elems);
+            arr.global_set_initializer_rvalue(init);
+
+            let matcher = *self
+                .cx
+                .functions
+                .borrow_mut()
+                .entry("__rustcc_cxx_match_typeinfo".to_string())
+                .or_insert_with(|| {
+                    let p_exn = self.cx.context.new_parameter(None, ptr_ty, "exn");
+                    let tis_ty = ptr_ty.make_pointer();
+                    let p_tis = self.cx.context.new_parameter(None, tis_ty, "tis");
+                    let p_n =
+                        self.cx.context.new_parameter(None, self.cx.type_u32(), "n");
+                    self.cx.context.new_function(
+                        None,
+                        FunctionType::Extern,
+                        self.cx.type_u32(),
+                        &[p_exn, p_tis, p_n],
+                        "__rustcc_cxx_match_typeinfo",
+                        false,
+                    )
+                });
+            // The matcher may have been declared from its Rust
+            // definition in this very CGU (different nominal pointer
+            // types) — cast every argument to the function's own
+            // parameter types.
+            let cast_to_param = |i: i32, v: RValue<'gcc>| {
+                let want = matcher.get_param(i).to_rvalue().get_type();
+                self.cx.context.new_cast(self.location, v, want)
+            };
+            let tis_ptr = arr.get_address(None);
+            let n_val =
+                self.cx.context.new_rvalue_from_int(self.cx.type_u32(), n as i32);
+            let sel_u32 = self.cx.context.new_call(
+                self.location,
+                matcher,
+                &[cast_to_param(0, exn), cast_to_param(1, tis_ptr), cast_to_param(2, n_val)],
+            );
+            self.cx.context.new_cast(self.location, sel_u32, self.i32_type)
+        };
+
+        (exn, selector)
+    }
+
+    #[cfg(not(feature = "master"))]
     fn cxx_catch_landing_pad(
         &mut self,
         pers_fn: Function<'gcc>,
         _typeinfos: &[RValue<'gcc>],
     ) -> (RValue<'gcc>, RValue<'gcc>) {
-        // Delegate to cleanup_landing_pad — it's not a real
-        // catch, but the trait must be satisfied. P09.62-gcc
-        // tracks a proper impl when libgccjit's try-catch
-        // surface lands. Typed catches (P09.68) are also
-        // stubbed here.
+        // Without the master-feature try/catch + EH builtins this
+        // can't be a real catch; mirror cleanup_landing_pad's
+        // non-master stub.
         self.cleanup_landing_pad(pers_fn)
     }
 
