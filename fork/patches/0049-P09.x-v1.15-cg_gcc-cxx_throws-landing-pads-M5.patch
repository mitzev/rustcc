+
+    /// P09.x (v1.15): declare (or look up) a `__rustcc_cxx_catch_*`
+    /// runtime helper — `fn(ptr [, i32]) -> CxxRawError` where
+    /// `CxxRawError` is `{ i32 kind, const char* msg }` returned by
+    /// value. Returns the function's address plus the fn-POINTER
+    /// type, so the SSA layer's `bx.call(ty, …, value, …)` routes
+    /// through `function_ptr_call` correctly.
+    fn cxx_throws_helper(
+        &self,
+        name: &str,
+        with_selector: bool,
+    ) -> (RValue<'gcc>, Type<'gcc>) {
+        let char_ptr = self.type_i8().make_pointer();
+        let raw_err_ty = match self.cxx_raw_error_type.get() {
+            Some(t) => t,
+            None => {
+                let kind_field = self.context.new_field(None, self.type_i32(), "kind");
+                let msg_field = self.context.new_field(None, char_ptr, "message");
+                let t = self
+                    .context
+                    .new_struct_type(None, "__rustcc_CxxRawError", &[kind_field, msg_field])
+                    .as_type();
+                self.cxx_raw_error_type.set(Some(t));
+                t
+            }
+        };
+
+        let void_ptr = self.type_i8().make_pointer();
+        let mut param_tys: Vec<Type<'gcc>> = vec![void_ptr];
+        if with_selector {
+            param_tys.push(self.type_i32());
+        }
+
+        let func = *self.functions.borrow_mut().entry(name.to_string()).or_insert_with(|| {
+            let mut params =
+                vec![self.context.new_parameter(None, void_ptr, "exn")];
+            if with_selector {
+                params.push(self.context.new_parameter(None, self.type_i32(), "selector"));
+            }
+            self.context.new_function(
+                None,
+                FunctionType::Extern,
+                raw_err_ty,
+                &params,
+                name,
+                false,
+            )
+        });
+
+        let fn_ptr_ty =
+            self.context.new_function_pointer_type(None, raw_err_ty, &param_tys, false);
+        (func.get_address(None), fn_ptr_ty)
+    }
 }
 
