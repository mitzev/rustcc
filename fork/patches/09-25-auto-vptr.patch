# P09.25 — Auto vptr init + auto `__vptr` slot in polymorphic
# `#[repr(cpp)]` layouts.
#
# Completes the "Rust-defines-polymorphic" story started in
# P09.24. Users no longer need to declare a manual `__vptr` field
# or write the ctor body with an `unsafe extern "C"` reference to
# `_ZTV<class>`. The compiler:
#
# 1. Reserves `ptr_bytes` at offset 0 in the layout of any
#    polymorphic `#[repr(cpp)]` class (all user fields shift).
# 2. Injects a store of the Itanium vtable address point into
#    offset 0 at the start of every `#[rustc_cxx_ctor]` method
#    body — before any MIR runs.
#
# Result: users write plain Rust for a polymorphic class and
# C++ dispatches into it correctly. Compare:
#
# ```rust
# // P09.24 (manual boilerplate):
# #[repr(cpp)]
# pub struct Widget { __vptr: *const (), pub v: i32 }
# unsafe extern "C" {
#     #[link_name = "_ZTV6Widget"]
#     static WIDGET_VTABLE: [*const (); 4];
# }
# impl Widget {
#     #[rustc_cxx_ctor]
#     pub fn new(v: i32) -> Self {
#         let vptr = unsafe { core::ptr::addr_of!(WIDGET_VTABLE[2]) as *const () };
#         Widget { __vptr: vptr, v }
#     }
#     #[rustc_cxx_virtual] pub fn foo(&self) -> i32 { self.v + 100 }
# }
#
# // P09.25 (no boilerplate):
# #[repr(cpp)]
# pub struct Widget { pub v: i32 }
# impl Widget {
#     #[rustc_cxx_ctor]
#     pub fn new(v: i32) -> Self { Widget { v } }
#     #[rustc_cxx_virtual] pub fn foo(&self) -> i32 { self.v + 100 }
# }
# ```
#
# # Changes
#
# ## Layout shift (`rustc_ty_utils/src/layout/cxx_bridge.rs`)
#
# `correct_layout` grows a new path for polymorphic classes:
# after the stock Itanium size/align correction, if the ADT has
# any inherent method tagged `#[rustc_cxx_virtual]`, shift every
# field offset in the `FieldsShape::Arbitrary.offsets` vec by
# `ptr_bytes`, bump `size` by `ptr_bytes`, raise `align` to at
# least `ptr_align`, and force `backend_repr` to
# `Memory { sized: true }`.
#
# The short-circuit that returns `stock` unchanged when Itanium
# and Rust agree on size/align is bypassed for polymorphic
# classes — the shift is needed regardless of Itanium agreement.
#
# `backend_repr = Memory` matters because the stock `Scalar(i32)`
# classification on a now-16-byte struct crashes the x86_64
# classifier (`Scalar` implies the layout is a scalar primitive).
#
# Polymorphism detection is duplicated in a small local helper
# (`is_polymorphic_cpp_class`) — the canonical impl in
# `rustc_symbol_mangling::itanium` isn't reachable from
# `rustc_ty_utils` without a circular dep.
#
# ## Vptr injection (`rustc_codegen_ssa/src/traits/builder.rs`,
# `rustc_codegen_llvm/src/builder.rs`, `rustc_codegen_llvm/src/cxx_vtable.rs`)
#
# New `BuilderMethods::maybe_emit_cxx_ctor_vptr_init` trait
# method with a default no-op. LLVM backend overrides it:
# - If `instance` is a `#[rustc_cxx_ctor]` on a polymorphic
#   `#[repr(cpp)]` class, declare the class's vtable as a
#   weak external pointer (`_ZTV<class>`), GEP by `2*ptr_bytes`
#   to get the address point, and `store` that into `ret_place_ptr`.
#
# `codegen_mir` calls this method once at function entry, right
# after `fx.initialize_locals`, before any MIR runs. The return
# place is at `fx.locals[mir::RETURN_PLACE]`; its PlaceRef's
# `val.llval` is the Self storage pointer (sret pointer for
# aggregate returns like ours).
#
# `has_cxx_ctor_attr` in `rustc_symbol_mangling::itanium` is
# promoted from `fn` to `pub fn` so the codegen hook can call
# it.
#
# ## x86_64 ABI classifier (`rustc_target/src/callconv/x86_64.rs`)
#
# The SysV AMD64 classifier would panic on layouts with holes
# (eightbytes not covered by any field). Polymorphic classes are
# exactly such layouts — the leading `ptr_bytes` slot (the vptr)
# is not a Rust field, so `classify_arg` returns
# `[None, Some(Int)]` for a 16-byte Widget, and `cast_target`
# unwraps `None` at slot 0.
#
# Fix: after classification, if any covered eightbyte is left
# unclassified, return `Err(Memory)` — the aggregate gets sret'd
# rather than register-decomposed. One-line robustness fix that
# also insulates against any other layout shape that leaves
# holes (enums with large niches, future features).
#
# # Validation
#
# - `/tmp/p09-25-auto-vptr/` — Rust declares plain
#   `Widget { pub v: i32 }` with two virtual methods; Rust ctor
#   body is just `Widget { v }`; C++ dispatches `foo()` / `bar()`
#   through vtable. Exit 0, `foo() = 107, bar() = 14`.
# - `/tmp/p09-24-polymorphic/` (regression) — still passes with
#   the old manual `__vptr` pattern (P09.25 is strictly additive
#   for this path; the manual field just occupies an extra slot
#   that's harmless).
# - `cargo test --workspace` → 235/0.

diff --git a/compiler/rustc_ty_utils/src/layout/cxx_bridge.rs b/compiler/rustc_ty_utils/src/layout/cxx_bridge.rs
--- a/compiler/rustc_ty_utils/src/layout/cxx_bridge.rs
+++ b/compiler/rustc_ty_utils/src/layout/cxx_bridge.rs
@@ -38,7 +38,7 @@
 use rustc_abi::{
-    Align, BackendRepr, FieldIdx, LayoutData, Size, VariantIdx,
+    Align, BackendRepr, FieldIdx, FieldsShape, LayoutData, Size, VariantIdx,
 };

@@ -57,7 +57,7 @@
 pub(crate) fn correct_layout<'tcx>(
-    _tcx: TyCtxt<'tcx>,
+    tcx: TyCtxt<'tcx>,
     def: AdtDef<'tcx>,
     _args: &'tcx ty::List<ty::GenericArg<'tcx>>,

@@ (around the agree-and-shortcircuit check)
-    // If Itanium agrees with stock on both size and align, short-
-    // circuit. The common case.
-    if stock.size == cxx_size && stock.align.abi >= cxx_align {
+    // P09.25: polymorphic classes always need the vptr shift,
+    // even when Itanium's size/align agrees with stock (which is
+    // computed WITHOUT the vptr reservation). Check polymorphism
+    // before the agree-and-shortcircuit path.
+    let polymorphic = is_polymorphic_cpp_class(tcx, def.did());
+
+    if !polymorphic && stock.size == cxx_size && stock.align.abi >= cxx_align {
         return Ok(stock);
     }

@@ (just before the final `Ok(candidate)`)
+    // P09.25: polymorphic classes have an invisible vptr at
+    // offset 0. Shift all user-field offsets by one pointer
+    // width so the vptr slot is reserved before them.
+    if polymorphic {
+        let ptr_bytes = tcx.data_layout.pointer_size().bytes();
+        let ptr_align = tcx.data_layout.pointer_align().abi;
+        return Ok(shift_fields_for_vptr(candidate, ptr_bytes, ptr_align));
+    }
     Ok(candidate)
 }
+
+fn is_polymorphic_cpp_class<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    adt_did: rustc_hir::def_id::DefId,
+) -> bool {
+    for &impl_did in tcx.inherent_impls(adt_did).iter() {
+        for &assoc in tcx.associated_item_def_ids(impl_did).iter() {
+            if tcx.def_kind(assoc) != rustc_hir::def::DefKind::AssocFn {
+                continue;
+            }
+            if rustc_hir::find_attr!(tcx, assoc, RustcCxxVirtual(..)) {
+                return true;
+            }
+        }
+    }
+    false
+}
+
+fn shift_fields_for_vptr(
+    mut layout: LayoutData<FieldIdx, VariantIdx>,
+    ptr_bytes: u64,
+    ptr_align: Align,
+) -> LayoutData<FieldIdx, VariantIdx> {
+    if let FieldsShape::Arbitrary { ref mut offsets, .. } = layout.fields {
+        for offset in offsets.iter_mut() {
+            *offset = *offset + Size::from_bytes(ptr_bytes);
+        }
+    }
+    layout.size = layout.size + Size::from_bytes(ptr_bytes);
+    if layout.align.abi < ptr_align {
+        layout.align.abi = ptr_align;
+    }
+    let align_bytes = layout.align.abi.bytes();
+    let size_bytes = layout.size.bytes();
+    if align_bytes != 0 && size_bytes % align_bytes != 0 {
+        layout.size = Size::from_bytes(size_bytes.next_multiple_of(align_bytes));
+    }
+    layout.backend_repr = BackendRepr::Memory { sized: true };
+    layout
+}

