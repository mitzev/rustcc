+    /// P09.15: For Rust `Drop` impls on `#[repr(cpp)]` types,
+    /// emit the Itanium D0 (deleting) and D2 (base-object)
+    /// destructor variants as trampolines alongside D1. Required
+    /// for virtual dispatch of `delete p` through a C++ base
+    /// pointer to land in Rust's Drop.
+    ///
+    /// - D2 is a plain forward to D1 (in single-inheritance
+    ///   without virtual bases, D1 and D2 run the same user code).
+    /// - D0 forwards to D1 then calls `operator delete(this)`
+    ///   (`_ZdlPv`), matching Clang's emission for
+    ///   `delete derived_obj`.
+    fn maybe_add_cxx_dtor_variants(
+        &self,
+        instance: Instance<'tcx>,
+        d1_decl: &'ll llvm::Value,
+        linkage: Linkage,
+        visibility: Visibility,
+    ) {
+        let def_id = instance.def_id();
+        if !rustc_symbol_mangling::itanium::is_cxx_drop_impl(self.tcx, def_id) {
+            return;
+        }
+
+        let fn_abi: &FnAbi<'tcx, Ty<'tcx>> =
+            self.fn_abi_of_instance(instance, ty::List::empty());
+        let fn_ty = fn_abi.llvm_type(self);
+        let attrs = self.tcx.codegen_instance_attrs(instance.def);
+
+        // Helper: emit a trampoline symbol named `name` whose body
+        // is `{ call D1(args); <tail>; ret }`. Returns the llvm
+        // decl so the caller can chain extra calls (for D0 which
+        // also calls `operator delete`).
+        let emit_trampoline = |name: &str, also_call_op_delete: bool| {
+            let trampoline = self.predefine_without_aliases(
+                instance, &attrs, linkage, visibility, name,
+            );
+            let start_llbb = Builder::append_block(self, trampoline, "start");
+            let mut bx = Builder::build(self, start_llbb);
+
+            let num_params = llvm::count_params(trampoline);
+            let mut args = Vec::with_capacity(num_params as usize);
+            for index in 0..num_params {
+                args.push(llvm::get_param(trampoline, index));
+            }
+
+            bx.call(
+                fn_ty, Some(&attrs), Some(fn_abi), d1_decl, &args, None, Some(instance),
+            );
+
+            if also_call_op_delete {
+                // Declare and call `operator delete(void*)` —
+                // `_ZdlPv`. Clang emits this in the D0 body when
+                // the dtor is virtual and `delete p` is reachable.
+                let op_delete_name = "_ZdlPv";
+                let void_ty = self.type_void();
+                let ptr_ty = self.type_ptr();
+                let op_delete_ty = self.type_func(&[ptr_ty], void_ty);
+                let op_delete = self.declare_cfn(
+                    op_delete_name,
+                    llvm::UnnamedAddr::Global,
+                    op_delete_ty,
+                );
+                // The first arg is `this` (a pointer). Rust's
+                // Drop fn's first arg is `&mut Self`, which has
+                // the same ABI — pass it through.
+                if !args.is_empty() {
+                    bx.call(
+                        op_delete_ty, None, None, op_delete, &args[..1], None, None,
+                    );
+                }
+            }
+
+            // Drop fns return `()`, so ret_void is correct
+            // regardless of which variant we're emitting.
+            bx.ret_void();
+        };
+
+        if let Some(d2_name) =
+            rustc_symbol_mangling::itanium::mangle_dtor_d2(self.tcx, def_id)
+        {
+            emit_trampoline(&d2_name, false);
+        }
+        if let Some(d0_name) =
+            rustc_symbol_mangling::itanium::mangle_dtor_d0(self.tcx, def_id)
+        {
+            emit_trampoline(&d0_name, true);
+        }
+    }
+
