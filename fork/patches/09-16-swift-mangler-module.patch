+//! P09.16 / P09.17 — Swift ABI symbol mangling for `extern "Swift"`
+//! items.
+//!
+//! Routes `extern "Swift"` fn declarations through a Swift mangler
+//! so link names match what `swiftc` produces for functions in a
+//! named Swift module.
+//!
+//! # Phase 1b (scalar subset, P09.16)
+//!
+//! Free functions with scalar param/return types. Module name
+//! from `#[rustc_swift_symbol = "..."]`. All labels unnamed.
+//!
+//! # Phase 2a (user types + labels, P09.17)
+//!
+//! Adds:
+//!
+//! - **User Swift value types** via `#[rustc_swift_type =
+//!   "Module.TypeName"]` on the Rust struct. Emitted as
+//!   `AA<len><name>V` (when the type lives in the same module
+//!   the current fn resolves to) or `s<len><name>V` (for stdlib
+//!   types).
+//! - **Back-references** for types that reappear in a signature.
+//!   Each type emitted in full form consumes three substitution
+//!   slots (identifier, nominal context, value type); back-refs
+//!   target the value-type slot as `A<letter>` where
+//!   `A=0, B=1, ..., Z=25`. Values >25 require multi-char
+//!   encoding (deferred to Phase 2b).
+//! - **Parameter labels** via `#[rustc_swift_labels = "_, by"]`.
+//!   Tokens are comma-separated; `_` is unnamed, anything else
+//!   is a named label `<len><name>`. Omit the attribute for
+//!   all-unnamed (emits `y`).
+//!
+//! # Grammar (validated against `swiftc` 6.2 + `swift-demangle`)
+//!
+//! ```text
+//! MangledSymbol := $s <Module> <Name> <Labels>? <Sig> F
+//! Labels        := y                            // all unnamed
+//!                | LabelSpec+                   // one per param
+//! LabelSpec     := _ | <Len><Chars>
+//! Sig           := <RetType> <Params>
+//! RetType       := <Type>                       // y = Void
+//! Params        := y                            // ()
+//!                | <Type>                       // single, no tuple
+//!                | <T1>_<T2>[_<T3>...]t         // 2+ tuple
+//! Type          := Si | Su | Sd | Sf | Sb | y
+//!                | <FullForm>                   // on first occurrence
+//!                | A<letter>                    // back-ref to earlier type
+//! FullForm      := AA<Len><Name>V               // same-module value type
+//!                | s<Len><Name>V                // stdlib value type
+//! ```
+//!
+//! Scalar compression: 2+ consecutive identical single-letter
+//! stdlib types collapse to `S<N><letter>`. Phase 2a limitations:
+//! multi-char substitution indices (>25 distinct types in one
+//! signature) and run-length compression of back-refs (3+
+//! consecutive identical user types) are deferred.
+
+use rustc_abi::ExternAbi;
+use rustc_hir::def::DefKind;
+use rustc_middle::ty::{self, Instance, Ty, TyCtxt};
+use rustc_span::Symbol;
+use rustc_span::def_id::DefId;
+
+/// True when `def_id` is a fn item inside an `extern "Swift"`
+/// block with a `#[rustc_swift_symbol = "..."]` attribute.
+pub(crate) fn is_swift_abi<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> bool {
+    if !matches!(tcx.def_kind(def_id), DefKind::Fn | DefKind::AssocFn) {
+        return false;
+    }
+    let sig = tcx.fn_sig(def_id).skip_binder().skip_binder();
+    matches!(sig.abi(), ExternAbi::Swift { .. })
+        && swift_module_name(tcx, def_id).is_some()
+}
+
+fn swift_module_name<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> Option<Symbol> {
+    rustc_hir::find_attr!(
+        tcx, def_id, RustcSwiftSymbol { module, .. } => *module
+    )
+}
+
+fn swift_labels<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> Option<Symbol> {
+    rustc_hir::find_attr!(
+        tcx, def_id, RustcSwiftLabels { labels, .. } => *labels
+    )
+}
+
+/// Swift binding for a Rust ADT: `module`, `type_name`, kind.
+/// `is_class` is true for reference-type classes (mangle as `C`
+/// suffix), false for value-type structs/enums (`V` suffix).
+fn swift_type_binding<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    adt_did: DefId,
+) -> Option<(Symbol, Symbol, bool)> {
+    rustc_hir::find_attr!(
+        tcx, adt_did, RustcSwiftType { module, name, is_class, .. } => (*module, *name, *is_class)
+    )
+}
+
+/// Representation of a mangleable Swift type, in a form we can
+/// canonicalize for back-reference tracking.
+#[derive(Clone, PartialEq, Eq, Hash)]
+enum SwiftType {
+    /// Void / empty tuple.
+    Void,
+    /// Single-letter stdlib scalar: "Si", "Sd", etc.
+    Scalar(&'static str),
+    /// User value type in a module: (module, name).
+    UserValue(Symbol, Symbol),
+    /// User class (reference type) in a module: (module, name).
+    /// Mangles as `AA<len><name>C` instead of `...V`.
+    UserClass(Symbol, Symbol),
+}
+
+struct Mangler {
+    out: String,
+    /// Substitution slots. Slot 0 is the current module. Each
+    /// full-form user or stdlib type emission appends 3 slots
+    /// (identifier, nominal context, value type). Back-refs
+    /// target the index stored here.
+    ///
+    /// We don't need the actual slot contents — just the count —
+    /// to compute the next back-ref index for a newly-seen type.
+    slots: usize,
+    /// Canonical-name → slot-index (of the value-type slot) for
+    /// types already emitted in the current signature.
+    known: Vec<(SwiftType, usize)>,
+}
+
+impl Mangler {
+    fn new() -> Self {
+        // Slot 0 = current module. It's emitted as `$s<len><mod>`
+        // in the mangled-name prefix, but occupies slot 0 in the
+        // substitution table.
+        Self { out: String::new(), slots: 1, known: Vec::new() }
+    }
+
+    /// Emit a type, using a back-ref if it's been seen before.
+    ///
+    /// Scalar types (`Si`, `Sd`, `Sf`, `Sb`, `y`) are pre-registered
+    /// Swift shortcuts and don't consume substitution slots —
+    /// they emit in full each time (and get `S<N><t>` compression
+    /// for consecutive runs via `compress_consecutive`). Only
+    /// user-defined types participate in back-reference
+    /// substitution.
+    fn emit(&mut self, ty: &SwiftType) {
+        match ty {
+            SwiftType::Void => {
+                self.out.push('y');
+                return;
+            }
+            SwiftType::Scalar(code) => {
+                self.out.push_str(code);
+                return;
+            }
+            SwiftType::UserValue(_module, name) | SwiftType::UserClass(_module, name) => {
+                if let Some(&(_, idx)) = self.known.iter().find(|(t, _)| t == ty) {
+                    if let Some(letter) = idx_to_letter(idx) {
+                        self.out.push('A');
+                        self.out.push(letter);
+                        return;
+                    }
+                    // idx > 25 — fall through to full form.
+                }
+                let n = name.as_str();
+                let kind = if matches!(ty, SwiftType::UserClass(..)) { 'C' } else { 'V' };
+                // `AA<len><name><kind>`: `AA` = back-ref to slot 0
+                // (current module) + same-module marker; `<len>
+                // <name>` is the identifier; `<kind>` is `V` for
+                // value type, `C` for class. Consumes 3 slots.
+                self.out.push('A');
+                self.out.push('A');
+                self.out.push_str(&n.len().to_string());
+                self.out.push_str(n);
+                self.out.push(kind);
+                self.known.push((ty.clone(), self.slots + 2));
+                self.slots += 3;
+            }
+        }
+    }
+}
+
+/// Encode an index as a single letter A-Z (0-25). Returns None
+/// for indices that need multi-char encoding (Phase 2b).
+fn idx_to_letter(idx: usize) -> Option<char> {
+    if idx <= 25 { Some((b'A' + idx as u8) as char) } else { None }
+}
+
+/// Mangle `instance` as a Swift symbol. Returns `None` if the
+/// signature uses a type the mangler can't encode.
+pub(crate) fn mangle<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    instance: Instance<'tcx>,
+) -> Option<String> {
+    let def_id = instance.def_id();
+    let module = swift_module_name(tcx, def_id)?;
+    let name = tcx.item_name(def_id);
+
+    let sig = tcx.fn_sig(def_id).skip_binder().skip_binder();
+
+    // Translate Rust types to SwiftType descriptions.
+    let ret_ty = ty_to_swift(tcx, sig.output())?;
+    let param_tys: Vec<SwiftType> = sig
+        .inputs()
+        .iter()
+        .map(|ty| ty_to_swift(tcx, *ty))
+        .collect::<Option<Vec<_>>>()?;
+
+    // Labels encoding: emit `y` when labels attribute says
+    // all-unnamed (or none given), else emit the tokenized
+    // label list. BUT: when the function has no params, Swift
+    // omits the labels slot entirely — `make_counter() ->
+    // Counter` mangles as `...AA7CounterCyF` (labels elided)
+    // not `...yAA7CounterCyF`.
+    let labels_str = swift_labels(tcx, def_id)
+        .map(|s| s.as_str().to_string());
+    let labels = if param_tys.is_empty() {
+        String::new()
+    } else {
+        match &labels_str {
+            None => "y".to_string(),
+            Some(s) if all_unnamed(s) => "y".to_string(),
+            Some(s) => encode_labels(s),
+        }
+    };
+
+    // Build signature. Return type first, then params (with
+    // back-ref tracking for repeats).
+    let mut m = Mangler::new();
+    m.emit(&ret_ty);
+    match param_tys.len() {
+        0 => m.out.push('y'),
+        1 => m.emit(&param_tys[0]),
+        _ => {
+            for (i, p) in param_tys.iter().enumerate() {
+                if i > 0 {
+                    m.out.push('_');
+                }
+                m.emit(p);
+            }
+            m.out.push('t');
+        }
+    }
+
+    // Scalar run-length compression (`SiSi` → `S2i`). Only
+    // applies to the compressed stdlib-scalar portion — user
+    // types use `A<letter>` back-refs which use a separate
+    // run-length scheme below.
+    let compressed = compress_consecutive(&m.out);
+
+    // Back-ref run-length compression: runs of 3+ consecutive
+    // identical `A<letter>` back-refs compress to `<first>_A<N>
+    // <letter>` — the first instance stays standalone, the
+    // remaining N ≥ 2 collapse into one `A<N><letter>` token
+    // (no internal `_` separators). Matches Swift's output for
+    // signatures like `func f(A, A, A, A) -> A` where the
+    // return-type full-form seeds the substitution and the four
+    // identical params emit as `AX_A3X`.
+    let compressed = compress_backref_runs(&compressed);
+
+    let module_str = module.as_str();
+    let name_str = name.as_str();
+    Some(format!(
+        "$s{mlen}{m}{nlen}{n}{labels}{sig}F",
+        mlen = module_str.len(),
+        m = module_str,
+        nlen = name_str.len(),
+        n = name_str,
+        labels = labels,
+        sig = compressed,
+    ))
+}
+
+fn all_unnamed(labels: &str) -> bool {
+    labels.split(',').all(|t| t.trim() == "_")
+}
+
+fn encode_labels(labels: &str) -> String {
+    let mut out = String::new();
+    for tok in labels.split(',') {
+        let t = tok.trim();
+        if t == "_" {
+            out.push('_');
+        } else {
+            out.push_str(&t.len().to_string());
+            out.push_str(t);
+        }
+    }
+    out
+}
+
+/// Map a rustc `Ty` to its SwiftType description. Returns
+/// `None` for unsupported types.
+fn ty_to_swift<'tcx>(tcx: TyCtxt<'tcx>, ty: Ty<'tcx>) -> Option<SwiftType> {
+    match ty.kind() {
+        ty::Tuple(tys) if tys.is_empty() => Some(SwiftType::Void),
+        ty::Bool => Some(SwiftType::Scalar("Sb")),
+        ty::Int(int_ty) => match int_ty {
+            ty::IntTy::I64 => Some(SwiftType::Scalar("Si")),
+            _ => None,
+        },
+        ty::Uint(uint_ty) => match uint_ty {
+            ty::UintTy::U64 => Some(SwiftType::Scalar("Su")),
+            _ => None,
+        },
+        ty::Float(float_ty) => match float_ty {
+            ty::FloatTy::F32 => Some(SwiftType::Scalar("Sf")),
+            ty::FloatTy::F64 => Some(SwiftType::Scalar("Sd")),
+            _ => None,
+        },
+        ty::Ref(_, pointee, _) => {
+            // Rust `&T` for Swift value types: Swift's ABI
+            // passes values by inline copy (for POD) or via
+            // its own indirection scheme (for non-trivial).
+            // Phase 2a only supports pass-by-value of trivial
+            // types — dereference the ref and recurse.
+            ty_to_swift(tcx, *pointee)
+        }
+        ty::Adt(def, _) => {
+            // Phase 2a requires both `#[repr(swift)]` (gating
+            // marker) and `#[rustc_swift_type]` (binding to the
+            // Swift-side qualified name). Missing either is
+            // caller responsibility — fall back to None so the
+            // mangler surfaces a type it can't encode.
+            if !def.repr().swift() {
+                return None;
+            }
+            let (module, name, is_class) = swift_type_binding(tcx, def.did())?;
+            Some(if is_class {
+                SwiftType::UserClass(module, name)
+            } else {
+                SwiftType::UserValue(module, name)
+            })
+        }
+        _ => None,
+    }
+}
+
+/// Fold consecutive identical stdlib-scalar codes into
+/// `S<N><letter>`. Preserves `_` and `t` separators.
+fn compress_consecutive(input: &str) -> String {
+    let bytes = input.as_bytes();
+    let mut out = String::with_capacity(input.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        if i + 1 < bytes.len() && bytes[i] == b'S' && (bytes[i + 1] as char).is_ascii_lowercase() {
+            let letter = bytes[i + 1];
+            let mut count = 1;
+            let mut j = i + 2;
+            while j + 1 < bytes.len() && bytes[j] == b'S' && bytes[j + 1] == letter {
+                count += 1;
+                j += 2;
+            }
+            if count >= 2 {
+                out.push('S');
+                out.push_str(&count.to_string());
+                out.push(letter as char);
+                i = j;
+                continue;
+            }
+        }
+        out.push(bytes[i] as char);
+        i += 1;
+    }
+    out
+}
+
+/// Run-length compress consecutive identical `A<letter>`
+/// back-refs. Input: a string fragment that may contain
+/// `A<letter>(_A<same-letter>)+` patterns. Output: the same
+/// semantic form with runs of 3+ collapsed to
+/// `<first>_A<count-minus-1><letter>`.
+///
+/// Matches Swift's behavior: the first instance of a repeated
+/// back-ref in a tuple stays standalone; the remaining N ≥ 2
+/// identical back-refs compress. For N = 1 follower we leave
+/// the pair uncompressed (`AX_AX`) because the compressed form
+/// `AX_A1X` is the same length.
+fn compress_backref_runs(input: &str) -> String {
+    let bytes = input.as_bytes();
+    let mut out = String::with_capacity(input.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        // Detect `A<uppercase>` at position i.
+        if bytes[i] == b'A'
+            && i + 1 < bytes.len()
+            && (bytes[i + 1] as char).is_ascii_uppercase()
+        {
+            let letter = bytes[i + 1];
+            // Count `_A<letter>` follow-ups at i+2, i+5, i+8, ...
+            let mut followups = 0;
+            let mut j = i + 2;
+            while j + 2 < bytes.len()
+                && bytes[j] == b'_'
+                && bytes[j + 1] == b'A'
+                && bytes[j + 2] == letter
+            {
+                followups += 1;
+                j += 3;
+            }
+            // Also handle the case where bytes[j..j+3] is the
+            // final three bytes of the string (j + 2 == len - 1).
+            if j + 2 == bytes.len()
+                && bytes[j] == b'_'
+                && bytes[j + 1] == b'A'
+                && bytes[j + 2] == letter
+            {
+                followups += 1;
+                j += 3;
+            }
+            if followups >= 2 {
+                // Emit first, then separator, then compressed run.
+                out.push('A');
+                out.push(letter as char);
+                out.push('_');
+                out.push('A');
+                out.push_str(&followups.to_string());
+                out.push(letter as char);
+                i = j;
+                continue;
+            }
+        }
+        out.push(bytes[i] as char);
+        i += 1;
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{compress_backref_runs, compress_consecutive};
+
+    #[test]
+    fn compresses_pairs() {
+        assert_eq!(compress_consecutive("SiSi"), "S2i");
+        assert_eq!(compress_consecutive("SdSd"), "S2d");
+        assert_eq!(compress_consecutive("SfSfSf"), "S3f");
+    }
+
+    #[test]
+    fn preserves_underscores_and_t() {
+        assert_eq!(compress_consecutive("SiSi_Sit"), "S2i_Sit");
+        assert_eq!(compress_consecutive("SiSi_SdSd"), "S2i_S2d");
+    }
+
+    #[test]
+    fn leaves_singletons_alone() {
+        assert_eq!(compress_consecutive("Si"), "Si");
+        assert_eq!(compress_consecutive("y"), "y");
+    }
+
+    #[test]
+    fn mixed_runs() {
+        assert_eq!(compress_consecutive("SiSdSd_Si"), "SiS2d_Si");
+    }
+
+    #[test]
+    fn does_not_compress_backrefs() {
+        // Back-refs like `AD` shouldn't get "compressed" by the
+        // stdlib-scalar compressor.
+        assert_eq!(compress_consecutive("AD_AD"), "AD_AD");
+    }
+
+    #[test]
+    fn backref_runs_compresses_triples() {
+        // Three identical back-refs: first standalone, then
+        // `_A2D` for the two follow-ups.
+        assert_eq!(compress_backref_runs("AD_AD_AD"), "AD_A2D");
+    }
+
+    #[test]
+    fn backref_runs_compresses_quads() {
+        // Four identical: matches Swift's
+        // `$s1B4intsys4Int8VAD_A3DtF` pattern (param tuple).
+        assert_eq!(compress_backref_runs("AD_AD_AD_AD"), "AD_A3D");
+    }
+
+    #[test]
+    fn backref_runs_leaves_pairs() {
+        // Two identical don't compress — `AD_A1D` and `AD_AD`
+        // are the same length, so no savings.
+        assert_eq!(compress_backref_runs("AD_AD"), "AD_AD");
+    }
+
+    #[test]
+    fn backref_runs_with_tuple_terminator() {
+        // Tuple form — `t` after the last element. The `t`
+        // stays untouched.
+        assert_eq!(compress_backref_runs("AD_AD_AD_ADt"), "AD_A3Dt");
+    }
+
+    #[test]
+    fn backref_runs_handles_different_letters() {
+        // AD then AE — different letters don't form a run.
+        assert_eq!(compress_backref_runs("AD_AE_AD"), "AD_AE_AD");
+    }
+
+    #[test]
+    fn backref_runs_ignores_non_backrefs() {
+        // Plain text without back-refs is unchanged.
+        assert_eq!(compress_backref_runs("s4Int8V"), "s4Int8V");
+    }
+}
