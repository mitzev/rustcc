@@ -68,7 +68,7 @@ pub(crate) fn is_swift_abi<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> bool {
         return false;
     }
     let sig = tcx.fn_sig(def_id).skip_binder().skip_binder();
