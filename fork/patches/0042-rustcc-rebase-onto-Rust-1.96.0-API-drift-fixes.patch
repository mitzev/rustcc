-use rustc_hir::LangItem;
 use rustc_index::IndexVec;
 use rustc_middle::mir::*;
 use rustc_middle::ty::{self, Ty, TyCtxt};
@@ -405,8 +404,10 @@ fn resolve_from_cxx_raw_error_impl<'tcx>(
     err_ty: Ty<'tcx>,
     raw_err_ty: Ty<'tcx>,
 ) -> Option<ty::Instance<'tcx>> {
-    // Build the trait ref `E: From<CxxRawError>`.
-    let from_trait_did = tcx.lang_items().get(LangItem::From)?;
+    // Build the trait ref `E: From<CxxRawError>`. On 1.96.0 `From` is a
+    // diagnostic item (it became a lang item later), so resolve it that
+    // way rather than via `LangItem::From`.
+    let from_trait_did = tcx.get_diagnostic_item(sym::From)?;
     let trait_ref = ty::TraitRef::new(tcx, from_trait_did, [err_ty, raw_err_ty]);
 
     // Select the impl.
diff --git a/compiler/rustc_symbol_mangling/src/itanium.rs b/compiler/rustc_symbol_mangling/src/itanium.rs
index 81f9a82744a..fa56e8ab730 100644
--- a/compiler/rustc_symbol_mangling/src/itanium.rs
+++ b/compiler/rustc_symbol_mangling/src/itanium.rs
@@ -606,7 +606,7 @@ pub(crate) fn is_cpp_abi<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> bool {
         return false;
     }
     let sig = tcx.fn_sig(def_id).skip_binder().skip_binder();
-    if matches!(sig.abi(), ExternAbi::Cpp { .. }) {
+    if matches!(sig.abi, ExternAbi::Cpp { .. }) {
         return true;
     }
     if cxx_impl_class(tcx, def_id).is_some() {
@@ -757,13 +757,13 @@ pub(crate) fn mangle<'tcx>(
         ret,
         cv,
         ref_q: None,
-        variadic: fn_sig.c_variadic(),
+        variadic: fn_sig.c_variadic,
         // `extern "C++"` without `-unwind` is `noexcept`; with it,
         // not. For inferred methods the fn sig carries Rust ABI,
         // so fall through to `false` — linkage-wise this is a
         // don't-care (Itanium doesn't encode noexcept for regular
         // free/member function symbols).
-        noexcept: matches!(fn_sig.abi(), ExternAbi::Cpp { unwind: false }),
+        noexcept: matches!(fn_sig.abi, ExternAbi::Cpp { unwind: false }),
     };
 
     let sym = if let Some(class_did) = class_adt {
diff --git a/compiler/rustc_symbol_mangling/src/swift.rs b/compiler/rustc_symbol_mangling/src/swift.rs
index b51f01cd3d6..b241e5e93c6 100644
