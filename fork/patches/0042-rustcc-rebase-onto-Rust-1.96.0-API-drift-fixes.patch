 compiler/rustc_codegen_ssa/src/mir/block.rs              | 9 ++++++++-
 compiler/rustc_mir_transform/src/cxx_throws_wrap.rs      | 7 ++++---
 compiler/rustc_symbol_mangling/src/itanium.rs            | 6 +++---
 compiler/rustc_symbol_mangling/src/swift.rs              | 2 +-
 5 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/compiler/rustc_attr_parsing/src/attributes/codegen_attrs.rs b/compiler/rustc_attr_parsing/src/attributes/codegen_attrs.rs
index ff56eaa612b..ea773c6bb94 100644
--- a/compiler/rustc_attr_parsing/src/attributes/codegen_attrs.rs
+++ b/compiler/rustc_attr_parsing/src/attributes/codegen_attrs.rs
@@ -737,6 +737,11 @@ macro_rules! rustcc_noargs_attr {
 
         impl<S: Stage> NoArgsAttributeParser<S> for $parser {
             const PATH: &[Symbol] = &[sym::$sym];
+            // 1.96.0: `NoArgsAttributeParser` requires `ON_DUPLICATE`
+            // (defaulted away after 1.96). These internal fork attrs are
+            // single-use markers; error on a duplicate, like other
+            // no-args parsers.
+            const ON_DUPLICATE: OnDuplicate<S> = OnDuplicate::Error;
             const ALLOWED_TARGETS: AllowedTargets =
                 AllowedTargets::AllowList(&[$(Allow($target)),+]);
             const CREATE: fn(Span) -> AttributeKind = AttributeKind::$kind;
diff --git a/compiler/rustc_codegen_ssa/src/mir/block.rs b/compiler/rustc_codegen_ssa/src/mir/block.rs
index 8f84e5adc9a..4d3b05ce0fc 100644
--- a/compiler/rustc_codegen_ssa/src/mir/block.rs
+++ b/compiler/rustc_codegen_ssa/src/mir/block.rs
@@ -1249,10 +1249,17 @@ fn codegen_call_terminator(
             let original_ret_ty = self.monomorphize(sig.output().skip_binder());
             if bridged_ret_ty != original_ret_ty {
                 let sig_inner = sig.skip_binder();
+                // 1.96.0: `mk_fn_sig` is 5-arg and `FnSig` exposes
+                // `c_variadic`/`safety`/`abi` as fields (1.97 bundled
+                // them into `fn_sig_kind` + a 3-arg ctor). Preserve the
+                // original sig's variadic/safety/abi, only swapping the
+                // (Result-unwrapped) return type.
                 let new_sig_inner = bx.tcx().mk_fn_sig(
                     sig_inner.inputs().iter().copied(),
                     bridged_ret_ty,
-                    sig_inner.fn_sig_kind,
+                    sig_inner.c_variadic,
+                    sig_inner.safety,
+                    sig_inner.abi,
                 );
                 let bridged_sig = sig.rebind(new_sig_inner);
                 let bridged = bx.fn_abi_of_fn_ptr(bridged_sig, extra_args);
diff --git a/compiler/rustc_mir_transform/src/cxx_throws_wrap.rs b/compiler/rustc_mir_transform/src/cxx_throws_wrap.rs
