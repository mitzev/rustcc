diff --git a/compiler/rustc_codegen_llvm/src/context.rs b/compiler/rustc_codegen_llvm/src/context.rs
index e94611a4f4c..16c617b0c85 100644
--- a/compiler/rustc_codegen_llvm/src/context.rs
+++ b/compiler/rustc_codegen_llvm/src/context.rs
@@ -1001,6 +1001,53 @@ fn cxx_typeinfo_personality(&self) -> &'ll Value {
         self.declare_cfn(name, llvm::UnnamedAddr::Global, fty)
     }
 
+    fn cxx_typedesc_global_msvc(&self, name: &str) -> &'ll Value {
+        // P09.68-msvc / 1.13 throws Phase 2C: synthesize an
+        // MSVC TypeDescriptor for the given mangled type name.
+        //
+        // Layout (matches what cl/clang-cl produce for C++
+        // RTTI on MSVC x64):
+        //
+        //   struct TypeDescriptor {
+        //     void* vtable;     // -> ??_7type_info@@6B@
+        //     void* decoration; // null spare
+        //     char  name[];     // mangled name + '\0'
+        //   };
+        //
+        // The MSVC runtime matches catch clauses by STRING
+        // comparing the `name` field across modules, so each
+        // module synthesizes its own TypeDescriptor copy. We
+        // give it linkonce_odr + comdat to collapse duplicates
+        // at link time but allow different modules to define
+        // their own. Symbol name encodes the mangled type to
+        // keep duplicates colliding correctly.
+        //
+        // Cache by name within the CGU so multiple catch
+        // clauses for the same type reuse one global.
+        let sym = format!("__rustcc_msvc_typedesc.{name}");
+        if let Some(existing) = self.get_declared_value(&sym) {
+            return existing;
+        }
+        let vtable = self.declare_global("??_7type_info@@6B@", self.type_ptr());
+        // Append '\0' to the mangled name so the C runtime's
+        // string compare terminates correctly.
+        let mut bytes = Vec::with_capacity(name.len() + 1);
+        bytes.extend_from_slice(name.as_bytes());
+        bytes.push(0);
+        let name_const = self.const_bytes(&bytes);
+        let typedesc = self.const_struct(
+            &[vtable, self.const_null(self.type_ptr()), name_const],
+            /* packed: */ false,
+        );
+        let tydesc_global = self.declare_global(&sym, self.val_ty(typedesc));
+        llvm::set_linkage(tydesc_global, llvm::Linkage::LinkOnceODRLinkage);
+        if self.tcx.sess.target.supports_comdat() {
+            llvm::SetUniqueComdat(self.llmod, tydesc_global);
+        }
+        llvm::set_initializer(tydesc_global, typedesc);
+        tydesc_global
+    }
