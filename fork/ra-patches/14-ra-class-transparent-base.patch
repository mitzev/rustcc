+// rustcc 1.13.6 (RA parity): base-class FIELDS also appear in
+// dot-completion on a derived receiver (transparent base access).
+#[test]
+fn completes_inherited_class_fields_via_dot() {
+    check_no_kw(
+        r#"
+class Animal {
+    legs: u32,
+    fn walk(&self) {}
+}
+class Dog : Animal {
+    tail: bool,
+}
+fn use_dog(d: Dog) {
+    d.$0
+}
+"#,
+        expect![[r#"
+            fd legs         u32
+            fd tail        bool
+            me walk() fn(&self)
+        "#]],
+    );
+}
