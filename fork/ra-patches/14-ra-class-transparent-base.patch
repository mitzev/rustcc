+/// rustcc (1.13.6 RA parity): the base type of a `class D : B { ... }`,
+/// lowered in `D`'s generic context (so its generic args reference
+/// `D`'s parameters). `None` for a root class. The fork rustc gives a
+/// derived class transparent base-member access by synthesizing
+/// `impl Deref for D { type Target = B; ... }`; RA models `class`
+/// natively (no synthetic impl), so field resolution instead walks the
+/// base chain via this helper — instantiate the returned binder with
+/// the derived class's args to get the concrete base type, then look
+/// the member up there.
+pub fn class_base_ty<'db>(
+    db: &'db dyn HirDatabase,
+    class_id: ClassId,
+) -> Option<EarlyBinder<'db, Ty<'db>>> {
+    use hir_def::signatures::ClassSignature;
+    let sig = ClassSignature::of(db, class_id);
+    let base_ref = sig.base?;
+    let resolver = class_id.resolver(db);
+    let mut ctx = TyLoweringContext::new(
+        db,
+        &resolver,
+        &sig.store,
+        AdtId::ClassId(class_id).into(),
+        LifetimeElisionKind::AnonymousReportError,
+    );
+    Some(EarlyBinder::bind(ctx.lower_ty(base_ref)))
+}
+
 /// Build the type of all specific fields of a struct or enum variant.
 #[salsa::tracked(returns(ref))]
 pub(crate) fn field_types_with_diagnostics_query<'db>(
diff --git a/crates/hir-ty/src/tests/method_resolution.rs b/crates/hir-ty/src/tests/method_resolution.rs
index 2ed33ba3c..d41f0c6f9 100644
--- a/crates/hir-ty/src/tests/method_resolution.rs
+++ b/crates/hir-ty/src/tests/method_resolution.rs
@@ -2319,3 +2319,83 @@ fn use_dog(d: Dog) {
 "#,
     );
 }
+
+// rustcc 1.13.6 (RA parity): transparent base-FIELD access. The fork
+// compiler gives a derived class auto-Deref to its base subobject, so
+// `self.base_field` resolves; RA walks the `#[rustc_cxx_base]` chain in
+// field resolution to match.
+#[test]
+fn class_inherited_field_access() {
+    check_types(
+        r#"
+class Animal {
+    legs: u32,
+    fn walk(&self) {}
+}
+class Dog : Animal {
+    tail: bool,
+}
+fn use_dog(d: Dog) {
+    let a = d.legs;
+      //^ u32
+    let b = d.tail;
+      //^ bool
+}
+"#,
+    );
+}
+
+// Grandparent field reached through a two-level chain.
+#[test]
+fn class_multilevel_field_access() {
+    check_types(
+        r#"
+class A { a: u32 }
+class B : A { b: u64 }
+class C : B { c: i8 }
+fn use_c(c: C) {
+    let x = c.a;
+      //^ u32
+    let y = c.b;
+      //^ u64
+    let z = c.c;
+      //^ i8
+}
+"#,
+    );
+}
+
+// Generic base: the base field type must be substituted with the
+// derived class's args (`G<T>`'s `v: T` becomes `u32` for `D<u32>`).
+#[test]
+fn class_generic_base_field_access() {
+    check_types(
+        r#"
+class G<T> { v: T }
+class D<T> : G<T> { extra: T }
+fn use_d(d: D<u32>) {
+    let x = d.v;
+      //^ u32
+    let y = d.extra;
+      //^ u32
+}
+"#,
+    );
+}
+
+// A derived field shadows a same-named base field (C++ name-hiding):
+// the derived one wins because field lookup checks the derived class
+// before walking to the base.
+#[test]
+fn class_derived_shadows_base_field() {
+    check_types(
+        r#"
+class A { x: u32 }
+class B : A { x: u64 }
+fn use_b(b: B) {
+    let v = b.x;
+      //^ u64
+}
+"#,
+    );
+}
diff --git a/crates/hir/src/lib.rs b/crates/hir/src/lib.rs
index f02dab799..61e229960 100644
--- a/crates/hir/src/lib.rs
+++ b/crates/hir/src/lib.rs
@@ -6135,14 +6135,35 @@ impl<'db> Type<'db> {
             _ => return Vec::new(),
         };
 
-        db.field_types(variant_id)
+        let mut fields: Vec<(Field, Self)> = db
+            .field_types(variant_id)
             .iter()
             .map(|(local_id, ty)| {
                 let def = Field { parent: variant_id.into(), id: local_id };
                 let ty = ty.get().instantiate(interner, substs);
                 (def, self.derived(ty))
             })
-            .collect()
+            .collect();
+
+        // rustcc 1.13.6 (RA parity): for a `class D : B`, also surface
+        // base-class fields so they appear in dot-completion (matching
+        // the compiler's transparent base access). Recurse on the base
+        // type — which is concrete here, so multi-level chains and
+        // generic bases substitute correctly — and dedup by name so a
+        // derived field hides a same-named base field (C++ name-hiding).
+        if let VariantId::ClassId(class_id) = variant_id
+            && let Some(base_binder) = hir_ty::class_base_ty(db, class_id)
+        {
+            let base_ty = base_binder.instantiate(interner, substs);
+            for (bf, bty) in self.derived(base_ty).fields(db) {
+                let bname = bf.name(db);
+                if !fields.iter().any(|(f, _)| f.name(db) == bname) {
+                    fields.push((bf, bty));
+                }
+            }
+        }
+
+        fields
     }
 
     pub fn tuple_fields(&self, _db: &'db dyn HirDatabase) -> Vec<Self> {
