+/// rustcc 1.13.6 (RA parity): resolve a field `name` on a `class`,
+/// walking the `#[rustc_cxx_base]` base chain when it isn't declared
+/// directly on `class_id`. Returns the resolved `FieldId` together
+/// with the generic args of the (possibly base) class that declares
+/// it, so the caller instantiates the field type with the correct
+/// substitution. This mirrors the compiler's transparent base-member
+/// access (auto-Deref to the `__base` subobject): RA models `class`
+/// natively with no synthetic Deref impl, so we walk the chain here.
+/// A field declared directly wins over a base field of the same name
+/// (C++ name-hiding), since we check the derived class first.
+fn resolve_class_field_chain<'db>(
+    db: &'db dyn crate::db::HirDatabase,
+    interner: DbInterner<'db>,
+    class_id: hir_def::ClassId,
+    parameters: GenericArgs<'db>,
+    name: &Name,
+) -> Option<(FieldId, GenericArgs<'db>)> {
+    if let Some(local_id) = class_id.fields(db).field(name) {
+        return Some((FieldId { parent: class_id.into(), local_id }, parameters));
+    }
+    let base_ty = crate::lower::class_base_ty(db, class_id)?.instantiate(interner, parameters);
+    match base_ty.kind() {
+        TyKind::Adt(base_adt, base_args) => match base_adt.def_id().0 {
+            hir_def::AdtId::ClassId(base_c) => {
+                resolve_class_field_chain(db, interner, base_c, base_args, name)
+            }
+            _ => None,
+        },
+        _ => None,
+    }
+}
+
 impl<'db> InferenceContext<'_, 'db> {
     pub(crate) fn infer_expr(
         &mut self,
@@ -1637,10 +1669,15 @@ impl<'db> InferenceContext<'_, 'db> {
                     hir_def::AdtId::EnumId(_) => return None,
                     // rustcc Phase 2 (B.4): record-shaped class field
                     // access mirrors struct field access.
+                    // rustcc 1.13.6 (RA parity): if the field isn't
+                    // declared directly on the class, walk the
+                    // `#[rustc_cxx_base]` base chain so base members are
+                    // reachable transparently (`self.base_field`) —
+                    // mirroring the compiler's auto-Deref. The base type
+                    // is lowered + substituted per level so generic
+                    // bases resolve correctly.
                     hir_def::AdtId::ClassId(c) => {
-                        let local_id = c.fields(self.db).field(name)?;
-                        let field = FieldId { parent: c.into(), local_id };
-                        (field, parameters)
+                        resolve_class_field_chain(self.db, interner, c, parameters, name)?
                     }
                 },
                 _ => return None,
