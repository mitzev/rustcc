@@ -185,6 +181,20 @@ impl<'db> Ctx<'db> {
         Some(ast_id)
     }
 
+    // rustcc Phase 2 (B.2): mirror of `lower_struct`. A `class` has
+    // record-style fields (curly-brace member list) so we don't carry
+    // a FieldsShape on the item-tree entry — downstream consumers
+    // (ClassSignature, VariantFields) hard-code Record for ClassId.
+    fn lower_class(&mut self, klass: &ast::Class) -> Option<ItemTreeAstId<Class>> {
+        let visibility = self.lower_visibility(klass);
+        let name = klass.name()?.as_name();
+        let ast_id = self.source_ast_id_map.ast_id(klass);
+        let res = Class { name, visibility };
+        self.tree.small_data.insert(ast_id.upcast(), SmallModItem::Class(res));
+
+        Some(ast_id)
+    }
+
     fn lower_union(&mut self, union: &ast::Union) -> Option<ItemTreeAstId<Union>> {
         let visibility = self.lower_visibility(union);
         let name = union.name()?.as_name();
