+// rustcc Phase 2 (B.2): signature for `class Foo { ... }`. Mirrors
+// StructSignature but specializes a few details for v0:
+//   - `shape` is always FieldsShape::Record (a class member-list is
+//     curly-brace, never tuple/unit).
+//   - lang-item-driven StructFlags (PhantomData, Box, ManuallyDrop,
+//     UnsafeCell, UnsafePinned) are not detected — those are
+//     standard-library-internal markers that classes shouldn't
+//     impersonate. We still pick up RUSTC_HAS_INCOHERENT_INHERENT_IMPLS,
+//     FUNDAMENTAL, and HAS_REPR so the rest of the trait-solver
+//     plumbing keeps working uniformly across AdtId variants.
+#[derive(Debug, PartialEq, Eq)]
+pub struct ClassSignature {
+    pub name: Name,
+    pub generic_params: GenericParams,
+    pub store: ExpressionStore,
+    pub flags: StructFlags,
+    pub shape: FieldsShape,
+}
+
+#[salsa::tracked]
+impl ClassSignature {
+    #[salsa::tracked(returns(deref))]
+    pub fn of(db: &dyn DefDatabase, id: ClassId) -> Arc<Self> {
+        Self::with_source_map(db, id).0.clone()
+    }
+
+    #[salsa::tracked(returns(ref))]
+    pub fn with_source_map(
+        db: &dyn DefDatabase,
+        id: ClassId,
+    ) -> (Arc<Self>, ExpressionStoreSourceMap) {
+        let loc = id.lookup(db);
+        let InFile { file_id, value: source } = loc.source(db);
+        let attrs = AttrFlags::query(db, id.into());
+
+        let mut flags = StructFlags::empty();
+        if attrs.contains(AttrFlags::RUSTC_HAS_INCOHERENT_INHERENT_IMPLS) {
+            flags |= StructFlags::RUSTC_HAS_INCOHERENT_INHERENT_IMPLS;
+        }
+        if attrs.contains(AttrFlags::FUNDAMENTAL) {
+            flags |= StructFlags::FUNDAMENTAL;
+        }
+        if attrs.contains(AttrFlags::HAS_REPR) {
+            flags |= StructFlags::HAS_REPR;
+        }
+
+        let (store, generic_params, source_map) = lower_generic_params(
+            db,
+            loc.container,
+            id.into(),
+            file_id,
+            source.generic_param_list(),
+            source.where_clause(),
+        );
+        (
+            Arc::new(ClassSignature {
+                generic_params,
+                store,
+                flags,
+                shape: FieldsShape::Record,
+                name: as_name_opt(source.name()),
+            }),
+            source_map,
+        )
+    }
+}
+
+impl ClassSignature {
+    #[inline]
+    pub fn repr(&self, db: &dyn DefDatabase, id: ClassId) -> Option<ReprOptions> {
+        if self.flags.contains(StructFlags::HAS_REPR) {
+            AttrFlags::repr(db, id.into())
+        } else {
+            None
+        }
+    }
+}
+
 #[derive(Debug, PartialEq, Eq)]
 pub struct UnionSignature {
