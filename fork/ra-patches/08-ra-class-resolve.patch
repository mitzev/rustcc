diff --git a/crates/hir-def/src/attrs.rs b/crates/hir-def/src/attrs.rs
index b611a0a39..a6ccc1e8a 100644
--- a/crates/hir-def/src/attrs.rs
+++ b/crates/hir-def/src/attrs.rs
@@ -487,6 +487,28 @@ fn collect_field_attrs<T>(
         ast::VariantDef::Struct(it) => it.field_list(),
         ast::VariantDef::Union(it) => it.record_field_list().map(ast::FieldList::RecordFieldList),
         ast::VariantDef::Variant(it) => it.field_list(),
+        // rustcc Phase 2 (B.4): a class is record-shaped — its
+        // CLASS_MEMBER_LIST::fields() returns AstChildren<RecordField>,
+        // so we walk those directly rather than going through
+        // ast::FieldList. (CLASS_MEMBER_LIST is *not* a RECORD_FIELD_LIST
+        // syntactically, so we can't reuse the FieldList wrapper.)
+        ast::VariantDef::Class(it) => {
+            let mut result = ArenaMap::new();
+            let mut idx = 0;
+            if let Some(ml) = it.class_member_list() {
+                for field in ml.fields() {
+                    if AttrFlags::is_cfg_enabled_for(&field, cfg_options).is_ok() {
+                        result.insert(
+                            la_arena::Idx::from_raw(la_arena::RawIdx::from_u32(idx)),
+                            field_attrs(cfg_options, variant_syntax.with_value(field.into())),
+                        );
+                        idx += 1;
+                    }
+                }
+            }
+            result.shrink_to_fit();
+            return result;
+        }
     };
     let Some(fields) = fields else {
         return ArenaMap::new();
