+    fn legs(&self) -> u32 { 4 }$0
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn implement_override_not_applicable_without_base() {
+        // No `: Base` clause — nothing to override.
+        check_assist_not_applicable(
+            implement_class_override,
+            r#"
+class Standalone {$0
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn implement_override_not_applicable_outside_body() {
+        // Cursor on the header — `generate_class_new` owns this spot.
+        check_assist_not_applicable(
