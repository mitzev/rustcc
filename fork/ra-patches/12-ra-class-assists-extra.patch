+}
+
+class Dog : Mammal {$0
+}
+"#,
+            r#"
+class Animal {
+    fn legs(&self) -> u32 { 4 }
+}
+
+class Mammal : Animal {
+    fn fur(&self) -> bool { true }
+}
+
+class Dog : Mammal {
+    fn fur(&self) -> bool {
+        todo!()
+    }
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn implement_override_skips_already_overridden() {
+        // `legs` is already defined in `Dog`, so the assist should
+        // not offer it. The chain has only `legs`, so nothing is
+        // applicable.
+        check_assist_not_applicable(
+            implement_class_override,
+            r#"
