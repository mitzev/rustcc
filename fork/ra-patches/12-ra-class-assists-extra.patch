@@ -1921,6 +1921,77 @@ impl Class {
     pub fn is_unstable(self, db: &dyn HirDatabase) -> bool {
         AttrFlags::query(db, self.id.into()).contains(AttrFlags::IS_UNSTABLE)
     }
+
+    /// rustcc Phase 2 (B.5b): direct base class of `class Foo : Bar`,
+    /// or `None` if the class has no `:` clause or the base does not
+    /// resolve to another class. Mirrors the resolution logic used by
+    /// hir-ty's `base_class_of` helper but exposed at the `hir` API
+    /// boundary so the IDE layer can walk inheritance chains.
+    pub fn base_class(self, db: &dyn HirDatabase) -> Option<Class> {
+        use hir_def::{
+            resolver::{HasResolver, TypeNs},
+            type_ref::TypeRef,
+        };
+        let sig = ClassSignature::of(db, self.id);
+        let base_ref_id = sig.base?;
+        let type_ref = &sig.store[base_ref_id];
+        let path = match type_ref {
+            TypeRef::Path(path) => path,
+            _ => return None,
+        };
+        let resolver = self.id.resolver(db);
+        let (resolution, _, _) = resolver.resolve_path_in_type_ns(db, path)?;
+        match resolution {
+            TypeNs::AdtId(AdtId::ClassId(it)) => Some(Class { id: it }),
+            _ => None,
+        }
+    }
+
+    /// rustcc Phase 2 (B.5b): walk the full inheritance chain starting
+    /// at `self.base_class()` (i.e. *not* including `self`). Stops at
+    /// the root or the first cycle.
+    pub fn ancestors(self, db: &dyn HirDatabase) -> Vec<Class> {
+        let mut out = Vec::new();
+        let mut seen = FxHashSet::default();
+        seen.insert(self.id);
+        let mut cur = self.base_class(db);
+        while let Some(c) = cur {
+            if !seen.insert(c.id) {
+                break;
+            }
+            out.push(c);
+            cur = c.base_class(db);
+        }
+        out
+    }
+
+    /// rustcc Phase 2 (B.5b): inherent assoc items declared in the
+    /// class body (methods, consts, type aliases). Mirrors
+    /// `Trait::items` / `Impl::items` for IDE callers.
+    pub fn items(self, db: &dyn HirDatabase) -> Vec<AssocItem> {
+        self.id
+            .class_items(db)
+            .items
+            .iter()
+            .map(|(_, id)| AssocItem::from(*id))
+            .collect()
+    }
+
+    /// rustcc Phase 2 (B.5b): walk every class declared in `krate`,
+    /// across all modules. Used by IDE features that need a workspace
+    /// scan (e.g. "find all overriders").
+    pub fn all_in_crate(db: &dyn HirDatabase, krate: Crate) -> Vec<Class> {
+        let mut out = Vec::new();
+        let def_map = crate_def_map(db, krate.id);
+        for (_, module) in def_map.modules() {
+            for decl in module.scope.declarations() {
+                if let ModuleDefId::AdtId(AdtId::ClassId(id)) = decl {
+                    out.push(Class { id });
+                }
+            }
+        }
+        out
+    }
 }
 
