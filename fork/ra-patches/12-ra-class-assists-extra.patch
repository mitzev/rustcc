@@ -0,0 +1,248 @@
+//! rustcc fork (P09.46-B5b): "Find all overriders" navigation.
+//!
+//! Given a method declared inside a `class Foo { ... }` body, walk every
+//! class in the workspace and return descendants that declare a method of
+//! the same name. The result is a list of `NavigationTarget`s pointing at
+//! the overriding methods, suitable for the IDE's "Find all overriders"
+//! entry point (modeled on "Go to implementation" for traits but
+//! specialized to the class inheritance chain).
+//!
+//! Inheritance is walked through `hir::Class::ancestors()`, which uses
+//! the same `ClassSignature::base` resolution as hir-ty's method probe
+//! (B.4b/c). A class `D` "overrides" `Base::m` iff:
+//!   - `D` declares a method named `m` directly in its body, *and*
+//!   - the target's class appears somewhere in `D`'s ancestor chain.
+//!
+//! We intentionally don't filter by `#[cpp_virtual]` here — the fork
+//! treats that attribute as opaque, and any same-named method in a
+//! subclass is a legitimate override candidate from the IDE's
+//! navigation perspective. Callers that want a virtual-only filter can
+//! post-process the results.
+
+use hir::{AsAssocItem, AssocItemContainer, Semantics};
+use ide_db::{
+    RootDatabase,
+    defs::{Definition, NameClass, NameRefClass},
+    helpers::pick_best_token,
+};
+use syntax::{AstNode, SyntaxKind::*, T, ast};
+
+use crate::{FilePosition, NavigationTarget, RangeInfo, TryToNav};
+
+// Feature: Find Class Overriders
+//
+// Navigates to subclass methods that override a method declared in a
+// `class Foo { ... }` body. Mirrors "Go to implementation" but walks the
+// rustcc class inheritance chain instead of trait impls.
+pub(crate) fn find_class_overriders(
+    db: &RootDatabase,
+    FilePosition { file_id, offset }: FilePosition,
+) -> Option<RangeInfo<Vec<NavigationTarget>>> {
+    let sema = Semantics::new(db);
+    let source_file = sema.parse_guess_edition(file_id);
+    let syntax = source_file.syntax().clone();
+
+    let original_token = pick_best_token(syntax.token_at_offset(offset), |kind| match kind {
+        IDENT | T![self] => 1,
+        _ => 0,
+    })?;
+    let range = original_token.text_range();
+
+    let navs: Vec<NavigationTarget> = sema
+        .descend_into_macros_exact(original_token)
+        .iter()
+        .filter_map(|token| {
+            let def = token
+                .parent()
+                .and_then(ast::NameLike::cast)
+                .and_then(|node| match &node {
+                    ast::NameLike::Name(name) => {
+                        NameClass::classify(&sema, name).and_then(|class| match class {
+                            NameClass::Definition(it) | NameClass::ConstReference(it) => Some(it),
+                            NameClass::PatFieldShorthand { .. } => None,
+                        })
+                    }
+                    ast::NameLike::NameRef(name_ref) => NameRefClass::classify(&sema, name_ref)
+                        .and_then(|class| match class {
+                            NameRefClass::Definition(def, _) => Some(def),
+                            NameRefClass::FieldShorthand { .. }
+                            | NameRefClass::ExternCrateShorthand { .. } => None,
+                        }),
+                    ast::NameLike::Lifetime(_) => None,
+                })?;
+            let func = match def {
+                Definition::Function(f) => f,
+                _ => return None,
+            };
+            let assoc = func.as_assoc_item(sema.db)?;
+            let target_class = match assoc.container(sema.db) {
+                AssocItemContainer::Class(c) => c,
+                _ => return None,
+            };
+            let name = func.name(sema.db);
+            Some(collect_overriders(&sema, target_class, name))
+        })
+        .flatten()
+        .collect();
+
+    Some(RangeInfo { range, info: navs })
+}
+
+fn collect_overriders(
+    sema: &Semantics<'_, RootDatabase>,
+    target_class: hir::Class,
+    method_name: hir::Name,
+) -> Vec<NavigationTarget> {
+    let db = sema.db;
+    let krate = target_class.module(db).krate(db);
+    let mut out = Vec::new();
+    for class in hir::Class::all_in_crate(db, krate) {
+        if class == target_class {
+            continue;
+        }
+        // Class is a descendant iff target_class is in its ancestor chain.
+        if !class.ancestors(db).iter().any(|a| *a == target_class) {
+            continue;
+        }
+        // And it must declare a method of the same name in its own body.
+        for item in class.items(db) {
+            if let hir::AssocItem::Function(f) = item
+                && f.name(db) == method_name
+                && let Some(navs) = f.try_to_nav(sema)
+            {
+                out.extend(navs);
+            }
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use ide_db::FileRange;
+    use itertools::Itertools;
+
+    use crate::fixture;
+
+    #[track_caller]
+    fn check(#[rust_analyzer::rust_fixture] ra_fixture: &str) {
+        let (analysis, position, expected) = fixture::annotations(ra_fixture);
+
+        let navs = analysis
+            .find_class_overriders(position)
+            .unwrap()
+            .expect("find_class_overriders returned None")
+            .info;
+
+        let cmp = |frange: &FileRange| (frange.file_id, frange.range.start());
+
+        let actual = navs
+            .into_iter()
+            .map(|nav| FileRange { file_id: nav.file_id, range: nav.focus_or_full_range() })
+            .sorted_by_key(cmp)
+            .collect::<Vec<_>>();
+        let expected =
+            expected.into_iter().map(|(range, _)| range).sorted_by_key(cmp).collect::<Vec<_>>();
+        assert_eq!(expected, actual);
+    }
+
+    #[track_caller]
+    fn check_empty(#[rust_analyzer::rust_fixture] ra_fixture: &str) {
+        let (analysis, position, _) = fixture::annotations(ra_fixture);
+        let navs = analysis.find_class_overriders(position).unwrap();
+        let info = navs.map(|r| r.info).unwrap_or_default();
+        assert!(info.is_empty(), "expected no overriders, got {info:?}");
+    }
+
+    #[test]
+    fn finds_direct_subclass_override() {
+        check(
+            r#"
+class Animal {
+    fn legs$0(&self) -> u32 { 4 }
+}
+
+class Dog : Animal {
+    fn legs(&self) -> u32 { 4 }
+     //^^^^
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn finds_grandchild_overrider() {
+        check(
+            r#"
+class Animal {
+    fn legs$0(&self) -> u32 { 4 }
+}
+
+class Dog : Animal {
+}
+
+class Puppy : Dog {
+    fn legs(&self) -> u32 { 4 }
+     //^^^^
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn finds_multiple_overriders() {
+        check(
+            r#"
+class Animal {
+    fn legs$0(&self) -> u32 { 4 }
+}
+
+class Dog : Animal {
+    fn legs(&self) -> u32 { 4 }
+     //^^^^
+}
+
+class Cat : Animal {
+    fn legs(&self) -> u32 { 4 }
+     //^^^^
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn skips_unrelated_class_with_same_method_name() {
+        // `Robot` is not a subclass of `Animal`, so its `legs` is not
+        // an override.
+        check(
+            r#"
+class Animal {
+    fn legs$0(&self) -> u32 { 4 }
+}
+
+class Robot {
+    fn legs(&self) -> u32 { 2 }
+}
+
+class Dog : Animal {
+    fn legs(&self) -> u32 { 4 }
+     //^^^^
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn not_applicable_on_struct_method() {
+        // The cursor is on a method declared in an `impl Foo {}` block,
+        // not inside a class body.
+        check_empty(
+            r#"
+struct Foo;
+impl Foo {
+    fn bar$0(&self) {}
+}
+"#,
+        );
+    }
+}
