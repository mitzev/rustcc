index 000000000..f8fba4a4d
--- /dev/null
+++ b/crates/ide-assists/src/handlers/implement_class_override.rs
@@ -0,0 +1,317 @@
+//! rustcc fork (P09.46-B5b): "Implement override" assist for classes.
+//!
+//! Given a cursor inside a `class Dog : Animal { ... }` body, this assist
+//! walks the inheritance chain (`hir::Class::ancestors`) and offers one
+//! assist per inherited method that isn't yet overridden in the
+//! subclass. Each assist inserts a stub `fn` at the end of the class
+//! member list.
+//!
+//! The generated body is intentionally minimal — `todo!()` — so the user
+//! always has a clean refinement target. Synthesizing the upcast call
+//! (`self.as_animal().legs()`) is left to the user because the cross-base
+//! accessor is fork-specific and `cxx_importer` lowering currently rewrites
+//! the body anyway. A `#[cpp_virtual]` marker is emitted to mirror the
+//! base method when present; otherwise no attribute is emitted.
+//!
+//! The shape is modeled on rust-analyzer's `add_missing_impl_members`
+//! trait-impl assist: it walks the "trait" (here: ancestor chain), filters
+//! by what's already implemented, and emits one assist per missing item.
+
+use hir::{AssocItem, HasSource};
+use stdx::format_to;
+use syntax::{
+    AstNode, NodeOrToken, SyntaxKind, T,
+    ast::{self, edit::IndentLevel},
+};
+
+use crate::{AssistContext, AssistId, Assists};
+
+// Assist: implement_class_override
+//
+// Inserts a stub override for an inherited class method that is not yet
+// overridden in the subclass. One assist offer per inherited method.
+//
+// ```
+// class Animal {
+//     fn legs(&self) -> u32 { 4 }
+// }
+//
+// class Dog : Animal {$0
+// }
+// ```
+// ->
+// ```
+// class Animal {
+//     fn legs(&self) -> u32 { 4 }
+// }
+//
+// class Dog : Animal {
+//     fn legs(&self) -> u32 {
+//         todo!()
+//     }
+// }
+// ```
+pub(crate) fn implement_class_override(
+    acc: &mut Assists,
+    ctx: &AssistContext<'_>,
+) -> Option<()> {
+    let class = ctx.find_node_at_offset::<ast::Class>()?;
+    let member_list = class.class_member_list()?;
+
+    // Cursor must be inside the member list curly braces — otherwise we'd
+    // fire on the class header itself, which shadows `generate_class_new`.
+    let offset = ctx.offset();
+    if !member_list.syntax().text_range().contains_inclusive(offset) {
+        return None;
+    }
+
+    // Need a base class to override anything from.
+    if class.extends_clause().is_none() {
+        return None;
+    }
+
+    // Resolve the class to hir so we can walk inheritance + items.
+    let hir_class = ctx.sema.to_def(&class)?;
+    let ancestors = hir_class.ancestors(ctx.db());
+    if ancestors.is_empty() {
+        return None;
+    }
+
+    // Names already declared directly in this class — these are the
+    // overrides we should skip offering.
+    let already_declared: Vec<hir::Name> = hir_class
+        .items(ctx.db())
+        .into_iter()
+        .filter_map(|it| match it {
+            AssocItem::Function(f) => Some(f.name(ctx.db())),
+            _ => None,
+        })
+        .collect();
+
+    // Collect (function, declaring class) pairs from the chain. Closer
+    // ancestors win — once we've seen a name, deeper ancestors don't
+    // re-offer it (mirrors the shadowing the method-resolution probe
+    // applies in B.4c).
+    let mut seen = already_declared.clone();
+    let mut candidates: Vec<(hir::Function, hir::Class)> = Vec::new();
+    for ancestor in ancestors {
+        for item in ancestor.items(ctx.db()) {
+            if let AssocItem::Function(f) = item {
+                let name = f.name(ctx.db());
+                if seen.iter().any(|s| *s == name) {
+                    continue;
+                }
+                seen.push(name);
+                candidates.push((f, ancestor));
+            }
+        }
+    }
+
+    if candidates.is_empty() {
+        return None;
+    }
+
+    // Find the insertion point — just before the closing `}` of the
+    // member list, with class-level indentation.
+    let r_curly = member_list.r_curly_token()?;
+    let class_indent = IndentLevel::from_node(class.syntax());
+    let body_indent = class_indent + 1;
+
+    for (func, _ancestor) in candidates {
+        let func_name = func.name(ctx.db()).symbol().to_string();
+        // Pull the source AST for the base method to copy its signature
+        // verbatim. If we can't get it, fall back to a minimal stub.
+        let signature = source_signature(ctx, func)
+            .unwrap_or_else(|| format!("fn {func_name}(&self)"));
+
+        let has_cpp_virtual_attr = source_has_cpp_virtual(ctx, func);
+
+        // Compose the inserted text. We position it just before the
+        // closing curly brace; an extra leading newline keeps spacing
+        // consistent if the body already has trailing methods.
+        let assist_label = format!("Implement override for `{func_name}`");
+        let target = class.syntax().text_range();
+
+        // Capture the values we need into the closure.
+        let r_curly_offset = r_curly.text_range().start();
+        let signature_for_closure = signature.clone();
+        acc.add(
+            AssistId::generate("implement_class_override"),
+            assist_label,
+            target,
+            move |builder| {
+                let mut out = String::new();
+                // Leading newline so we don't crowd the previous item.
+                format_to!(out, "{body_indent}");
+                if has_cpp_virtual_attr {
+                    format_to!(out, "#[cpp_virtual]\n{body_indent}");
+                }
+                format_to!(out, "{signature_for_closure} {{\n");
+                format_to!(out, "{}todo!()\n", body_indent + 1);
+                format_to!(out, "{body_indent}}}\n");
+                builder.insert(r_curly_offset, out);
+            },
+        );
+    }
+
+    Some(())
+}
+
+/// Best-effort: pull the function's signature from source (`fn name(...)
+/// -> Ret`). Returns the trimmed text up to the body's `{`.
+fn source_signature(ctx: &AssistContext<'_>, func: hir::Function) -> Option<String> {
+    let source = func.source(ctx.db())?;
+    let fn_node = source.value;
+    // Walk the FN node's children, taking everything before the body.
+    let mut sig = String::new();
+    for child in fn_node.syntax().children_with_tokens() {
+        match child {
+            NodeOrToken::Node(n) if n.kind() == SyntaxKind::BLOCK_EXPR => break,
+            NodeOrToken::Token(t) if t.kind() == T!['{'] => break,
+            // Skip outer attributes — we re-emit the cpp_virtual marker
+            // ourselves and don't want to drag along doc comments.
+            NodeOrToken::Node(n) if n.kind() == SyntaxKind::ATTR => continue,
+            NodeOrToken::Token(t) if t.kind() == SyntaxKind::COMMENT => continue,
+            other => sig.push_str(&other.to_string()),
+        }
+    }
+    let trimmed = sig.trim().to_owned();
+    if trimmed.is_empty() {
+        None
+    } else {
+        Some(trimmed)
+    }
+}
+
+/// Returns true if the function source carries a `#[cpp_virtual]`
+/// attribute. The fork treats the attribute as opaque, so we read it at
+/// the syntax level.
+fn source_has_cpp_virtual(ctx: &AssistContext<'_>, func: hir::Function) -> bool {
+    let Some(source) = func.source(ctx.db()) else {
+        return false;
+    };
+    let fn_node = source.value;
+    let attrs = match fn_node.syntax().children().filter_map(ast::Attr::cast).collect::<Vec<_>>() {
+        v if v.is_empty() => return false,
+        v => v,
+    };
+    attrs.iter().any(|a| {
+        a.path()
+            .map(|p| p.syntax().text().to_string().trim() == "cpp_virtual")
+            .unwrap_or(false)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::tests::{check_assist, check_assist_not_applicable};
+
+    use super::*;
+
+    #[test]
+    fn implement_override_basic() {
+        check_assist(
+            implement_class_override,
+            r#"
+class Animal {
+    fn legs(&self) -> u32 { 4 }
+}
+
+class Dog : Animal {$0
+}
+"#,
+            r#"
+class Animal {
+    fn legs(&self) -> u32 { 4 }
+}
+
+class Dog : Animal {
+    fn legs(&self) -> u32 {
+        todo!()
+    }
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn implement_override_walks_grandparent_chain() {
+        check_assist(
+            implement_class_override,
+            r#"
