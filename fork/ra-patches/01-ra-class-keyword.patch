diff --git a/crates/parser/src/grammar/items/adt.rs b/crates/parser/src/grammar/items/adt.rs
index a030190..d8e8e1e 100644
--- a/crates/parser/src/grammar/items/adt.rs
+++ b/crates/parser/src/grammar/items/adt.rs
@@ -52,6 +52,148 @@ fn struct_or_union(p: &mut Parser<'_>, m: Marker, is_struct: bool) {
     m.complete(p, if is_struct { STRUCT } else { UNION });
 }
 
+// rustcc fork: `class Name<Generics>? (: Base)? { fields; methods }`
+// is a weak keyword that the rustcc compiler lowers to a
+// `#[repr(cpp)] struct` + inherent `impl` pair. At parse level we
+// treat the whole thing as a new CLASS syntax node so LSP features
+// can surface it as a first-class item. Body is a mixed sequence
+// of record fields (same shape as `struct` fields) followed by
+// assoc items (methods / consts / types), separated by commas.
+
+// test class_item
+// class Widget { x: i32, pub fn new(x: i32) -> Self { Self { x } } }
+pub(super) fn klass(p: &mut Parser<'_>, m: Marker) {
+    assert!(p.at_contextual_kw(T![class]));
+    p.bump_remap(T![class]);
+    name_r(p, ITEM_RECOVERY_SET);
+    generic_params::opt_generic_param_list(p);
+    if p.at(T![:]) {
+        p.bump(T![:]);
+        types::type_(p);
+    }
+    generic_params::opt_where_clause(p);
+    if p.at(T!['{']) {
+        class_member_list(p);
+    } else {
+        p.error("expected `{`");
+    }
+    m.complete(p, CLASS);
+}
+
+fn class_member_list(p: &mut Parser<'_>) {
+    assert!(p.at(T!['{']));
+    let m = p.start();
+    p.bump(T!['{']);
+    attributes::inner_attrs(p);
+    // Parse members one at a time. For each member we peek past
+    // outer attributes to decide if it looks like a field
+    // (`ident : type`) or a method / other assoc item. Fields
+    // separated by commas; methods are self-terminating items.
+    while !p.at(EOF) && !p.at(T!['}']) {
+        if p.at(T!['{']) {
+            error_block(p, "expected a field or method");
+            continue;
+        }
+        if looks_like_field_at(p) {
+            class_record_field(p);
+            if !p.at(T!['}']) {
+                // Allow `;` as a field separator too (C++ habit).
+                if p.at(T![;]) {
+                    p.bump(T![;]);
+                } else if p.at(T![,]) {
+                    p.bump(T![,]);
+                }
+            }
+        } else {
+            // Delegate to the normal item parser so outer attrs
+            // and all item forms (fn / const / type / macro call)
+            // are handled uniformly. `stop_on_r_curly = true`
+            // keeps the outer `}` for us to consume.
+            item_or_macro(p, true, false);
+        }
+    }
+    p.expect(T!['}']);
+    m.complete(p, CLASS_MEMBER_LIST);
+}
+
+fn class_record_field(p: &mut Parser<'_>) {
+    let m = p.start();
+    attributes::outer_attrs(p);
+    opt_visibility(p, false);
+    if p.at(IDENT) {
+        name(p);
+        p.expect(T![:]);
+        types::type_(p);
+        m.complete(p, RECORD_FIELD);
+    } else {
+        m.abandon(p);
+        p.err_and_bump("expected a field declaration");
+    }
+}
+
+fn looks_like_field_at(p: &Parser<'_>) -> bool {
+    // Skip past leading `#[...]*` attribute groups.
+    let mut i = 0usize;
+    while p.nth(i) == T![#] && p.nth(i + 1) == T!['['] {
+        // Scan balanced brackets to find the matching `]`.
+        i += 2;
+        let mut depth = 1usize;
+        while depth > 0 {
+            match p.nth(i) {
+                T!['['] => depth += 1,
+                T![']'] => depth -= 1,
+                EOF => return false,
+                _ => {}
+            }
+            i += 1;
+            if i > 256 {
+                return false;
+            }
+        }
+    }
+    // Now `i` points at the first non-attr token. A field begins
+    // with optional vis (`pub`, `pub(crate)`, etc.) followed by
+    // `ident :`. Methods begin with a fn modifier keyword.
+    let starts_method = |k: SyntaxKind| {
+        matches!(k, T![fn] | T![unsafe] | T![const] | T![async] | T![type] | T![impl])
+    };
+    let tok = p.nth(i);
+    if starts_method(tok) {
+        return false;
+    }
+    if tok == T![pub] {
+        // `pub fn` / `pub const` → method; `pub(crate) ...` → also
+        // could be either. Look past the visibility.
+        let mut j = i + 1;
+        if p.nth(j) == T!['('] {
+            // pub(crate), pub(super), etc. — scan to matching `)`.
+            let mut depth = 1usize;
+            j += 1;
+            while depth > 0 {
+                match p.nth(j) {
+                    T!['('] => depth += 1,
+                    T![')'] => depth -= 1,
+                    EOF => return false,
+                    _ => {}
+                }
+                j += 1;
+                if j > 256 {
+                    return false;
+                }
+            }
+        }
+        if starts_method(p.nth(j)) {
+            return false;
+        }
+        if p.nth(j) == IDENT && p.nth(j + 1) == T![:] {
+            return true;
+        }
+        return false;
+    }
+    // `ident :` without visibility — a record field.
+    tok == IDENT && p.nth(i + 1) == T![:]
+}
+
 pub(super) fn enum_(p: &mut Parser<'_>, m: Marker) {
     p.bump(T![enum]);
     name_r(p, ITEM_RECOVERY_SET);
