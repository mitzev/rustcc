diff --git a/crates/ide-assists/src/handlers/generate_class_new.rs b/crates/ide-assists/src/handlers/generate_class_new.rs
new file mode 100644
index 000000000..56e7fec14
--- /dev/null
+++ b/crates/ide-assists/src/handlers/generate_class_new.rs
@@ -0,0 +1,280 @@
+//! rustcc fork (P09.46-B5): class-flavored `generate_new`.
+//!
+//! The upstream `generate_new` works on `ast::Struct` and depends on
+//! `Sema::to_def(struct)` for resolving existing `impl` blocks. Until B.4b/c
+//! gives `class` items a real `hir-def` AdtId, the resolved-hir paths
+//! consistently return `None` for class — so a class-specific assist that
+//! sticks to syntax-level manipulation is the pragmatic shape for now.
+//!
+//! This assist offers `Generate constructor for class` on a class header. It
+//! always inserts a brand-new inherent `impl` block after the class with a
+//! `#[constructor]` method named `new`. The `#[constructor]` attribute is a
+//! fork-only marker that downstream tools (e.g. the rustcc cxx_importer
+//! lowering pass) recognize; rust-analyzer treats it as an opaque attribute,
+//! which is fine for the IDE's purposes — the assist scaffolds source the
+//! user can refine.
+//!
+//! Limitations (deliberate):
+//! - We do NOT detect a pre-existing inherent `impl` for the class to splice
+//!   into (would need `to_def`, see above).
+//! - We do NOT detect a pre-existing `new` function (same reason).
+//! - We do NOT walk inheritance to forward base-class fields (B.4b territory).
+//!
+//! When B.4b lands and `to_def(class)` starts returning a real id, this assist
+//! should be revisited and probably folded back into `generate_new`.
+
+use stdx::format_to;
+use syntax::{
+    ast::{self, AstNode, HasGenericParams, HasName, HasVisibility, edit::IndentLevel},
+};
+
+use crate::{AssistContext, AssistId, Assists};
+
+// Assist: generate_class_new
+//
+// Adds a `#[constructor] fn new` for a class.
+//
+// ```
+// class Widget$0 {
+//     x: i32,
+//     y: i32,
+// }
+// ```
+// ->
+// ```
+// class Widget {
+//     x: i32,
+//     y: i32,
+// }
+//
+// impl Widget {
+//     #[constructor]
+//     pub fn new(x: i32, y: i32) -> Self {
+//         Widget { x, y }
+//     }
+// }
+// ```
+pub(crate) fn generate_class_new(acc: &mut Assists, ctx: &AssistContext<'_>) -> Option<()> {
+    let class = ctx.find_node_at_offset::<ast::Class>()?;
+    let name = class.name()?;
+    let member_list = class.class_member_list()?;
+
+    // Collect named fields. Class members can also be methods, but for the
+    // constructor only the field list matters.
+    let fields: Vec<(String, String)> = member_list
+        .fields()
+        .filter_map(|f| Some((f.name()?.to_string(), f.ty()?.syntax().text().to_string())))
+        .collect();
+
+    // Bail if any field has no name or no type — we'd produce broken output.
+    if fields.is_empty() && member_list.fields().next().is_some() {
+        return None;
+    }
+
+    let target = class.syntax().text_range();
+
+    acc.add(
+        AssistId::generate("generate_class_new"),
+        "Generate `new` constructor for class",
+        target,
+        |builder| {
+            let class_indent = IndentLevel::from_node(class.syntax());
+            let body_indent = class_indent + 1;
+            let inner_indent = class_indent + 2;
+
+            // Build `<generics>` for the impl header. We reuse the class's
+            // generic param list verbatim (defaults are illegal in impls but
+            // Phase 2 classes don't carry defaults yet); this matches what
+            // `generate_impl` produces for simple struct cases.
+            let generics = class.generic_param_list().map(|g| g.syntax().text().to_string());
+            let generic_args = class.generic_param_list().map(|g| {
+                let mut s = String::from("<");
+                let parts: Vec<String> = g
+                    .generic_params()
+                    .filter_map(|p| match p {
+                        ast::GenericParam::TypeParam(t) => Some(t.name()?.to_string()),
+                        ast::GenericParam::LifetimeParam(l) => {
+                            Some(l.lifetime()?.syntax().text().to_string())
+                        }
+                        ast::GenericParam::ConstParam(c) => Some(c.name()?.to_string()),
+                    })
+                    .collect();
+                s.push_str(&parts.join(", "));
+                s.push('>');
+                s
+            });
+
+            // Visibility on `new`: mirror class visibility, with a `pub`
+            // default (constructors are typically public).
+            let vis = class.visibility().map_or_else(
+                || "pub ".to_owned(),
+                |v| format!("{} ", v.syntax().text()),
+            );
+
+            let params = fields
+                .iter()
+                .map(|(n, t)| format!("{n}: {t}"))
+                .collect::<Vec<_>>()
+                .join(", ");
+            let init_fields = fields
+                .iter()
+                .map(|(n, _)| n.clone())
+                .collect::<Vec<_>>()
+                .join(", ");
+
+            let impl_header = match (&generics, &generic_args) {
+                (Some(g), Some(ga)) => format!("impl{g} {name}{ga}"),
+                _ => format!("impl {name}"),
+            };
+
+            let mut out = String::new();
+            format_to!(out, "\n\n{class_indent}{impl_header} {{\n");
+            format_to!(out, "{body_indent}#[constructor]\n");
+            format_to!(out, "{body_indent}{vis}fn new({params}) -> Self {{\n");
+            if init_fields.is_empty() {
+                format_to!(out, "{inner_indent}{name} {{}}\n");
+            } else {
+                format_to!(out, "{inner_indent}{name} {{ {init_fields} }}\n");
+            }
+            format_to!(out, "{body_indent}}}\n");
+            format_to!(out, "{class_indent}}}");
+
+            builder.insert(class.syntax().text_range().end(), out);
+        },
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::tests::{check_assist, check_assist_not_applicable};
+
+    use super::*;
+
+    #[test]
+    fn generate_class_new_basic() {
+        check_assist(
+            generate_class_new,
+            r#"
+class Widget$0 {
+    x: i32,
+    y: i32,
+}
+"#,
+            r#"
+class Widget {
+    x: i32,
+    y: i32,
+}
+
+impl Widget {
+    #[constructor]
+    pub fn new(x: i32, y: i32) -> Self {
+        Widget { x, y }
+    }
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn generate_class_new_empty() {
+        check_assist(
+            generate_class_new,
+            r#"
+class Marker$0 {}
+"#,
+            r#"
+class Marker {}
+
+impl Marker {
+    #[constructor]
+    pub fn new() -> Self {
+        Marker {}
+    }
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn generate_class_new_preserves_visibility() {
+        check_assist(
+            generate_class_new,
+            r#"
+pub(crate) class Widget$0 { x: i32 }
+"#,
+            r#"
+pub(crate) class Widget { x: i32 }
+
+impl Widget {
+    #[constructor]
+    pub(crate) fn new(x: i32) -> Self {
+        Widget { x }
+    }
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn generate_class_new_with_generics() {
+        check_assist(
+            generate_class_new,
+            r#"
+class Pair$0<T> { a: T, b: T }
+"#,
+            r#"
+class Pair<T> { a: T, b: T }
+
+impl<T> Pair<T> {
+    #[constructor]
+    pub fn new(a: T, b: T) -> Self {
+        Pair { a, b }
+    }
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn generate_class_new_indented() {
+        check_assist(
+            generate_class_new,
+            r#"
+mod m {
+    class Widget$0 {
+        x: i32,
+    }
+}
+"#,
+            r#"
+mod m {
+    class Widget {
+        x: i32,
+    }
+
+    impl Widget {
+        #[constructor]
+        pub fn new(x: i32) -> Self {
+            Widget { x }
+        }
+    }
+}
+"#,
+        );
+    }
+
+    #[test]
+    fn generate_class_new_not_applicable_on_struct() {
+        // The struct path is owned by upstream `generate_new`; the
+        // class-flavored assist should never fire on a struct cursor.
+        check_assist_not_applicable(
+            generate_class_new,
+            r#"
+struct Widget$0 {
+    x: i32,
+}
+"#,
+        );
+    }
+}
diff --git a/crates/ide-assists/src/handlers/generate_derive.rs b/crates/ide-assists/src/handlers/generate_derive.rs
index 0129b1db3..a9abef792 100644
--- a/crates/ide-assists/src/handlers/generate_derive.rs
+++ b/crates/ide-assists/src/handlers/generate_derive.rs
@@ -219,4 +219,18 @@ struct EvenMoreIrrelevant;
 struct Foo { a: i32, }",
         );
     }
+
+    // rustcc P09.46-B5: classes flow through `ast::Adt::Class` and `HasAttrs`,
+    // so `generate_derive` should hang `#[derive]` on the class header. Whether
+    // any given derive macro actually expands successfully is a separate question
+    // (most stdlib derives are written for `struct`/`enum`); this assist only
+    // scaffolds the attribute.
+    #[test]
+    fn add_derive_to_class() {
+        check_assist(
+            generate_derive,
+            "class Widget { x: i32, $0}",
+            "#[derive($0)]\nclass Widget { x: i32, }",
+        );
+    }
 }
