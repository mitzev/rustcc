+
+    // rustcc P09.46-B5: class-aware coverage. `class` is a fork-only ADT flavor
+    // that flows through `ast::Adt::Class`; `generate_impl` operates on `ast::Adt`
+    // generically, so it should produce an `impl` block with the class's name.
+    #[test]
+    fn test_add_impl_for_class() {
+        check_assist(
+            generate_impl,
+            r#"
+                class Widget$0 { x: i32, y: i32 }
+            "#,
+            r#"
+                class Widget { x: i32, y: i32 }
+
+                impl Widget {$0}
+            "#,
+        );
+    }
+
+    #[test]
+    fn test_add_trait_impl_for_class() {
+        check_assist(
+            generate_trait_impl,
+            r#"
+                class Widget$0 { x: i32, y: i32 }
+            "#,
+            r#"
+                class Widget { x: i32, y: i32 }
+
+                impl ${1:_} for Widget {$0}
+            "#,
+        );
+    }
 }
