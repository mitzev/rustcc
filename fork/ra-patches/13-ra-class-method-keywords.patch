From 57d4ac9dc0e01237e569f96825f363def58ba934 Mon Sep 17 00:00:00 2001
From: rustcc-build <rustcc@localhost>
Date: Wed, 3 Jun 2026 00:59:14 +0300
Subject: [PATCH] P09.x (1.13.5): parse class-body method-modifier keywords
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Teach the class-body parser the C++-style method modifiers added to
the fork rustc in v1.13.5:

    (pub)? (virtual | override | constructor)* fn …

`virtual` / `override` are reserved Rust keywords (VIRTUAL_KW /
OVERRIDE_KW already exist); `constructor` is a new contextual keyword
(CONSTRUCTOR_KW) so a field literally named `constructor` still parses
as a field. In `opt_item` the modifier run is consumed as leading fn
modifiers — only when a `fn` (possibly after more modifiers) follows —
so the class-keyword surface no longer shows false parse errors in the
editor. The modifiers carry no extra semantics in RA (the fork rustc
desugars them to #[cpp_virtual] / #[constructor] /
#[rustc_cxx_override]); RA just needs to accept them.

Adds a `syntax` regression test asserting the keyword forms parse with
zero errors, including a field named `constructor`.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 crates/parser/src/grammar/items.rs         | 27 ++++++++++++++++
 crates/parser/src/syntax_kind/generated.rs |  6 ++++
 crates/syntax/src/tests.rs                 | 37 ++++++++++++++++++++++
 3 files changed, 70 insertions(+)

diff --git a/crates/parser/src/grammar/items.rs b/crates/parser/src/grammar/items.rs
index a7e0cbca7..48886d9c7 100644
--- a/crates/parser/src/grammar/items.rs
+++ b/crates/parser/src/grammar/items.rs
@@ -138,6 +138,33 @@ pub(super) fn opt_item(p: &mut Parser<'_>, m: Marker, is_in_extern: bool) -> Res
         has_mods = true;
     }
 
+    // rustcc fork (v1.13.5): C++-style method modifiers inside a
+    // `class` body — `(virtual | override | constructor)* fn`.
+    // `virtual` / `override` are reserved keywords; `constructor` is
+    // contextual. The fork rustc desugars them to
+    // #[cpp_virtual] / #[constructor] / #[rustc_cxx_override]; here we
+    // just consume them as leading fn modifiers so the editor doesn't
+    // flag the class-keyword surface. Each is only a modifier when a
+    // `fn` (possibly after more modifiers) follows — so a field
+    // literally named `constructor` is never mis-parsed.
+    while p.at(T![virtual]) || p.at(T![override]) || p.at_contextual_kw(T![constructor]) {
+        let followed_by_fn_or_mod = p.nth_at(1, T![fn])
+            || p.nth_at(1, T![virtual])
+            || p.nth_at(1, T![override])
+            || p.nth_at_contextual_kw(1, T![constructor]);
+        if !followed_by_fn_or_mod {
+            break;
+        }
+        if p.at(T![virtual]) {
+            p.bump(T![virtual]);
+        } else if p.at(T![override]) {
+            p.bump(T![override]);
+        } else {
+            p.bump_remap(T![constructor]);
+        }
+        has_mods = true;
+    }
+
     // modifiers
     if p.at(T![const]) && p.nth(1) != T!['{'] {
         p.eat(T![const]);
