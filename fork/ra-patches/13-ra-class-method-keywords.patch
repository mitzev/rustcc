@@ -738,6 +740,7 @@ impl SyntaxKind {
             CFG_ATTR_KW => true,
             CLASS_KW => true,
             CLOBBER_ABI_KW => true,
+            CONSTRUCTOR_KW => true,
             DEFAULT_KW => true,
             DYN_KW if edition < Edition::Edition2018 => true,
             FORMAT_ARGS_KW => true,
@@ -832,6 +835,7 @@ impl SyntaxKind {
             CFG_ATTR_KW => true,
             CLASS_KW => true,
             CLOBBER_ABI_KW => true,
+            CONSTRUCTOR_KW => true,
             DEFAULT_KW => true,
             DYN_KW if edition < Edition::Edition2018 => true,
             FORMAT_ARGS_KW => true,
@@ -989,6 +993,7 @@ impl SyntaxKind {
             "cfg_attr" => CFG_ATTR_KW,
             "class" => CLASS_KW,
             "clobber_abi" => CLOBBER_ABI_KW,
+            "constructor" => CONSTRUCTOR_KW,
             "default" => DEFAULT_KW,
             "dyn" if edition < Edition::Edition2018 => DYN_KW,
             "format_args" => FORMAT_ARGS_KW,
@@ -1164,6 +1169,7 @@ macro_rules ! T_ {
     [cfg_attr] => { $ crate :: SyntaxKind :: CFG_ATTR_KW };
     [class] => { $ crate :: SyntaxKind :: CLASS_KW };
     [clobber_abi] => { $ crate :: SyntaxKind :: CLOBBER_ABI_KW };
+    [constructor] => { $ crate :: SyntaxKind :: CONSTRUCTOR_KW };
     [default] => { $ crate :: SyntaxKind :: DEFAULT_KW };
     [dyn] => { $ crate :: SyntaxKind :: DYN_KW };
     [format_args] => { $ crate :: SyntaxKind :: FORMAT_ARGS_KW };
diff --git a/crates/syntax/src/tests.rs b/crates/syntax/src/tests.rs
index e5beb44f4..2207ea11d 100644
--- a/crates/syntax/src/tests.rs
+++ b/crates/syntax/src/tests.rs
@@ -25,6 +25,43 @@ fn main() {
     assert!(parse.ok().is_ok());
 }
 
+#[test]
+fn rustcc_class_method_modifiers_parse_clean() {
+    // rustcc fork (v1.13.5): C++-style method-modifier keywords inside
+    // a `class` body — `(pub)? (virtual | override | constructor)* fn`.
+    // `virtual` / `override` are reserved keywords; `constructor` is
+    // contextual, so a field literally named `constructor` must still
+    // parse as a field. None of these should produce parse errors.
+    let code = r#"
+pub class Base {
+    constructor: i32,
+    val: i32,
+
+    constructor fn new(v: i32) -> Self { Self { constructor: 0, val: v } }
+
+    virtual fn poke(&self) -> i32 { self.val }
+
+    pub virtual fn doubled(&self) -> i32 { self.val * 2 }
+}
+
+pub class Derived : Base {
+    extra: i32,
+
+    constructor fn new(v: i32, e: i32) -> Self {
+        Self { __base: Base::new(v), extra: e }
+    }
+
+    pub override fn poke(&self) -> i32 { self.__base.val + self.extra }
+}
+"#;
+    let parse = SourceFile::parse(code, Edition::CURRENT);
+    let errors = parse.errors();
+    assert!(
+        errors.is_empty(),
+        "expected no parse errors for class method-modifier keywords, got: {errors:?}"
+    );
+}
+
 #[test]
 fn benchmark_parser() {
     if std::env::var("RUN_SLOW_BENCHES").is_err() {
