+
+// rustcc Phase 2 (B.4b): direct test that `ClassSignature::base` is
+// populated when a class has `: Parent`, and stays None otherwise.
+// This bypasses the pretty-printer (no class printer wired yet) and
+// pokes the signature directly via the same lowering path the rest
+// of hir-def uses, so it exercises the exact codepath assists/IDE
+// queries hit.
+#[test]
+fn class_signature_base() {
+    use crate::{
+        AdtId, ModuleDefId,
+        nameres::crate_def_map,
+        signatures::ClassSignature,
+        test_db::TestDB,
+    };
+    use test_fixture::WithFixture;
+
+    let db = TestDB::with_files(
+        r#"
+class Animal {}
+class Dog : Animal {}
+class Cat {}
+"#,
+    );
+
+    let krate = db.fetch_test_crate();
+    let def_map = crate_def_map(&db, krate);
+    let mut by_name: std::collections::HashMap<String, crate::ClassId> =
+        std::collections::HashMap::new();
+    for (_, module) in def_map.modules() {
+        for decl in module.scope.declarations() {
+            if let ModuleDefId::AdtId(AdtId::ClassId(id)) = decl {
+                let sig = ClassSignature::of(&db, id);
+                by_name.insert(sig.name.as_str().to_owned(), id);
+            }
+        }
+    }
+
+    let dog = by_name.get("Dog").copied().expect("class Dog declared");
+    let dog_sig = ClassSignature::of(&db, dog);
+    assert!(dog_sig.base.is_some(), "class Dog : Animal should have base populated");
+
+    let animal = by_name.get("Animal").copied().expect("class Animal declared");
+    let animal_sig = ClassSignature::of(&db, animal);
+    assert!(animal_sig.base.is_none(), "class Animal has no parent");
+
+    let cat = by_name.get("Cat").copied().expect("class Cat declared");
+    let cat_sig = ClassSignature::of(&db, cat);
+    assert!(cat_sig.base.is_none(), "class Cat has no parent");
+}
