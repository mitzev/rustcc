diff --git a/crates/hir-def/src/expr_store/lower.rs b/crates/hir-def/src/expr_store/lower.rs
index fd8b50d71..0eeda57b5 100644
--- a/crates/hir-def/src/expr_store/lower.rs
+++ b/crates/hir-def/src/expr_store/lower.rs
@@ -264,6 +264,34 @@ pub(crate) fn lower_trait(
     (store, source_map, params)
 }
 
+// rustcc Phase 2 (B.4b): lower a `class Foo : Bar { ... }` signature.
+// Mirrors `lower_trait`/`lower_type_alias`: shares one `ExprCollector`
+// so the generic-params store and the base-type `TypeRefId` live in
+// the same `ExpressionStore`. The base is `None` for a class without
+// `: Parent`. Lowering uses `lower_type_ref_opt_disallow_impl_trait`
+// because `class Foo : impl Trait {}` is not meaningful here.
+pub(crate) fn lower_class(
+    db: &dyn DefDatabase,
+    module: ModuleId,
+    class_syntax: InFile<ast::Class>,
+    class_id: crate::ClassId,
+) -> (ExpressionStore, ExpressionStoreSourceMap, GenericParams, Option<TypeRefId>) {
+    let mut expr_collector = ExprCollector::signature(db, module, class_syntax.file_id);
+    let base = class_syntax
+        .value
+        .extends_clause()
+        .map(|ty| expr_collector.lower_type_ref_disallow_impl_trait(ty));
+    let mut collector = generics::GenericParamsCollector::new(class_id.into());
+    collector.lower(
+        &mut expr_collector,
+        class_syntax.value.generic_param_list(),
+        class_syntax.value.where_clause(),
+    );
+    let params = collector.finish();
+    let (store, source_map) = expr_collector.store.finish();
+    (store, source_map, params, base)
+}
+
