diff --git a/crates/hir-def/src/expr_store/tests/signatures.rs b/crates/hir-def/src/expr_store/tests/signatures.rs
index d26c94fdc..fb2d5b1dd 100644
--- a/crates/hir-def/src/expr_store/tests/signatures.rs
+++ b/crates/hir-def/src/expr_store/tests/signatures.rs
@@ -262,3 +262,71 @@ class Cat {}
     let cat_sig = ClassSignature::of(&db, cat);
     assert!(cat_sig.base.is_none(), "class Cat has no parent");
 }
+
+// rustcc Phase 2 (B.4c): direct test that methods declared inside a
+// class body are reachable via `ClassId::class_items` and that their
+// `FunctionLoc.container` reports the class as
+// `ItemContainerId::ClassId(_)`. This is the load-bearing invariant
+// for inherent-method dispatch in hir-ty.
+#[test]
+fn class_items_walks_methods_with_class_container() {
+    use crate::{
+        AdtId, AssocItemId, ItemContainerId, Lookup, ModuleDefId, nameres::crate_def_map,
+        signatures::ClassSignature, test_db::TestDB,
+    };
+    use test_fixture::WithFixture;
+
+    let db = TestDB::with_files(
+        r#"
+class Widget {
+    fn click(&self) -> u32 { 0 }
+    fn label(&self) -> u32 { 1 }
+    const KIND: u32 = 7;
+}
+"#,
+    );
+
+    let krate = db.fetch_test_crate();
+    let def_map = crate_def_map(&db, krate);
+    let mut widget = None;
+    for (_, module) in def_map.modules() {
+        for decl in module.scope.declarations() {
+            if let ModuleDefId::AdtId(AdtId::ClassId(id)) = decl {
+                let sig = ClassSignature::of(&db, id);
+                if sig.name.as_str() == "Widget" {
+                    widget = Some(id);
+                }
+            }
+        }
+    }
+    let widget = widget.expect("class Widget declared");
+
+    let items = widget.class_items(&db);
+    let names: Vec<_> = items.items.iter().map(|(n, _)| n.as_str().to_owned()).collect();
+    assert_eq!(names, vec!["click", "label", "KIND"]);
+
+    // Each function's container must be ClassId(widget).
+    let click = items.method_by_name(&hir_expand::name::Name::new_symbol_root(
+        intern::Symbol::intern("click"),
+    ));
+    let click = click.expect("click method present");
+    let click_loc = click.lookup(&db);
+    match click_loc.container {
+        ItemContainerId::ClassId(c) if c == widget => {}
+        other => panic!("click container should be ClassId(Widget), got {other:?}"),
+    }
+
+    // const KIND too — same story for ConstId.
+    let kind_assoc = items.assoc_item_by_name(&hir_expand::name::Name::new_symbol_root(
+        intern::Symbol::intern("KIND"),
+    ));
+    match kind_assoc {
+        Some(AssocItemId::ConstId(c)) => {
+            match c.lookup(&db).container {
+                ItemContainerId::ClassId(cl) if cl == widget => {}
+                other => panic!("KIND container should be ClassId(Widget), got {other:?}"),
+            }
+        }
+        other => panic!("expected const KIND, got {other:?}"),
+    }
+}
