+// rustcc Phase 2 (B.4c): assoc items declared inside a class body.
+// Mirrors `ImplItems` but the container is `ItemContainerId::ClassId`,
+// so the resulting `FunctionId` / `ConstId` / `TypeAliasId` lookups
+// report the class as their direct container.
+#[derive(Debug, PartialEq, Eq)]
+pub struct ClassItems {
+    pub items: Box<[(Name, AssocItemId)]>,
+    pub macro_calls: ThinVec<(AstId<ast::Item>, MacroCallId)>,
+}
+
+#[salsa::tracked]
+impl ClassItems {
+    #[salsa::tracked(returns(ref))]
+    pub fn of(db: &dyn DefDatabase, id: ClassId) -> (ClassItems, DefDiagnostics) {
+        let _p = tracing::info_span!("class_items_with_diagnostics_query").entered();
+        let ItemLoc { container: module_id, id: ast_id } = id.lookup(db);
+
+        let collector = AssocItemCollector::new(
+            db,
+            module_id,
+            ItemContainerId::ClassId(id),
+            ast_id.file_id,
+        );
+        let source = ast_id.with_value(collector.ast_id_map.get(ast_id.value)).to_node(db);
+        // Walk the class member list's `methods()` iterator. The
+        // member list is a `ClassMemberList`, distinct from the
+        // `ast::AssocItemList` that traits/impls use, so we feed the
+        // raw iterator into `collect_items_iter`.
+        let methods: Vec<_> = source
+            .class_member_list()
+            .into_iter()
+            .flat_map(|cml| cml.methods())
+            .collect();
+        let (items, macro_calls, diagnostics) = collector.collect_items_iter(methods);
+
+        (ClassItems { items, macro_calls }, DefDiagnostics::new(diagnostics))
+    }
+}
+
+impl ClassItems {
+    pub fn method_by_name(&self, name: &Name) -> Option<FunctionId> {
+        self.items.iter().find_map(|(item_name, item)| match item {
+            AssocItemId::FunctionId(t) if item_name == name => Some(*t),
+            _ => None,
+        })
+    }
+
+    pub fn assoc_item_by_name(&self, name: &Name) -> Option<AssocItemId> {
+        self.items.iter().find_map(|&(ref item_name, item)| {
+            if item_name == name {
+                Some(item)
+            } else {
+                None
+            }
+        })
+    }
+
+    pub fn macro_calls(&self) -> impl Iterator<Item = (AstId<ast::Item>, MacroCallId)> + '_ {
+        self.macro_calls.iter().copied()
+    }
+}
